{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "joylab-publishing-os",
  "compatibility_date": "2026-09-09",
  "routes": [
    {
      "pattern": "aijoylab.kr",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
