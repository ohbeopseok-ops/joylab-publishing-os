{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aijoylab.kr/schemas/research-graph-v1.json",
  "title": "JoyLab Research Graph V1",
  "type": "object",
  "required": [
    "contract",
    "version",
    "pillar",
    "nodes",
    "edges",
    "articles"
  ],
  "properties": {
    "contract": {
      "const": "JoyLab.ResearchGraph"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "pillar": {
      "type": "object",
      "required": [
        "id",
        "title",
        "url",
        "domain",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^/"
        },
        "domain": {
          "enum": [
            "investing",
            "ai",
            "leadership"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "published",
            "archived"
          ]
        }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "articles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/article"
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lane"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "pillar",
            "macro",
            "sector",
            "demand",
            "value_chain",
            "bottleneck",
            "company",
            "kpi",
            "earnings",
            "valuation",
            "article",
            "language",
            "measurement",
            "standard",
            "governance",
            "discourse_power",
            "capability",
            "workflow",
            "control",
            "metric",
            "risk",
            "behavior",
            "culture",
            "leader",
            "team",
            "outcome"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "ticker": {
          "type": "string"
        },
        "market": {
          "type": "string"
        },
        "articleUrl": {
          "type": "string",
          "pattern": "^/"
        },
        "stage": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": [
        "from",
        "to",
        "type"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "affects",
            "drives",
            "requires",
            "supplies",
            "constrains",
            "measured_by",
            "drives_earnings",
            "valued_by",
            "covered_by",
            "previous",
            "next",
            "belongs_to",
            "defines",
            "quantifies",
            "enables",
            "standardizes",
            "governs",
            "shapes",
            "validates",
            "informs",
            "maps_to",
            "aligns_with"
          ]
        }
      },
      "additionalProperties": true
    },
    "article": {
      "type": "object",
      "required": [
        "id",
        "title",
        "url",
        "pillar",
        "topics",
        "stage",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^/"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "pillar": {
          "type": "string",
          "minLength": 1
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stage": {
          "enum": [
            "macro",
            "sector",
            "value_chain",
            "bottleneck",
            "company",
            "earnings",
            "valuation",
            "language",
            "measurement",
            "standard",
            "governance",
            "discourse_power",
            "capability",
            "workflow",
            "control",
            "metric",
            "risk",
            "behavior",
            "culture",
            "leadership",
            "outcome",
            "leader",
            "team"
          ]
        },
        "previous": {
          "type": [
            "string",
            "null"
          ]
        },
        "next": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "published",
            "archived"
          ]
        }
      },
      "additionalProperties": true
    },
    "lane": {
      "type": "object",
      "required": [
        "key",
        "label",
        "types"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
