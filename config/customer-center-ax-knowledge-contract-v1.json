{
  "contract": "JoyLab.CustomerCenterAXKnowledgeContract",
  "version": "1.0.0",
  "agent": {
    "id": "home-consult-senior",
    "name": "홈상담 옆자리 선배",
    "purpose": "고객센터 상담사와 리더의 판단을 보조하되, 회사 SOP와 공식 전산을 최우선으로 적용한다.",
    "systemPrompt": "docs/copilot/home-consult-senior-system-prompt-v1.md"
  },
  "authorityOrder": [
    {
      "rank": 1,
      "id": "sop",
      "label": "SOP / 공식 전산",
      "status": "required_but_unconfigured",
      "authority": "binding",
      "sources": [],
      "rule": "실제 정책·금액·보상·예외·법률·고객 권리에 관한 최종 판단은 이 계층 없이는 확정하지 않는다."
    },
    {
      "rank": 2,
      "id": "playbook",
      "label": "승인된 Playbook",
      "status": "configured",
      "authority": "operational",
      "sources": [
        "docs/playbooks/customer-center-ax-playbook-v1.md"
      ],
      "rule": "SOP와 충돌하지 않는 범위에서 실행 절차와 표준 표현을 제공한다."
    },
    {
      "rank": 3,
      "id": "research",
      "label": "검증된 Research",
      "status": "configured",
      "authority": "evidence",
      "sources": [
        "src/data/articles/customer-center-ax-operating-model.md",
        "src/data/articles/customer-center-ai-security-guardrails.md",
        "src/data/articles/customer-center-crm-productivity.md",
        "src/data/articles/customer-center-qa-coaching-loop.md",
        "src/data/articles/customer-center-ax-leadership.md"
      ],
      "rule": "근거·원칙·운영 프레임을 제공하지만 SOP나 승인된 Playbook을 덮어쓰지 않는다."
    },
    {
      "rank": 4,
      "id": "book",
      "label": "Book Framework",
      "status": "configured",
      "authority": "context",
      "sources": [
        "src/data/books/ax-customer-center.md"
      ],
      "rule": "전체 맥락과 교육 목적의 프레임을 제공하며 상위 계층보다 우선하지 않는다."
    }
  ],
  "conflictPolicy": {
    "mode": "highest_authority_wins",
    "onConflict": "상위 rank 계층의 내용을 사용하고, 충돌한 하위 계층 내용은 폐기한다.",
    "noSilentMerge": true,
    "citeWinningLayer": true
  },
  "retrievalPolicy": {
    "sequence": [
      "sop",
      "playbook",
      "research",
      "book"
    ],
    "stopWhenSufficient": true,
    "lowerLayerCanFillMissingContext": true,
    "lowerLayerCanOverride": false
  },
  "blockingRules": [
    {
      "id": "sop-required-for-binding-answer",
      "whenAnyIntent": [
        "금액 확정",
        "보상 확정",
        "예외 승인",
        "약관 해석",
        "법률 판단",
        "고객 권리 확정",
        "회사 정책 확정"
      ],
      "ifLayerUnavailable": "sop",
      "action": "block_binding_answer",
      "responseMarker": "[SOP 확인 필요]"
    },
    {
      "id": "pii-stop",
      "when": "식별 가능한 개인정보가 입력 또는 출력에 남아 있음",
      "action": "stop_and_minimize",
      "responseMarker": "[개인정보 확인 필요]"
    },
    {
      "id": "hallucination-stop",
      "when": "근거 계층에 없는 사실을 생성해야 답할 수 있음",
      "action": "mark_unknown",
      "responseMarker": "[확인 필요]"
    }
  ],
  "answerContract": {
    "requiredSections": [
      "근거 계층",
      "핵심 판단",
      "안내 초안",
      "확인 필요"
    ],
    "operationalAnswerRequiresSourceLayer": true,
    "neverPresentModelGuessAsPolicy": true
  },
  "updatePolicy": {
    "owner": "JoyLab / Customer Center AX",
    "sopActivationRequires": [
      "실제 SOP 또는 공식 전산 기준 파일 연결",
      "source path 등록",
      "status를 configured로 변경",
      "Knowledge Contract Gate PASS"
    ],
    "lowerLayerUpdateCannotChangePriority": true
  }
}
