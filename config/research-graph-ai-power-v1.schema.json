{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aijoylab.kr/schemas/research-graph-ai-power-v1.schema.json",
  "title": "JoyLab AI Power Research Graph V1",
  "type": "object",
  "required": ["contract", "version", "pillar", "nodes", "edges", "articles"],
  "properties": {
    "contract": { "const": "JoyLab.ResearchGraph" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "pillar": {
      "type": "object",
      "required": ["id", "title", "url", "domain", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^/" },
        "domain": { "const": "investing" },
        "status": { "enum": ["draft", "published", "archived"] }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "articles": {
      "type": "array",
      "items": { "$ref": "#/$defs/article" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["pillar", "macro", "sector", "demand", "value_chain", "bottleneck", "company", "kpi", "earnings", "valuation", "article"]
        },
        "label": { "type": "string", "minLength": 1 },
        "ticker": { "type": "string" },
        "market": { "type": "string" },
        "articleUrl": { "type": "string", "pattern": "^/" },
        "stage": { "type": "string" },
        "description": { "type": "string" },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "type"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["affects", "drives", "requires", "supplies", "constrains", "measured_by", "drives_earnings", "valued_by", "covered_by", "previous", "next", "belongs_to"]
        },
        "label": { "type": "string" },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "article": {
      "type": "object",
      "required": ["id", "title", "url", "pillar", "topics", "stage", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^/" },
        "order": { "type": "integer", "minimum": 1 },
        "pillar": { "type": "string", "minLength": 1 },
        "topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "stage": {
          "enum": ["macro", "sector", "value_chain", "bottleneck", "company", "earnings", "valuation"]
        },
        "previous": { "type": ["string", "null"] },
        "next": { "type": ["string", "null"] },
        "status": { "enum": ["draft", "published", "archived"] },
        "publishedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
