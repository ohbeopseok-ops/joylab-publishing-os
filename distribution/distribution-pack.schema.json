{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aijoylab.kr/schema/distribution-pack-v1.json",
  "title": "JoyLab Distribution Execution Pack V1/V1.1",
  "type": "object",
  "required": ["version", "articleSlug", "campaign", "state", "channels", "approval"],
  "properties": {
    "version": { "enum": ["1.0", "1.1"] },
    "articleSlug": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "campaign": { "type": "string", "pattern": "^research_[A-Za-z0-9_-]+$" },
    "state": { "enum": ["DRAFT", "REVIEW", "APPROVED", "PUBLISHED", "MEASURED"] },
    "sourceUrl": { "type": "string", "format": "uri" },
    "generatedAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "identity": { "$ref": "#/$defs/identity" },
    "approval": {
      "type": "object",
      "required": ["approved", "approvedBy", "approvedAt"],
      "properties": {
        "approved": { "type": "boolean" },
        "approvedBy": { "type": ["string", "null"] },
        "approvedAt": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "channels": {
      "type": "object",
      "required": ["threads", "x", "linkedin", "naver"],
      "properties": {
        "threads": { "$ref": "#/$defs/channel" },
        "x": { "$ref": "#/$defs/channel" },
        "linkedin": { "$ref": "#/$defs/channel" },
        "naver": { "$ref": "#/$defs/channel" }
      },
      "additionalProperties": false
    },
    "publishLog": { "type": "array" }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": ["@id", "name", "url"],
      "properties": {
        "@id": { "type": "string", "format": "uri" },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "sameAs": { "type": "array", "items": { "type": "string", "format": "uri" } }
      },
      "additionalProperties": false
    },
    "channelIdentity": {
      "type": "object",
      "required": ["accountUrl", "authorEntity", "publisherEntity", "destinationEntity", "cta"],
      "properties": {
        "accountUrl": { "type": "string", "format": "uri" },
        "authorEntity": { "type": "string", "format": "uri" },
        "publisherEntity": { "type": "string", "format": "uri" },
        "destinationEntity": { "type": "string", "format": "uri" },
        "cta": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": ["version", "person", "organization", "website", "channels"],
      "properties": {
        "version": { "const": "1.1" },
        "person": { "$ref": "#/$defs/entity" },
        "organization": { "$ref": "#/$defs/entity" },
        "website": { "$ref": "#/$defs/entity" },
        "channels": {
          "type": "object",
          "required": ["threads", "x", "linkedin", "naver"],
          "properties": {
            "threads": { "$ref": "#/$defs/channelIdentity" },
            "x": { "$ref": "#/$defs/channelIdentity" },
            "linkedin": { "$ref": "#/$defs/channelIdentity" },
            "naver": { "$ref": "#/$defs/channelIdentity" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "required": ["id", "title", "body", "cta", "hashtags", "utmUrl"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "body": { "type": "string", "minLength": 1 },
        "cta": { "type": "string" },
        "hashtags": { "type": "array", "items": { "type": "string" } },
        "utmUrl": { "type": "string", "format": "uri" },
        "publishedUrl": { "type": ["string", "null"] },
        "publishedAt": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "channel": {
      "type": "object",
      "required": ["status", "variants"],
      "properties": {
        "status": { "enum": ["DRAFT", "REVIEW", "APPROVED", "PUBLISHED", "MEASURED"] },
        "identity": { "$ref": "#/$defs/channelIdentity" },
        "variants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/variant" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
