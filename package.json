{
  "name": "joylab-publishing-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/materialize-weight-of-silence-reader.mjs && node scripts/build-book-assets.mjs && node scripts/apply-curated-research-images.mjs && astro dev",
    "check:heroes": "node scripts/check-hero-quality.mjs",
    "treasury:sync": "node scripts/sync-treasury-structure.mjs",
    "treasury:self-test": "node scripts/sync-treasury-structure.mjs --self-test",
    "rates:sync": "node scripts/sync-rates-timeseries.mjs",
    "rates:self-test": "node scripts/sync-rates-timeseries.mjs --self-test",
    "risk-history:update": "node scripts/update-treasury-risk-history.mjs",
    "risk-history:self-test": "node scripts/update-treasury-risk-history.mjs --self-test",
    "market-transmission:sync": "node scripts/sync-market-transmission.mjs",
    "market-transmission:self-test": "node scripts/sync-market-transmission.mjs --self-test",
    "learn-mode:self-test": "node scripts/check-treasury-learn-mode.mjs",
    "prebuild": "node scripts/materialize-weight-of-silence-reader.mjs && node scripts/build-book-assets.mjs && node scripts/sync-treasury-structure.mjs && node scripts/sync-rates-timeseries.mjs && node scripts/update-treasury-risk-history.mjs && node scripts/sync-market-transmission.mjs && node scripts/check-treasury-learn-mode.mjs && node scripts/apply-curated-research-images.mjs",
    "build": "astro build",
    "postbuild": "node scripts/build-distribution-mobile-pages.mjs",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "benchmark:evaluate": "node scripts/evaluate-browser-agent-benchmark.mjs",
    "benchmark:summary": "node scripts/evaluate-browser-agent-benchmark.mjs --write-summary",
    "benchmark:gate": "node scripts/evaluate-browser-agent-benchmark.mjs --gate",
    "distribution:build": "node scripts/build-distribution-pack.mjs",
    "distribution:review": "node scripts/distribution-review-server.mjs",
    "distribution:review:mobile": "node scripts/build-distribution-mobile-pages.mjs",
    "distribution:state": "node scripts/distribution-state.mjs",
    "distribution:handoff": "node scripts/distribution-adapters.mjs",
    "distribution:published": "node scripts/distribution-publish-log.mjs",
    "distribution:scorecard": "node scripts/distribution-scorecard.mjs",
    "gsc:import": "node scripts/gsc-manual-import.mjs --input data/gsc/inbox",
    "gsc:priority": "node scripts/research-corpus-evidence-audit.mjs",
    "adsense:audit": "node scripts/audit-adsense-policy-v1.mjs",
    "adsense:monetization-gate": "node scripts/evaluate-adsense-monetization-v1.mjs"
  },
  "dependencies": {
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "sharp": "0.35.4",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
