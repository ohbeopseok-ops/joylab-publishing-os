---
import SiteFooter from '../components/SiteFooter.astro';
import ArticleContactCta from '../components/ArticleContactCta.astro';
import TreasuryRiskDelta from '../components/TreasuryRiskDelta.astro';
import TreasuryLearnAssist from '../components/TreasuryLearnAssist.astro';
import TreasuryTodayReading from '../components/TreasuryTodayReading.astro';
import IdentitySchema from '../components/IdentitySchema.astro';
import AnalyticsEvents from '../components/AnalyticsEvents.astro';
import '../styles/global.css';
import '../styles/info.css';
import '../styles/homepage-v2-fidelity.css';
import '../styles/mobile-density-pass-01.css';
const {
  title = 'JoyLab',
  description = '생각 → 분석 → 실행 → 성장. 투자·경제, AI·생산성, 성장·리더십을 연결하는 독립 콘텐츠 플랫폼.',
  canonical,
  type = 'website',
  bodyClass = '',
  image,
  imageWidth = 1600,
  imageHeight = 900,
  robots = 'index,follow'
} = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const socialImageUrl = image ? new URL(image, Astro.site ?? Astro.url.origin).toString() : undefined;
const bodyClasses = String(bodyClass).split(/\s+/);
const showArticleContactCta = bodyClasses.includes('research-article-page');
const showTreasuryRiskDelta = bodyClasses.includes('rates-hub-v2');
const showTreasuryLearnAssist = bodyClasses.includes('rates-hub-v2');
const showTreasuryTodayReading = bodyClasses.includes('rates-hub-v2');
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="JoyLab RSS" href="/rss.xml" />
    <meta property="og:site_name" content="JoyLab" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {socialImageUrl && <meta property="og:image:width" content={String(imageWidth)} />}
    {socialImageUrl && <meta property="og:image:height" content={String(imageHeight)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    <IdentitySchema />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <header class="site-header">
      <div class="container nav" id="site-nav-shell">
        <a class="brand" href="/">Joy<span>Lab</span></a>
        <nav class="nav-links" id="site-primary-nav" aria-label="주요 메뉴">
          <a href="/guides/investing">투자·경제</a>
          <a href="/guides/ai-productivity">AI·생산성</a>
          <a href="/guides/growth-leadership">성장·리더십</a>
          <a href="/#today-research">Research</a>
          <a href="/books">Books</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
        </nav>
        <a class="homepage-nav-cta" href="/#today-research">오늘의 리서치 →</a>
        <button class="homepage-nav-toggle" type="button" aria-expanded="false" aria-controls="site-primary-nav" aria-label="메뉴 열기">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>
    <main>
      <slot />
      {showTreasuryRiskDelta && <TreasuryRiskDelta />}
      {showArticleContactCta && <ArticleContactCta />}
    </main>
    {showTreasuryLearnAssist && <TreasuryLearnAssist />}
    {showTreasuryTodayReading && <TreasuryTodayReading />}
    <SiteFooter />
    <AnalyticsEvents />
    <script is:inline>
      (() => {
        const shell = document.getElementById('site-nav-shell');
        const toggle = shell?.querySelector('.homepage-nav-toggle');
        const links = shell?.querySelectorAll('.nav-links a');
        if (!shell || !toggle) return;
        const close = () => {
          shell.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', '메뉴 열기');
        };
        toggle.addEventListener('click', () => {
          const open = !shell.classList.contains('is-open');
          shell.classList.toggle('is-open', open);
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? '메뉴 닫기' : '메뉴 열기');
        });
        links?.forEach((link) => link.addEventListener('click', close));
        window.addEventListener('resize', () => { if (window.innerWidth > 640) close(); });
      })();
    </script>
    <script is:inline>
      (() => {
        if (!document.body.classList.contains('research-article-page')) return;

        const content = document.getElementById('article-content');
        if (content) {
          const duplicateLabels = new Set(['Research Brief', 'Key Takeaways']);
          const headings = Array.from(content.children).filter(
            (node) => node.tagName === 'H2' && duplicateLabels.has(node.textContent?.trim() ?? '')
          );
          headings.forEach((heading) => {
            let node = heading.nextElementSibling;
            heading.remove();
            while (node && node.tagName !== 'H2') {
              const next = node.nextElementSibling;
              node.remove();
              node = next;
            }
          });
        }

        const header = document.querySelector('.site-header');
        const shell = document.getElementById('site-nav-shell');
        const mobileQuery = window.matchMedia('(max-width: 640px)');
        if (!(header instanceof HTMLElement) || !shell) return;

        header.style.transition = 'transform .22s ease';
        header.style.willChange = 'transform';
        let lastY = window.scrollY;
        let ticking = false;

        const showHeader = () => { header.style.transform = 'translateY(0)'; };
        const updateHeader = () => {
          const y = window.scrollY;
          if (!mobileQuery.matches || y < 80 || shell.classList.contains('is-open')) {
            showHeader();
            lastY = y;
            ticking = false;
            return;
          }

          const delta = y - lastY;
          if (delta > 8 && y > 120) header.style.transform = 'translateY(-100%)';
          else if (delta < -8) showHeader();
          lastY = y;
          ticking = false;
        };

        window.addEventListener('scroll', () => {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(updateHeader);
        }, { passive: true });

        mobileQuery.addEventListener?.('change', () => {
          showHeader();
          lastY = window.scrollY;
        });
      })();
    </script>
  </body>
</html>
