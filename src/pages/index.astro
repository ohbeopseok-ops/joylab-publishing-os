---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/interactive.css';
import '../styles/homepage-v2.css';
import '../styles/homepage-v2-fidelity.css';
import '../styles/homepage-visuals.css';
import '../styles/homepage-pc-fidelity-pass-02.css';
import '../styles/brand-system-v1-1.css';
import '../styles/homepage-treasury-hub-card.css';
import '../styles/homepage-compact-v2.css';
import '../styles/homepage-visual-engineering-v1.css';
import '../styles/homepage-editorial-v2.css';
import researchImageManifest from '../data/research-image-manifest.json';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .filter((item) => !item.data.draft)
  .sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const editorialCategories = ['투자·경제', 'AI·생산성', '성장·리더십'];
const editorialPicks = editorialCategories
  .map((category) => articles.find((item) => item.data.category === category))
  .filter((item): item is (typeof articles)[number] => Boolean(item));
const editorialIds = new Set(editorialPicks.map((item) => item.id));
const today = [...editorialPicks, ...articles.filter((item) => !editorialIds.has(item.id))].slice(0, 3);

const homeSlotContractActive = articles.some((item) => item.data.homeFeatured || item.data.excludeFromLatest || item.data.homePriority != null);
const configuredMajor = articles
  .filter((item) => item.data.homeFeatured)
  .sort((a,b) => (a.data.homePriority ?? 999) - (b.data.homePriority ?? 999) || b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const majorSeedIds = new Set(configuredMajor.map((item) => item.id));
const majorResearch = homeSlotContractActive
  ? [...configuredMajor, ...articles.filter((item) => !majorSeedIds.has(item.id))].slice(0, 4)
  : articles.slice(0, 4);
const majorIds = new Set(majorResearch.map((item) => item.id));

const editorialHero = majorResearch.find((item) => Boolean(
  researchImageManifest[item.id as keyof typeof researchImageManifest]?.hero?.src ?? item.data.heroImage
)) ?? editorialPicks[0] ?? articles[0];
const editorialSecondary = [
  ...editorialPicks.filter((item) => item.id !== editorialHero?.id && item.data.category !== editorialHero?.data.category),
  ...articles.filter((item) => item.id !== editorialHero?.id && item.data.category !== editorialHero?.data.category)
].filter((item, index, all) => all.findIndex((candidate) => candidate.id === item.id) === index).slice(0, 2);

// LATEST is an article-only surface. Books are intentionally isolated in the dedicated Books slot.
const latestResearch = homeSlotContractActive
  ? articles
      .filter((item) => !item.data.excludeFromLatest && !editorialIds.has(item.id) && !majorIds.has(item.id))
      .slice(0, 5)
  : articles.slice(0, 5);
const tags = Array.from(new Set(articles.flatMap((item) => item.data.tags))).sort((a,b) => a.localeCompare(b, 'ko'));
const categories = ['전체', '투자·경제', 'AI·생산성', '성장·리더십'];
---
<BaseLayout
  title="JoyLab｜투자·경제, AI·생산성, 성장·리더십 리서치"
  description="JoyLab은 투자·경제, AI·생산성, 성장·리더십을 연결해 복잡한 정보를 실행 가능한 판단으로 바꾸는 독립 리서치 미디어입니다."
  canonical="https://aijoylab.kr/"
  bodyClass="homepage-v2 editorial-v2"
>
  <div class="home-v2">
    <section class="home-hero editorial-hero" aria-labelledby="home-title">
      <div class="home-hero__lead">
        <div class="home-eyebrow">INDEPENDENT RESEARCH / JOYLAB</div>
        <h1 id="home-title">생각을 분석하고,<br /><span>분석을 실행으로.</span></h1>
        <nav class="home-hero__pillars editorial-hero__topics" aria-label="3대 리서치 분야">
          <a href="/guides/investing"><small>01</small> 투자·경제 <span aria-hidden="true">↗</span></a>
          <a href="/guides/ai-productivity"><small>02</small> AI·생산성 <span aria-hidden="true">↗</span></a>
          <a href="/guides/growth-leadership"><small>03</small> 성장·리더십 <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
      <aside class="home-hero__today editorial-hero__aside" aria-label="JoyLab Research 소개">
        <p class="home-hero__desc">투자·경제, AI·생산성, 성장·리더십을 연결해 복잡한 정보를 실행 가능한 판단으로 바꾸는 독립 리서치 미디어입니다.</p>
        <a class="home-hero__cta" href="#today-research">대표 리서치 읽기 <span aria-hidden="true">↗</span></a>
        <a class="editorial-hero__secondary-cta" href="#archive">전체 분석 찾아보기 <span aria-hidden="true">↗</span></a>
        <div class="home-hero__method" aria-label="JoyLab Research Method">
          <span>FACT</span><i aria-hidden="true">→</i><span>INTERPRETATION</span><i aria-hidden="true">→</i><span>SCENARIO</span><i aria-hidden="true">→</i><span>ACTION</span>
        </div>
      </aside>
    </section>

    <section class="home-section home-section--major" id="today-research" aria-labelledby="feature-section-title">
      <div class="home-section-head">
        <div class="home-section-title"><div>
          <div class="editorial-section-eyebrow">EDITOR'S FOCUS / FEATURED RESEARCH</div>
          <h2 id="feature-section-title">주요 리서치</h2>
          <p>한 편의 깊은 분석부터, 더 넓은 판단으로.</p>
        </div></div>
        <a class="home-section-link" href="#archive">전체 리서치 보기 ↗</a>
      </div>
      <div class="home-research-grid editorial-feature-grid" aria-label="대표 리서치 1편과 보조 리서치 2편">
        {editorialHero && (() => {
          const visual = researchImageManifest[editorialHero.id as keyof typeof researchImageManifest];
          const cardHero = visual?.hero?.src ?? editorialHero.data.heroImage;
          const cardAlt = visual?.hero?.alt ?? editorialHero.data.heroAlt ?? editorialHero.data.title;
          return (
            <a class="home-research-card editorial-main-feature" href={`/articles/${editorialHero.id}`}>
              <div class="editorial-main-feature__copy">
                <span class="editorial-feature-kicker">FEATURED STORY · {editorialHero.data.category}</span>
                <h3>{editorialHero.data.cardTitle ?? editorialHero.data.title}</h3>
                <p>{editorialHero.data.cardDescription ?? editorialHero.data.description}</p>
                <span class="editorial-feature-meta">{editorialHero.data.publishedAt.toLocaleDateString('ko-KR')} · {editorialHero.data.readingTime ?? '약 6분'}</span>
                <span class="editorial-feature-read">분석 읽기 <span aria-hidden="true">↗</span></span>
              </div>
              <div class="editorial-main-feature__visual">
                {cardHero ? <img src={cardHero} alt={cardAlt} width="1600" height="900" loading="eager" fetchpriority="high" /> : <span aria-hidden="true">JOYLAB RESEARCH</span>}
              </div>
            </a>
          );
        })()}
        <div class="editorial-side-features" aria-label="보조 리서치 2편">
          {editorialSecondary.map((article, index) => {
            const visual = researchImageManifest[article.id as keyof typeof researchImageManifest];
            const thumb = visual?.hero?.src ?? article.data.heroImage;
            return (
              <a class="editorial-side-feature" href={`/articles/${article.id}`}>
                <div class="editorial-side-feature__copy">
                  <span class="editorial-side-feature__eyebrow">0{index + 1} / {article.data.category}</span>
                  <h3>{article.data.cardTitle ?? article.data.title}</h3>
                  <small>{article.data.publishedAt.toLocaleDateString('ko-KR')} · {article.data.readingTime ?? '약 6분'}</small>
                  <span class="editorial-side-feature__link">리서치 읽기 ↗</span>
                </div>
                {thumb && <img src={thumb} alt="" width="480" height="300" loading="lazy" />}
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <section class="home-section home-section--pillars" id="pillars">
      <div class="home-section-head">
        <div class="home-section-title"><div><h2>분야별 리서치 탐색</h2><p>복잡한 정보를 실행 가능한 판단으로 연결합니다.</p></div></div>
        <a class="home-section-link" href="/research-map">리서치 맵 →</a>
      </div>
      <div class="home-pillars" aria-label="JoyLab Research Pillar Index">
        <a class="home-pillar" href="/guides/investing">
          <img class="home-pillar__visual" src="/images/home/pillar-investment.svg" alt="시장 데이터와 자본 흐름을 표현한 투자·경제 Pillar 비주얼" width="1200" height="700" loading="lazy" />
          <span class="home-pillar__copy"><small>INVESTMENT & ECONOMY</small><strong>투자·경제</strong><p>시장·기업·정책을 읽고 투자 판단으로 연결합니다.</p></span>
        </a>
        <a class="home-pillar" href="/guides/ai-productivity">
          <img class="home-pillar__visual" src="/images/home/pillar-ai-productivity.svg" alt="AI Agent와 Workflow, ROI 흐름을 표현한 AI·생산성 Pillar 비주얼" width="1200" height="700" loading="lazy" />
          <span class="home-pillar__copy"><small>AI & PRODUCTIVITY</small><strong>AI·생산성</strong><p>AI가 바꾸는 산업과 일하는 방식을 분석합니다.</p></span>
        </a>
        <a class="home-pillar" href="/guides/growth-leadership">
          <img class="home-pillar__visual" src="/images/home/pillar-growth-leadership.svg" alt="성과와 피드백, 인정의 선순환을 표현한 성장·리더십 Pillar 비주얼" width="1200" height="700" loading="lazy" />
          <span class="home-pillar__copy"><small>GROWTH & LEADERSHIP</small><strong>성장·리더십</strong><p>성과·공정성·피드백·성장을 하나의 프레임으로 봅니다.</p></span>
        </a>
      </div>
      <div class="home-treasury-feature">
        <a class="home-treasury-card home-treasury-card--ai" href="/guides/ai-economics" aria-label="AI Economics 리서치 허브 바로가기">
          <div>
            <div class="home-treasury-card__eyebrow">FEATURED RESEARCH HUB · AI ECONOMICS</div>
            <h3>AI Economics Research Hub</h3>
            <p>AI 성장의 핵심을 모델 성능이 아니라 자본효율로 봅니다. 현금소진에서 인프라·HBM·보안 비용까지 하나의 경제 구조로 연결합니다.</p>
            <div class="home-treasury-card__flow"><span>ECONOMICS</span><span>INFRA</span><span>SEMICONDUCTOR</span><span>SECURITY</span></div>
          </div>
          <div class="home-treasury-card__side">
            <small>5-PART RESEARCH CLUSTER</small>
            <strong>CAPEX → Compute → Revenue → Margin → Risk</strong>
            <span class="home-treasury-card__cta">AI Economics 허브 바로가기 →</span>
          </div>
        </a>
        <a class="home-treasury-card" href="/guides/us-rates" aria-label="미국채 리서치 허브 바로가기">
          <div>
            <div class="home-treasury-card__eyebrow">FEATURED RESEARCH HUB · INVESTMENT & ECONOMY</div>
            <h3>미국채 리서치 허브</h3>
            <p>금리 숫자 하나가 아니라 미국이 실제 얼마에 돈을 빌리는지, 그 비용이 AI·반도체 밸류에이션과 한국 증시까지 어떻게 전달되는지를 연결해 봅니다.</p>
            <div class="home-treasury-card__flow"><span>AUCTION</span><span>10Y·30Y</span><span>VALUATION</span><span>USD/KRW</span><span>AI·SEMI</span></div>
          </div>
          <div class="home-treasury-card__side">
            <small>3-PART CORE JOURNEY</small>
            <strong>입찰 → 장기금리 → AI·반도체</strong>
            <span class="home-treasury-card__cta">미국채 허브 바로가기 →</span>
          </div>
        </a>
      </div>
    </section>

    <section class="home-section home-section--guide" aria-labelledby="guide-title">
      <div class="home-guide">
        <div class="home-guide-head"><div><div class="home-eyebrow" style="color:var(--home-yellow)">START HERE</div><h2 id="guide-title">Research Guide</h2></div><span>관심 주제에 맞는 시작점을 고르세요</span></div>
        <div class="home-guide-map">
          <a class="home-guide-step is-start" href="/guides/investing"><em>01</em><b>투자 리서치</b><span>반도체·AI 전력·조선 클러스터</span></a>
          <a class="home-guide-step" href="/guides/ai-productivity"><em>02</em><b>AI·생산성</b><span>Agent → Workflow → ROI → Compare</span></a>
          <a class="home-guide-step" href="/guides/semiconductor-investing"><em>03</em><b>반도체</b><span>HBM → Cycle → Company → Compare</span></a>
          <a class="home-guide-step" href="/guides/ai-power"><em>04</em><b>AI 전력</b><span>발전 → 송전 → 변압 → 배전 → 냉각</span></a>
          <a class="home-guide-step" href="/guides/shipbuilding"><em>05</em><b>조선</b><span>수주의 질 → 생산성 → 마진 → 비교</span></a>
          <a class="home-guide-step" href="/guides/growth-leadership"><em>06</em><b>성장·리더십</b><span>성과 → 피드백 → 인정 → 공정성</span></a>
          <a class="home-guide-step" href="/guides/ai-security"><em>07</em><b>AI 보안</b><span>API Key → Agent → MCP → Database</span></a>
          <a class="home-guide-step" href="/guides/ai-infrastructure"><em>08</em><b>AI 인프라</b><span>Compute → Memory → Data Center → Power → Cooling → Network</span></a>
        </div>
      </div>
    </section>

    <section class="home-section home-section--latest">
      <div class="home-latest-row">
        <div class="home-list-card">
          <div class="home-section-title"><div><h2>최신 업데이트</h2></div></div>
          <ol>{latestResearch.map((article, index) => <li><b>0{index + 1}</b><a href={`/articles/${article.id}`}>{article.data.title}</a></li>)}</ol>
        </div>
        <div class="home-category-card">
          <div class="home-section-title"><div><h2>전체 카테고리</h2></div></div>
          <a href="/guides/investing"><span>투자·경제</span><span>→</span></a>
          <a href="/guides/ai-productivity"><span>AI·생산성</span><span>→</span></a>
          <a href="/guides/growth-leadership"><span>성장·리더십</span><span>→</span></a>
          <a href="/guides/semiconductor-investing"><span>반도체 투자 가이드</span><span>→</span></a>
          <a href="/guides/ai-security"><span>AI 보안 리서치</span><span>→</span></a>
        </div>
        <div class="home-quote-card"><strong>좋은 정보보다,<br/>더 나은 판단을 남깁니다.</strong><p>Fact → Interpretation → Scenario → Action</p></div>
      </div>
    </section>

    <section class="home-archive" id="archive">
      <div id="investment" class="home-section-head">
        <div class="home-section-title"><div><h2>전체 리서치</h2><p>검색과 필터로 필요한 분석을 찾을 수 있습니다.</p></div></div>
      </div>
      <div class="content-finder" aria-label="콘텐츠 검색 및 필터">
        <div class="content-finder__top">
          <input id="content-search" class="content-search" type="search" placeholder="기업·기술·시장·업무·리더십 키워드 검색" autocomplete="off" aria-label="콘텐츠 검색" />
          <select id="tag-filter" class="content-select" aria-label="주제 태그 선택">
            <option value="">전체 주제</option>
            {tags.map((tag) => <option value={tag}>{tag}</option>)}
          </select>
        </div>
        <div class="filter-chips" role="group" aria-label="카테고리 필터">
          {categories.map((category, index) => <button type="button" class={`filter-chip ${index === 0 ? 'is-active' : ''}`} data-category={category === '전체' ? '' : category}>{category}</button>)}
        </div>
        <div class="content-finder__foot"><span><strong id="result-count">{articles.length}</strong>개의 콘텐츠</span><button id="clear-filter" class="clear-filter" type="button">필터 초기화</button></div>
      </div>
      <div id="article-grid" class="grid">
        {articles.map((article, index) => (
          <a class={`card article-card ${index === 0 ? 'card-accent' : ''}`} href={`/articles/${article.id}`} data-category={article.data.category} data-tags={article.data.tags.join('|')} data-search={`${article.data.title} ${article.data.description} ${article.data.category} ${article.data.tags.join(' ')} ${article.data.series ?? ''}`}>
            <div class="card-top"><div class="meta">{article.data.category}</div><span>{article.data.readingTime ?? '약 6분'}</span></div>
            <h3>{article.data.title}</h3><p>{article.data.description}</p>
            <div class="card-footer"><span>{article.data.series ?? 'JoyLab Research'}</span><b>→</b></div>
          </a>
        ))}
      </div>
      <div id="empty-results" class="empty-results">조건에 맞는 콘텐츠가 없습니다. 검색어 또는 필터를 바꿔보세요.</div>
      <div class="load-more-wrap"><button id="load-more" class="load-more" type="button">콘텐츠 더 보기</button></div>
      <span id="ai"></span><span id="growth"></span>
    </section>
  </div>

  <script is:inline>
    (() => {
      const cards = Array.from(document.querySelectorAll('.article-card'));
      const search = document.getElementById('content-search');
      const tag = document.getElementById('tag-filter');
      const categoryButtons = Array.from(document.querySelectorAll('[data-category]'));
      const count = document.getElementById('result-count');
      const clear = document.getElementById('clear-filter');
      const loadMore = document.getElementById('load-more');
      const empty = document.getElementById('empty-results');
      if (!search || !tag || !count || !clear || !loadMore || !empty) return;
      const PAGE_SIZE = 9;
      let activeCategory = '';
      let visibleLimit = PAGE_SIZE;
      const normalize = (value) => String(value || '').trim().toLocaleLowerCase('ko-KR');
      const applyFilters = (resetPage = true) => {
        if (resetPage) visibleLimit = PAGE_SIZE;
        const query = normalize(search.value);
        const selectedTag = tag.value;
        const matches = cards.filter((card) => {
          const matchesQuery = !query || normalize(card.dataset.search).includes(query);
          const matchesCategory = !activeCategory || card.dataset.category === activeCategory;
          const tagList = (card.dataset.tags || '').split('|');
          const matchesTag = !selectedTag || tagList.includes(selectedTag);
          return matchesQuery && matchesCategory && matchesTag;
        });
        cards.forEach((card) => {
          const matchIndex = matches.indexOf(card);
          const matchesCurrent = matchIndex !== -1;
          card.classList.toggle('is-filtered-out', !matchesCurrent);
          card.classList.toggle('is-page-hidden', matchesCurrent && matchIndex >= visibleLimit);
        });
        count.textContent = String(matches.length);
        empty.classList.toggle('is-visible', matches.length === 0);
        loadMore.hidden = matches.length <= visibleLimit;
      };
      search.addEventListener('input', () => applyFilters(true));
      tag.addEventListener('change', () => applyFilters(true));
      categoryButtons.forEach((button) => button.addEventListener('click', () => {
        activeCategory = button.dataset.category || '';
        categoryButtons.forEach((item) => item.classList.toggle('is-active', item === button));
        applyFilters(true);
      }));
      clear.addEventListener('click', () => {search.value='';tag.value='';activeCategory='';categoryButtons.forEach((button)=>button.classList.toggle('is-active',!button.dataset.category));applyFilters(true);search.focus();});
      loadMore.addEventListener('click', () => {visibleLimit += PAGE_SIZE;applyFilters(false);});
      applyFilters(true);
    })();
  </script>
</BaseLayout>