---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import release from '../../../../data/studio/series-02-release-v1.json';
---

<BaseLayout title="Series 02 v1.0.0 Release | JoyLab Studio" description="Series 02 published release downloads and provenance" robots="noindex,follow" bodyClass="studio-release-page">
  <main class="release-shell">
    <header>
      <div>
        <p class="eyebrow">JOYLAB STUDIO · PUBLISHED RELEASE</p>
        <h1>Series 02 <span>v{release.version}</span></h1>
        <p class="lede">업무를 시스템으로 바꾸는 법 · 15장 정식 릴리스</p>
      </div>
      <a href="/studio/projects/series-02/">← Project</a>
    </header>

    <section class="hero">
      <div>
        <span class="badge">{release.state.toUpperCase()}</span>
        <h2>{release.releaseId}</h2>
        <p>JoyLab Release Gate V1에서 GOLD를 통과한 동일 원고를 EPUB·Print PDF·Web이 공유합니다.</p>
      </div>
      <dl>
        <div><dt>Manuscript</dt><dd>{release.chapters.manuscriptReady}/{release.chapters.total}</dd></div>
        <div><dt>Interactive</dt><dd>{release.chapters.interactiveReady}/{release.chapters.total}</dd></div>
        <div><dt>Release Gate</dt><dd>{release.releaseGate.status}</dd></div>
      </dl>
    </section>

    <section class="downloads">
      <article>
        <small>EPUB 3</small>
        <h3>Interactive-ready EPUB</h3>
        <p>{Math.round(release.artifacts.epub.bytes/1024)} KB · canonical source 15/15</p>
        <a href={release.artifacts.epub.path} download="series-02-v1.0.0.epub">EPUB 다운로드</a>
      </article>
      <article>
        <small>PRINT PDF · A5</small>
        <h3>Print PDF</h3>
        <p>{release.artifacts.printPdf.pages} pages · {Math.round(release.artifacts.printPdf.bytes/1024)} KB</p>
        <a href={release.artifacts.printPdf.path} download="series-02-v1.0.0-print.pdf">PDF 다운로드</a>
      </article>
    </section>

    <section class="provenance">
      <div><p class="eyebrow">IMMUTABLE RELEASE</p><h2>Release provenance</h2></div>
      <dl>
        <div><dt>Version</dt><dd>{release.version}</dd></div>
        <div><dt>Tag</dt><dd><code>{release.tag}</code></dd></div>
        <div><dt>Commit</dt><dd><code>{release.commitSha}</code></dd></div>
        <div><dt>Source SHA256</dt><dd><code>{release.sourceSha256}</code></dd></div>
        <div><dt>Release Run</dt><dd><code>{release.releaseGate.runId}</code></dd></div>
      </dl>
      <p class="links"><a href={release.artifacts.provenance.path}>Export Provenance Manifest V1 →</a></p>
    </section>
  </main>

  <style>
    .studio-release-page{background:#f6f4ef;color:#17171a}
    .release-shell{width:min(1120px,100%);margin:auto;padding:42px 20px 90px}
    header{display:flex;justify-content:space-between;gap:20px;align-items:flex-start}
    header>a,.downloads a,.links a{color:#17171a;font-weight:850;text-decoration:none}
    .eyebrow{margin:0;color:#b98527;font-size:12px;font-weight:900;letter-spacing:.13em}
    h1{margin:7px 0 6px;font-size:44px;letter-spacing:-.04em}
    h1 span{color:#b98527}
    .lede{margin:0;color:#777;font-size:17px}
    .hero,.provenance,.downloads article{border:1px solid #e5e0d7;background:#fff;border-radius:22px}
    .hero{display:grid;grid-template-columns:1.2fr .8fr;gap:24px;margin-top:28px;padding:28px}
    .badge{display:inline-block;padding:7px 11px;border-radius:999px;background:#e8f4eb;color:#2f7550;font-size:12px;font-weight:900}
    .hero h2{margin:12px 0 8px;font-size:30px}
    .hero p{color:#6e6963;line-height:1.7}
    dl{margin:0}
    .hero dl div,.provenance dl div{display:flex;justify-content:space-between;gap:18px;padding:11px 0;border-bottom:1px solid #eee8df}
    dt{color:#888} dd{margin:0;font-weight:850}
    .downloads{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}
    .downloads article{padding:24px}
    .downloads small{color:#b98527;font-weight:900}
    .downloads h3{font-size:24px;margin:8px 0}
    .downloads p{color:#777}
    .downloads a{display:flex;justify-content:center;align-items:center;min-height:48px;margin-top:18px;border-radius:999px;background:#17171a;color:#fff}
    .provenance{margin-top:16px;padding:26px}
    .provenance h2{margin:6px 0 16px}
    code{font-size:12px;word-break:break-all}
    .links{margin:18px 0 0}
    @media(max-width:760px){header{display:block}header>a{display:inline-block;margin-top:14px}.hero,.downloads{grid-template-columns:1fr}h1{font-size:36px}.hero dl{margin-top:4px}.provenance dl div{display:block}.provenance dd{margin-top:5px}}
  </style>
</BaseLayout>
