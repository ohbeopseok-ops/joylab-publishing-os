---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { interactiveBookContractSchema } from '../../../lib/studio/interactive-block-contract';
import { series02Demo } from '../../../data/studio/series-02-demo';

const demo = interactiveBookContractSchema.parse(series02Demo);
const assessment = demo.blocks.find((block) => block.type === 'self_assessment');
const risk = demo.blocks.find((block) => block.type === 'risk_score');
const persona = demo.blocks.find((block) => block.type === 'persona_canvas');

if (!assessment || assessment.type !== 'self_assessment') throw new Error('Series 02 assessment block missing');
if (!risk || risk.type !== 'risk_score') throw new Error('Series 02 risk block missing');
if (!persona || persona.type !== 'persona_canvas') throw new Error('Series 02 persona block missing');
---

<BaseLayout
  title="JoyLab Studio | Series 02 Interactive Demo"
  description="원고 하나에서 전자책·종이책·인터랙티브 북까지 연결하는 JoyLab Studio의 Series 02 인터랙티브 데모."
  robots="noindex,follow"
  bodyClass="joylab-studio-page"
>
  <div class="studio-shell" data-storage-key={demo.storageKey}>
    <section class="studio-hero" aria-labelledby="studio-title">
      <p class="studio-kicker">INTERACTIVE PUBLISHING STUDIO</p>
      <h1 id="studio-title">원고 하나에서<br /><strong>읽기·기록·실행</strong>까지</h1>
      <p class="studio-lead">{demo.title}</p>
      <div class="studio-flow" aria-label="인터랙티브 독서 흐름">
        <span>READ</span><span>THINK</span><span>RECORD</span><span>ACT</span>
      </div>
      <div class="studio-progress" aria-live="polite">
        <span id="studio-progress-label">0 / 3 완료</span>
        <div class="studio-progress-track"><div id="studio-progress-bar"></div></div>
      </div>
    </section>

    <section class="studio-privacy" aria-label="개인정보 안내">
      <strong>로컬 저장 원칙</strong>
      <p>{demo.privacy.piiWarning}</p>
      <p>입력 내용은 이 브라우저의 localStorage에만 저장되며 서버로 전송하지 않습니다.</p>
    </section>

    <section class="studio-chapter" data-block-id={assessment.id} id="chapter-01">
      <p class="studio-kicker">CHAPTER 01 · SELF ASSESSMENT</p>
      <h2>{assessment.title}</h2>
      <p class="studio-prompt">{assessment.prompt}</p>
      <form class="studio-form" data-form-type="assessment">
        {assessment.questions.map((question) => (
          <fieldset class="studio-field" data-question-id={question.id}>
            <legend>{question.label}{question.required ? ' *' : ''}</legend>
            {question.kind === 'singleChoice' ? (
              <div class="studio-choice-grid">
                {question.options?.map((option) => (
                  <label class="studio-choice">
                    <input type="radio" name={question.id} value={option.value} data-score={option.score ?? 0} />
                    <span>{option.label}</span>
                  </label>
                ))}
              </div>
            ) : (
              <input
                type="text"
                name={question.id}
                placeholder={question.placeholder}
                maxlength="300"
                required={question.required}
              />
            )}
          </fieldset>
        ))}
        <button class="studio-primary" type="submit">진단 결과 보기</button>
        <div class="studio-result" data-result hidden></div>
      </form>
      <div class="studio-bands" hidden>
        {assessment.resultBands.map((band) => (
          <span data-band data-min={band.min} data-max={band.max} data-label={band.label} data-message={band.message}></span>
        ))}
      </div>
    </section>

    <section class="studio-chapter" data-block-id={risk.id} id="chapter-02">
      <p class="studio-kicker">CHAPTER 02 · RISK SCORE</p>
      <h2>{risk.title}</h2>
      <p class="studio-prompt">{risk.prompt}</p>
      <p class="studio-help">{risk.description}</p>
      <form class="studio-form" data-form-type="risk">
        {risk.items.map((item) => (
          <label class="studio-score-row">
            <span>{item.label}</span>
            <select name={item.id} data-weight={item.weight} aria-label={item.label + ' 점수'}>
              <option value="0">0</option>
              <option value="1">1</option>
              <option value="2">2</option>
            </select>
          </label>
        ))}
        <button class="studio-primary" type="submit">위험 점수 계산</button>
        <div class="studio-result" data-result hidden></div>
      </form>
      <div class="studio-thresholds" hidden>
        {risk.thresholds.map((band) => (
          <span data-threshold data-min={band.min} data-max={band.max} data-label={band.label} data-message={band.message}></span>
        ))}
      </div>
    </section>

    <section class="studio-chapter" data-block-id={persona.id} id="chapter-03">
      <p class="studio-kicker">CHAPTER 03 · PERSONA 0 MOMENT</p>
      <h2>{persona.title}</h2>
      <p class="studio-prompt">{persona.prompt}</p>
      <form class="studio-form" data-form-type="persona">
        {persona.fields.map((field) => (
          <label class="studio-field studio-field--stacked">
            <span>{field.label}{field.required ? ' *' : ''}</span>
            <textarea
              name={field.id}
              placeholder={field.placeholder}
              maxlength={field.maxLength}
              required={field.required}
              rows="3"
            ></textarea>
          </label>
        ))}
        <button class="studio-primary" type="submit">Canvas 저장</button>
        <div class="studio-result" data-result hidden></div>
      </form>
    </section>

    <section class="studio-reset">
      <p>이 데모의 기록만 삭제할 수 있습니다.</p>
      <button id="studio-reset" class="studio-secondary" type="button">Series 02 기록 초기화</button>
    </section>
  </div>

  <script is:inline>
    (() => {
      const shell = document.querySelector('.studio-shell');
      if (!(shell instanceof HTMLElement)) return;
      const storageKey = shell.dataset.storageKey;
      if (!storageKey) return;

      const readState = () => {
        try { return JSON.parse(localStorage.getItem(storageKey) || '{"blocks":{}}'); }
        catch { return { blocks: {} }; }
      };
      const writeState = (nextState) => localStorage.setItem(storageKey, JSON.stringify(nextState));
      const state = readState();
      if (!state.blocks) state.blocks = {};

      const updateProgress = () => {
        const total = 3;
        const done = Object.values(state.blocks).filter((value) => value && value.completed).length;
        const label = document.getElementById('studio-progress-label');
        const bar = document.getElementById('studio-progress-bar');
        if (label) label.textContent = done + ' / ' + total + ' 완료';
        if (bar instanceof HTMLElement) bar.style.width = ((done / total) * 100) + '%';
      };

      const restoreForm = (section) => {
        const blockId = section.dataset.blockId;
        const saved = state.blocks[blockId];
        if (!saved?.values) return;
        const form = section.querySelector('form');
        if (!(form instanceof HTMLFormElement)) return;
        Object.entries(saved.values).forEach(([name, value]) => {
          const controls = form.elements.namedItem(name);
          if (controls instanceof RadioNodeList) {
            Array.from(controls).forEach((control) => {
              if (control instanceof HTMLInputElement && control.type === 'radio') {
                control.checked = control.value === String(value);
              }
            });
          } else if (controls instanceof HTMLInputElement || controls instanceof HTMLTextAreaElement || controls instanceof HTMLSelectElement) {
            controls.value = String(value ?? '');
          }
        });
      };

      document.querySelectorAll('.studio-chapter').forEach((section) => {
        if (!(section instanceof HTMLElement)) return;
        restoreForm(section);
        const form = section.querySelector('form');
        const result = section.querySelector('[data-result]');
        if (!(form instanceof HTMLFormElement) || !(result instanceof HTMLElement)) return;

        form.addEventListener('submit', (event) => {
          event.preventDefault();
          if (!form.reportValidity()) return;

          const values = {};
          new FormData(form).forEach((value, key) => { values[key] = value; });
          const blockId = section.dataset.blockId;
          const formType = form.dataset.formType;
          let summary = '';

          if (formType === 'assessment') {
            const selected = form.querySelector('input[type="radio"]:checked');
            const score = selected instanceof HTMLInputElement ? Number(selected.dataset.score || 0) : 0;
            const band = Array.from(section.querySelectorAll('[data-band]')).find((node) => {
              if (!(node instanceof HTMLElement)) return false;
              return score >= Number(node.dataset.min) && score <= Number(node.dataset.max);
            });
            if (band instanceof HTMLElement) {
              summary = '<strong>' + band.dataset.label + '</strong><span>' + band.dataset.message + '</span>';
            }
          }

          if (formType === 'risk') {
            let score = 0;
            form.querySelectorAll('select').forEach((select) => {
              if (select instanceof HTMLSelectElement) score += Number(select.value) * Number(select.dataset.weight || 1);
            });
            const band = Array.from(section.querySelectorAll('[data-threshold]')).find((node) => {
              if (!(node instanceof HTMLElement)) return false;
              return score >= Number(node.dataset.min) && score <= Number(node.dataset.max);
            });
            if (band instanceof HTMLElement) {
              summary = '<strong>' + score + ' / 10 · ' + band.dataset.label + '</strong><span>' + band.dataset.message + '</span>';
            }
          }

          if (formType === 'persona') {
            summary = '<strong>Persona 0 Moment 저장 완료</strong><span>이 기록은 현재 브라우저에만 저장됩니다.</span>';
          }

          state.blocks[blockId] = { values, completed: true, savedAt: new Date().toISOString() };
          writeState(state);
          result.innerHTML = summary;
          result.hidden = false;
          updateProgress();
        });
      });

      document.getElementById('studio-reset')?.addEventListener('click', () => {
        localStorage.removeItem(storageKey);
        window.location.reload();
      });

      updateProgress();
    })();
  </script>

  <style>
    .joylab-studio-page { background: #fbfaf6; color: #17171a; }
    .studio-shell { width: min(100%, 820px); margin: 0 auto; padding: 40px 20px 64px; }
    .studio-hero { text-align: center; padding: 32px 0 44px; }
    .studio-kicker { margin: 0 0 14px; color: #c7932d; font-size: 14px; font-weight: 800; letter-spacing: .11em; }
    .studio-hero h1 { margin: 0; font-size: clamp(34px, 8vw, 58px); line-height: 1.08; letter-spacing: -.04em; }
    .studio-hero h1 strong { color: #d19b31; }
    .studio-lead { margin: 22px auto 0; max-width: 620px; color: #6f6b66; font-size: 17px; line-height: 1.7; word-break: keep-all; }
    .studio-flow { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin: 28px auto 0; max-width: 520px; }
    .studio-flow span { border: 1px solid #e7dcc4; border-radius: 999px; padding: 9px 4px; color: #765f32; background: #fffdf8; font-size: 12px; font-weight: 800; }
    .studio-progress { margin: 22px auto 0; max-width: 520px; text-align: left; font-size: 13px; font-weight: 700; color: #77716a; }
    .studio-progress-track { height: 8px; overflow: hidden; margin-top: 8px; background: #ebe7df; border-radius: 999px; }
    #studio-progress-bar { width: 0; height: 100%; background: #d19b31; border-radius: inherit; transition: width .25s ease; }
    .studio-privacy { margin-bottom: 44px; padding: 18px; border: 1px solid #e9dfcb; border-radius: 16px; background: #fffdf8; }
    .studio-privacy strong { display: block; margin-bottom: 7px; }
    .studio-privacy p { margin: 4px 0; color: #706b65; font-size: 14px; line-height: 1.65; word-break: keep-all; }
    .studio-chapter { margin: 0 0 44px; padding: 26px 22px; border: 1px solid #ece7de; border-radius: 18px; background: #fff; box-shadow: 0 12px 40px rgba(0,0,0,.04); }
    .studio-chapter h2 { margin: 0; font-size: clamp(28px, 7vw, 38px); line-height: 1.15; letter-spacing: -.035em; }
    .studio-prompt { margin: 14px 0 0; font-size: 18px; font-weight: 700; line-height: 1.55; word-break: keep-all; }
    .studio-help { margin: 8px 0 0; color: #77716a; font-size: 15px; line-height: 1.65; }
    .studio-form { margin-top: 24px; }
    .studio-field { border: 0; padding: 0; margin: 0 0 22px; }
    .studio-field legend, .studio-field--stacked > span { display: block; margin-bottom: 10px; font-size: 15px; font-weight: 800; line-height: 1.45; }
    .studio-field--stacked { display: block; }
    .studio-choice-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 10px; }
    .studio-choice { position: relative; }
    .studio-choice input { position: absolute; opacity: 0; pointer-events: none; }
    .studio-choice span { display: flex; min-height: 48px; align-items: center; justify-content: center; padding: 10px; border: 1px solid #ddd6ca; border-radius: 14px; background: #fbfaf6; font-weight: 700; }
    .studio-choice input:checked + span { border-color: #d19b31; background: #f8edda; color: #7a5513; }
    .studio-field input[type="text"], .studio-field textarea, .studio-score-row select { width: 100%; box-sizing: border-box; border: 1px solid #ddd8cf; border-radius: 12px; background: #fff; color: #17171a; font: inherit; font-size: 16px; }
    .studio-field input[type="text"], .studio-field textarea { padding: 13px 14px; }
    .studio-field textarea { resize: vertical; line-height: 1.6; }
    .studio-score-row { display: grid; grid-template-columns: 1fr 76px; gap: 14px; align-items: center; min-height: 58px; border-bottom: 1px solid #eee9e1; }
    .studio-score-row span { font-size: 15px; font-weight: 700; line-height: 1.45; }
    .studio-score-row select { height: 44px; padding: 0 10px; }
    .studio-primary, .studio-secondary { min-height: 48px; border-radius: 999px; padding: 0 20px; font: inherit; font-size: 16px; font-weight: 800; cursor: pointer; }
    .studio-primary { width: 100%; border: 0; background: #17171a; color: #fff; }
    .studio-secondary { border: 1px solid #d8d2c8; background: #fff; color: #333; }
    .studio-result { display: grid; gap: 6px; margin-top: 16px; padding: 16px; border-radius: 14px; background: #f8edda; color: #5f471b; }
    .studio-result strong { font-size: 19px; }
    .studio-result span { line-height: 1.55; }
    .studio-reset { text-align: center; padding-top: 6px; }
    .studio-reset p { color: #77716a; font-size: 14px; }
    @media (max-width: 640px) {
      .studio-shell { padding-top: 24px; }
      .studio-hero { padding-top: 24px; }
      .studio-choice-grid { grid-template-columns: 1fr; }
      .studio-chapter { padding: 22px 18px; }
    }
    @media (max-width: 360px) {
      .studio-flow { grid-template-columns: repeat(2, 1fr); }
      .studio-score-row { grid-template-columns: 1fr 66px; }
    }
  </style>
</BaseLayout>
