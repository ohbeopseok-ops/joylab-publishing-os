---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { interactiveBookContractSchema } from '../../../../lib/studio/interactive-block-contract';
import { series02Demo } from '../../../../data/studio/series-02-demo';
import series02Source from '../../../../data/studio/series-02-source.json';
const demo = interactiveBookContractSchema.parse(series02Demo);
const outputs = [
  { label: 'Interactive Web', status: 'READY' },
  { label: 'Web Preview', status: 'READY' },
  { label: 'EPUB', status: 'DRAFT' },
  { label: 'Print PDF', status: 'READY' }
];
---

<BaseLayout title="Series 02 | JoyLab Studio" description="Series 02 JoyLab Studio 프로젝트 대시보드" robots="noindex,follow" bodyClass="studio-app-page">
  <div class="app-shell">
    <header class="app-head">
      <div><p>JOYLAB STUDIO · PROJECT</p><h1>Series 02</h1><span>기억 부채에서 실행 시스템까지</span></div>
      <a href="/studio/">Studio Home</a>
    </header>
    <nav class="app-tabs" aria-label="프로젝트 메뉴">
      <a class="active" href="/studio/projects/series-02/">Dashboard</a>
      <a href="/studio/projects/series-02/manuscript/">Manuscript</a>
      <a href="/studio/projects/series-02/interactive/">Interactive</a>
      <a href="/studio/projects/series-02/validation/">Validation</a>
      <a href="/studio/projects/series-02/preview/">Preview</a>
      <a href="/studio/projects/series-02/export/">Export</a>
      <a href="/studio/demo/">Reader Demo</a>
    </nav>

    <section class="metrics">
      <article><small>CHAPTERS</small><strong>{series02Source.chapters.length}</strong><span>{series02Source.chapters.filter((chapter) => chapter.manuscriptStatus === 'ready').length} READY · {series02Source.chapters.filter((chapter) => chapter.manuscriptStatus === 'outline').length} OUTLINE</span></article>
      <article><small>INTERACTIVE</small><strong>{demo.blocks.length}</strong><span>Ch.1~3 READY</span></article>
      <article><small>VALIDATION</small><strong>CHECK</strong><span>P0 CI 재검증 예정</span></article>
    </section>

    <section class="panel">
      <div class="panel-title"><div><p>OUTPUT STATUS</p><h2>하나의 원고, 네 가지 출력</h2></div><a href="/studio/demo/">실제 데모 열기 →</a></div>
      <div class="output-grid">
        {outputs.map((output) => <article><span>{output.label}</span><b class:list={{ready:output.status==='READY'}}>{output.status}</b></article>)}
      </div>
    </section>

    <section class="panel">
      <div class="panel-title"><div><p>NEXT ACTIONS</p><h2>지금 닫아야 할 3가지</h2></div></div>
      <ol class="actions">
        <li><b>01</b><span>Chapter 1~3 원고를 Manuscript Editor에서 기준 원본으로 확정</span><a href="/studio/projects/series-02/manuscript/">열기</a></li>
        <li><b>02</b><span>Interactive Builder에서 Block 계약과 질문 문구 검토</span><a href="/studio/projects/series-02/interactive/">열기</a></li>
        <li><b>03</b><span>Validation → Preview → Export 순서로 P0/P1 전체 흐름 확인</span><a href="/studio/projects/series-02/validation/">검증</a></li>
      </ol>
    </section>
  </div>
  <style>
    .studio-app-page{background:#f6f4ef;color:#17171a}.app-shell{width:min(1180px,100%);margin:auto;padding:38px 20px 90px}.app-head{display:flex;justify-content:space-between;gap:20px;align-items:flex-start}.app-head p,.panel-title p{margin:0;color:#c8922d;font-size:12px;font-weight:850;letter-spacing:.12em}.app-head h1{margin:5px 0 4px;font-size:42px;letter-spacing:-.04em}.app-head span{color:#777}.app-head>a,.panel-title a,.actions a{color:#17171a;font-weight:800;text-decoration:none}.app-tabs{display:flex;gap:8px;overflow:auto;margin:28px 0;padding-bottom:5px}.app-tabs a{white-space:nowrap;padding:10px 14px;border-radius:999px;background:#fff;color:#666;text-decoration:none;font-weight:750}.app-tabs a.active{background:#17171a;color:#fff}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.metrics article,.panel{border:1px solid #e7e2d9;background:#fff;border-radius:20px}.metrics article{padding:22px}.metrics small,.metrics strong,.metrics span{display:block}.metrics small{color:#888;font-weight:800}.metrics strong{margin:10px 0 4px;font-size:30px}.metrics span{color:#777}.panel{margin-top:18px;padding:24px}.panel-title{display:flex;justify-content:space-between;gap:16px;align-items:end}.panel-title h2{margin:6px 0 0;font-size:27px}.output-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:18px}.output-grid article{padding:18px;border-radius:14px;background:#f7f5f0}.output-grid span,.output-grid b{display:block}.output-grid b{margin-top:9px;color:#9b7330}.output-grid b.ready{color:#3e7c58}.actions{list-style:none;padding:0;margin:12px 0 0}.actions li{display:grid;grid-template-columns:42px 1fr auto;gap:12px;align-items:center;padding:16px 0;border-top:1px solid #eee8df}.actions b{color:#c8922d}.actions span{line-height:1.5}@media(max-width:700px){.app-head{display:block}.app-head>a{display:inline-block;margin-top:14px}.metrics{grid-template-columns:1fr}.output-grid{grid-template-columns:1fr 1fr}.panel-title{display:block}.panel-title a{display:inline-block;margin-top:12px}.actions li{grid-template-columns:34px 1fr}.actions a{grid-column:2}}@media(max-width:390px){.output-grid{grid-template-columns:1fr}}
  </style>
</BaseLayout>