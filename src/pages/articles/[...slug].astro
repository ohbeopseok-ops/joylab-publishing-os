---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleGrowthPath from '../../components/ArticleGrowthPath.astro';
import AdSlot from '../../components/AdSlot.astro';
import ArticleSeoSchema from '../../components/ArticleSeoSchema.astro';
import ChinaSemiconductorSeriesNav from '../../components/ChinaSemiconductorSeriesNav.astro';
import ChinaSemiconductorRiskScore from '../../components/ChinaSemiconductorRiskScore.astro';
import '../../styles/interactive.css';
import '../../styles/research-v2.css';
import '../../styles/visual-placement.css';
import researchImageManifest from '../../data/research-image-manifest.json';
import researchVisualPlacement from '../../data/research-visual-placement.json';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).filter((item) => !item.data.draft);

  return articles.map((article) => {
    const tags = new Set(article.data.tags);
    const related = articles
      .filter((item) => item.id !== article.id)
      .map((item) => ({
        item,
        score:
          item.data.tags.filter((tag) => tags.has(tag)).length * 3 +
          (item.data.category === article.data.category ? 1 : 0) +
          (item.data.series && item.data.series === article.data.series ? 2 : 0)
      }))
      .filter(({ score }) => score > 0)
      .sort((a, b) => b.score - a.score || b.item.data.publishedAt.getTime() - a.item.data.publishedAt.getTime())
      .slice(0, 4)
      .map(({ item }) => item);

    const seriesItems = article.data.series
      ? articles
          .filter((item) => item.data.series === article.data.series)
          .sort((a, b) => (a.data.seriesOrder ?? 999) - (b.data.seriesOrder ?? 999) || a.data.publishedAt.getTime() - b.data.publishedAt.getTime() || a.id.localeCompare(b.id))
      : [];
    return { params: { slug: article.id }, props: { article, related, seriesItems } };
  });
}

const { article, related, seriesItems } = Astro.props;
const { Content } = await render(article);
const title = article.data.seoTitle ?? article.data.title;
const researchVisual = researchImageManifest[article.id as keyof typeof researchImageManifest];
const visualPlacement = researchVisualPlacement[article.id as keyof typeof researchVisualPlacement];
const heroImage = researchVisual?.hero?.src ?? article.data.heroImage;
const heroAlt = researchVisual?.hero?.alt ?? article.data.heroAlt ?? article.data.title;
const heroCaption = researchVisual?.hero?.caption ?? article.data.heroCaption;
const supportingImages = (researchVisual?.supporting ?? []).map((image, index) => ({
  ...image,
  afterHeading: visualPlacement?.supporting?.find((item) => item.index === index)?.afterHeading ?? null
}));
const articleImage = article.data.ogImage ?? heroImage;
const articleImageUrl = articleImage ? new URL(articleImage, Astro.site ?? Astro.url.origin).toString() : undefined;
const isCompareHub = article.id === 'samsung-vs-sk-hynix-ai-memory';
const isSamsung = article.id === 'samsung-electronics-outlook';
const codexSeries = [
  { id: 'codex-guide-6-steps-2026', ep: 'EP01', short: 'Codex 6단계 시작 가이드' },
  { id: 'codex-non-developer-automation-10', ep: 'EP02', short: '비개발자 자동화 10가지' },
  { id: 'codex-skill-guide-2026', ep: 'EP03', short: 'Codex Skill 만들기' },
  { id: 'codex-plugin-guide-2026', ep: 'EP04', short: 'Codex Plugin 활용법' },
  { id: 'codex-automation-gold-cases-5', ep: 'EP05', short: '자동화 GOLD CASE 5개' },
  { id: 'codex-computer-use-guide-2026', ep: 'EP06', short: 'Computer Use 실전' },
  { id: 'codex-goal-mode-guide-2026', ep: 'EP07', short: 'Goal Mode 실전' },
  { id: 'codex-build-your-own-plugin-2026', ep: 'EP08', short: '나만의 Plugin 만들기' }
];
const codexSeriesIndex = codexSeries.findIndex((item) => item.id === article.id);
const isCodexSeries = codexSeriesIndex >= 0;
const codexPrev = isCodexSeries && codexSeriesIndex > 0 ? codexSeries[codexSeriesIndex - 1] : null;
const codexNext = isCodexSeries && codexSeriesIndex < codexSeries.length - 1 ? codexSeries[codexSeriesIndex + 1] : null;
const isAiPowerSeries = article.data.series?.startsWith('AI 전력');
const isMoneyBasics = article.data.series === '돈 공부 기초';
const isUsRatesSeries = article.data.series === '미국 금리 리서치';
const isUsMacroSeries = article.data.series === '미국 경제지표 읽는 법';
const isGrowthResearch = article.data.category === '성장·리더십' || article.data.series === '침묵의 기술';
const isChinaSemiconductorSeries = article.data.series === '미·중 반도체 전쟁';
const isChinaSemiconductorRiskArticle = article.id === 'china-semiconductor-risk-indicators';
const aiEconomicsClusterIds = new Set(['ai-bubble-vs-compute-supercycle-2026','openai-anthropic-ipo-cash-burn-2026','ai-infrastructure-hbm-mlcc-power-grid-2026','samsung-hbm4-memory-outlook-2026-09-20','ai-api-key-compute-theft-2026']);
const isAiEconomicsCluster = aiEconomicsClusterIds.has(article.id);
const aiSecurityClusterIds = new Set(['ai-api-key-compute-theft-2026','ai-agent-security-prompt-to-rce-2026','mcp-security-tool-poisoning-2026','ai-database-security-data-layer-2026']);
const aiInfrastructureClusterIds = new Set(['gpu-compute-economics-rubin-2026','what-is-hbm','ai-infrastructure-hbm-mlcc-power-grid-2026','ai-data-center-capacity-stack-2026','ai-power-next-bottleneck','ai-data-center-cooling-bottleneck']);
const isAiSecurityCluster = aiSecurityClusterIds.has(article.id);
const isAiInfrastructureCluster = aiInfrastructureClusterIds.has(article.id);
const guideCta = isGrowthResearch
  ? {
      title: 'Growth & Leadership Research Hub',
      href: '/guides/growth-leadership',
      label: '성장·회복·관계·리더십 리서치 전체 보기 →'
    }
  : isAiSecurityCluster
  ? {
      title: 'AI Security Research Hub',
      href: '/guides/ai-security',
      label: 'API Key → Agent → MCP → Database Security 전체 흐름 보기 →'
    }
  : isAiInfrastructureCluster
  ? {
      title: 'AI Infrastructure Research Hub',
      href: '/guides/ai-infrastructure',
      label: 'GPU → HBM → MLCC → Data Center → Power → Cooling 전체 흐름 보기 →'
    }
  : isAiEconomicsCluster
  ? {
      title: 'AI Economics Research Hub',
      href: '/guides/ai-economics',
      label: 'AI Economics → Infrastructure → Semiconductor → Security 전체 흐름 보기 →'
    }
  : isUsMacroSeries
  ? {
      title: '미국 경제지표 읽는 법',
      href: '/articles/us-economic-indicators-guide',
      label: '소매판매·CPI·PPI·고용·PCE를 Fed와 나스닥까지 연결해서 보기 →'
    }
  : isUsRatesSeries
  ? {
      title: '미국 금리 리서치',
      href: '/guides/us-rates',
      label: '10년물·30년물·TIC·입찰·한국 전염경로 한 번에 보기 →'
    }
  : isAiPowerSeries
    ? {
        title: 'AI 전력 가이드',
        href: '/guides/ai-power',
        label: '발전부터 기업 비교까지 한 번에 보기 →'
      }
    : isMoneyBasics
      ? {
          title: '투자 리서치 가이드',
          href: '/guides/investing',
          label: '경제 기초에서 투자 리서치까지 이어서 보기 →'
        }
      : {
          title: '반도체 투자 가이드',
          href: '/guides/semiconductor-investing',
          label: 'HBM부터 비교까지 한 번에 보기 →'
        };
const takeaways = isGrowthResearch
  ? [
      ['핵심 질문', `${article.data.tags.slice(0, 2).join('·')}를 중심으로 삶과 조직의 문제를 다시 정의합니다.`],
      ['해석 기준', '개념과 사례를 분리해 보고, 무엇이 구조적 원인인지 살펴봅니다.'],
      ['실행 연결', '읽고 끝내지 않고 일상과 업무에서 바로 적용할 작은 행동으로 번역합니다.']
    ]
  : isSamsung
  ? [
      ['실적 추정치', '현재 실적보다 다음 분기와 연간 EPS 추정치의 방향을 먼저 봅니다.'],
      ['HBM 실행력', '기술 발표보다 인증·양산·수율·공급 물량이 이익으로 연결되는지 확인합니다.'],
      ['외국인 수급', '하루 순매수보다 5일·20일 지속성과 실제 가격 반응을 함께 봅니다.']
    ]
  : [
      ['핵심 변수', `${article.data.tags.slice(0, 2).join('·')}를 중심으로 구조적 변화를 봅니다.`],
      ['판단 순서', '사실과 해석을 분리하고 시나리오별로 조건을 확인합니다.'],
      ['실행 기준', '한 줄 뉴스보다 데이터의 방향과 가격 반응을 함께 확인합니다.']
    ];
const scoreCriteria = [
  { label: 'AI 메모리 집중도', note: 'AI·HBM 성장 노출을 얼마나 중요하게 보는지', samsung: 3, hynix: 5 },
  { label: '사업 다각화', note: '메모리 외 사업 포트폴리오 분산을 얼마나 선호하는지', samsung: 5, hynix: 2 },
  { label: 'HBM 실행 민감도', note: 'HBM 인증·양산 모멘텀에 직접 베팅하는 성향', samsung: 3, hynix: 5 },
  { label: '메모리 사이클 레버리지', note: '업황 개선 시 이익 민감도가 큰 구조를 선호하는지', samsung: 3, hynix: 5 },
  { label: '모멘텀 투자 성향', note: '높은 변동성을 감수하고 추세를 중시하는지', samsung: 3, hynix: 5 }
];
---
<BaseLayout title={`${title} | JoyLab`} description={article.data.description} canonical={article.data.canonical} type="article" bodyClass="research-article-page" image={articleImage}>
  <div class="reading-progress" aria-hidden="true"><span id="reading-progress-bar"></span></div>

  <article class="research-v2-shell article-shell" data-asset-contract-kind="article" data-asset-contract-hero={heroImage ?? ''} data-asset-contract-og={articleImage ?? ''}>
    <header class="research-cover" style={heroImage ? 'grid-template-columns:1fr' : undefined}>
      <div class="research-cover__copy">
        <div class="research-kicker">JOYLAB RESEARCH · {article.data.category}</div>
        <h1>{article.data.title}</h1>
        <p class="research-cover__desc">{article.data.description}</p>
        <div class="research-cover__meta">
          <span>{article.data.author}</span>
          <span>{article.data.publishedAt.toLocaleDateString('ko-KR')}</span>
          <span>{article.data.readingTime ?? '약 6분'}</span>
          {article.data.series && <span>{article.data.series}</span>}
        </div>
        <div class="research-cover__tags">{article.data.tags.map((tag) => <span>#{tag}</span>)}</div>
      </div>
      {!heroImage && (
        <div class="research-cover__art" aria-hidden="true">
          <div class="research-mark">JoyLab<br/>Research<small>FACT · INTERPRETATION<br/>SCENARIO · ACTION</small></div>
        </div>
      )}
    </header>

    {heroImage && (
      <figure style="margin:0;background:#fff;border:1px solid var(--research-line);border-top:0;overflow:hidden">
        <img src={heroImage} alt={heroAlt} width="1600" height="900" loading="eager" fetchpriority="high" style="display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover" />
        {heroCaption && (
          <figcaption style="padding:10px 16px;color:#6b7a90;font-size:.76rem;line-height:1.55;border-top:1px solid #edf1f6">{heroCaption}</figcaption>
        )}
      </figure>
    )}

    <div class="research-quote">
      <strong>좋은 정보보다, 더 나은 판단을 남깁니다.</strong>
      <span>Fact → Interpretation → Scenario → Action</span>
    </div>

    <div class="research-layout">
      <div class="research-main">
        <section class="research-panel research-brief" aria-labelledby="brief-title">
          <h2 class="research-panel__title" id="brief-title">Research Brief</h2>
          <ul>
            <li>{article.data.description}</li>
            <li>{isGrowthResearch ? 'JoyLab은 개념, 경험, 행동을 하나의 흐름으로 연결해 해석합니다.' : 'JoyLab은 단일 뉴스보다 여러 변수를 한 흐름으로 연결해 판단합니다.'}</li>
            <li>{isGrowthResearch ? '이 글은 정답을 제시하기보다 스스로 판단하고 적용할 기준을 남기는 리서치입니다.' : '이 글은 매수·매도 지시가 아니라 판단 기준과 재점검 조건을 제공하는 리서치입니다.'}</li>
          </ul>
        </section>

        <section class="research-panel" aria-labelledby="takeaways-title">
          <h2 class="research-panel__title" id="takeaways-title">Key Takeaways</h2>
          <div class="takeaway-grid">
            {takeaways.map(([label, note], index) => (
              <div class="takeaway"><b>0{index + 1}</b><strong>{label}</strong><p>{note}</p></div>
            ))}
          </div>
        </section>

        {supportingImages.length > 0 && (
          <section id="visual-research" class="research-panel" aria-labelledby="visual-research-title">
            <h2 class="research-panel__title" id="visual-research-title">Visual Research</h2>
            <div style="display:grid;gap:20px">
              {supportingImages.map((image) => (
                <figure data-visual-anchor={image.afterHeading ?? undefined} style="margin:0;border:1px solid var(--research-line);border-radius:16px;overflow:hidden;background:#fff">
                  <img src={image.src} alt={image.alt} width="1600" height="900" loading="lazy" style="display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover" />
                  {image.caption && <figcaption style="padding:10px 14px;color:#6b7a90;font-size:.78rem;line-height:1.55">{image.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </section>
        )}

        <section class="research-panel" aria-labelledby="framework-title">
          <h2 class="research-panel__title" id="framework-title">{isGrowthResearch ? 'JoyLab 성장·리더십 프레임워크' : 'JoyLab 투자 프레임워크'}</h2>
          <div class="framework-grid">
            {isGrowthResearch ? (
              <>
                <div class="framework-step"><em>OBSERVE</em><strong>무엇이 일어나고 있는가?</strong><p>감정과 평가보다 먼저 실제 상황과 반복 패턴을 관찰합니다.</p></div>
                <div class="framework-step"><em>INTERPRET</em><strong>왜 이런 일이 생기는가?</strong><p>개인 성향, 관계, 구조, 환경 요인을 나누어 해석합니다.</p></div>
                <div class="framework-step"><em>CHOOSE</em><strong>무엇을 선택할 것인가?</strong><p>통제 가능한 범위와 우선순위를 정해 한 가지 행동을 선택합니다.</p></div>
                <div class="framework-step"><em>REFLECT</em><strong>무엇을 다시 볼 것인가?</strong><p>결과뿐 아니라 판단 과정과 다음 수정점을 돌아봅니다.</p></div>
              </>
            ) : (
              <>
                <div class="framework-step"><em>FACT</em><strong>무엇이 사실인가?</strong><p>데이터와 공시, 확인 가능한 사건을 먼저 분리합니다.</p></div>
                <div class="framework-step"><em>INTERPRETATION</em><strong>무엇을 의미하는가?</strong><p>변수의 방향과 구조적 의미를 연결합니다.</p></div>
                <div class="framework-step"><em>SCENARIO</em><strong>어떤 가능성이 있는가?</strong><p>Bull·Base·Bear 조건을 나누어 봅니다.</p></div>
                <div class="framework-step"><em>ACTION</em><strong>무엇을 확인할 것인가?</strong><p>다음 판단 전 반드시 확인할 체크포인트를 남깁니다.</p></div>
              </>
            )}
          </div>
        </section>

        {isCompareHub && (
          <section id="compare-scorecard" class="compare-scorecard" aria-labelledby="compare-scorecard-title">
            <div class="compare-scorecard__head">
              <div>
                <h2 id="compare-scorecard-title">나에게 맞는 AI 메모리 투자 성향 Scorecard</h2>
                <p>중요도를 직접 조절하면 삼성전자와 SK하이닉스 중 어떤 투자 논리가 현재 선호와 더 가까운지 계산합니다.</p>
              </div>
              <div class="score-summary" aria-live="polite">
                <div class="score-total" data-total-box="samsung"><span>삼성전자 적합도</span><strong data-total="samsung">0<em>/100</em></strong></div>
                <div class="score-total" data-total-box="hynix"><span>SK하이닉스 적합도</span><strong data-total="hynix">0<em>/100</em></strong></div>
              </div>
            </div>
            <div class="score-presets" aria-label="투자 성향 프리셋">
              <button class="score-preset is-active" type="button" data-weights="3,3,3,3,3">균형</button>
              <button class="score-preset" type="button" data-weights="5,1,5,4,5">AI 성장 우선</button>
              <button class="score-preset" type="button" data-weights="2,5,2,2,1">안정성 우선</button>
              <button class="score-preset" type="button" data-weights="5,1,5,5,5">모멘텀 우선</button>
            </div>
            <div class="score-criteria">
              {scoreCriteria.map((criterion) => (
                <div class="score-row" data-score-row data-samsung={criterion.samsung} data-hynix={criterion.hynix}>
                  <div class="score-row__title"><strong>{criterion.label}</strong><small>{criterion.note}</small></div>
                  <label class="score-weight"><input type="range" min="1" max="5" value="3" step="1" data-weight aria-label={`${criterion.label} 중요도`} /><output data-weight-output>3</output></label>
                  <span class="score-fit">삼성전자<b>{criterion.samsung}/5</b></span>
                  <span class="score-fit">SK하이닉스<b>{criterion.hynix}/5</b></span>
                </div>
              ))}
            </div>
            <p class="score-note">이 점수는 수익률 전망이나 매수 추천이 아니라 JoyLab의 구조 비교 프레임에 사용자의 우선순위를 적용한 성향 도구입니다.</p>
          </section>
        )}

        <div class="reader-toolbar research-reader" aria-label="읽기 설정">
          <span class="reader-toolbar__label">읽기 설정</span>
          <button class="reader-control" type="button" data-reader-size="small" aria-pressed="false" title="글자 작게">A−</button>
          <button class="reader-control" type="button" data-reader-size="default" aria-pressed="true" title="기본 글자 크기">A</button>
          <button class="reader-control" type="button" data-reader-size="large" aria-pressed="false" title="글자 크게">A+</button>
          <button id="focus-reading" class="reader-control reader-focus" type="button" aria-pressed="false">집중 읽기</button>
        </div>

        <div class="research-v2-content">
          <div id="article-content" class="article-body"><Content /></div>
        </div>

        {isChinaSemiconductorRiskArticle && <ChinaSemiconductorRiskScore />}
        {isChinaSemiconductorSeries && <ChinaSemiconductorSeriesNav currentId={article.id} />}
        <AdSlot placement="article-end" />

        {isCodexSeries && (
          <nav class="codex-series-nav" aria-label="Codex 8부작 시리즈 이동">
            <div class="codex-series-nav__head">
              <div>
                <small>JOYLAB CODEX · 8-PART PILLAR</small>
                <strong>{codexSeries[codexSeriesIndex].ep} · {codexSeries[codexSeriesIndex].short}</strong>
              </div>
              <a class="codex-series-nav__toc" href="/guides/codex">전체 목차</a>
            </div>
            <div class="codex-series-nav__grid">
              {codexPrev ? (
                <a class="codex-series-nav__item is-prev" href={`/articles/${codexPrev.id}`}>
                  <span>← 이전 글</span>
                  <b>{codexPrev.ep} · {codexPrev.short}</b>
                </a>
              ) : (
                <span class="codex-series-nav__item is-disabled"><span>← 이전 글</span><b>시리즈의 첫 글입니다</b></span>
              )}
              {codexNext ? (
                <a class="codex-series-nav__item is-next" href={`/articles/${codexNext.id}`}>
                  <span>다음 글 →</span>
                  <b>{codexNext.ep} · {codexNext.short}</b>
                </a>
              ) : (
                <a class="codex-series-nav__item is-next" href="/guides/codex">
                  <span>완주 →</span>
                  <b>Codex Hub 전체 목차로 돌아가기</b>
                </a>
              )}
            </div>
          </nav>
        )}
      </div>

      <aside class="research-rail" aria-label="리서치 보조 정보">
        <div class="research-rail__card toc-card">
          <h3>Table of Contents</h3>
          <details class="article-toc" open><summary>이 글의 목차</summary><nav id="article-toc-list" aria-label="문서 목차"></nav></details>
        </div>
        <div class="research-guide-cta">
          <small>START HERE</small>
          <strong>{guideCta.title}</strong>
          <a href={guideCta.href}>{guideCta.label}</a>
        </div>
        {related.length > 0 && (
          <div class="research-rail__card related-card">
            <h3>Related Research</h3>
            <div class="research-related">
              {related.map((item) => <a href={`/articles/${item.id}`}><b>{item.data.title}</b><span>{item.data.category} · {item.data.readingTime ?? '약 6분'}</span></a>)}
            </div>
          </div>
        )}
      </aside>
    </div>
  </article>

  <ArticleGrowthPath
    related={related}
    guideCta={guideCta}
    articleId={article.id}
    category={article.data.category}
  />

  <button id="back-to-top" class="back-to-top" type="button" aria-label="맨 위로 이동" title="맨 위로 이동">↑</button>

  <script is:inline>
    (() => {
      const article = document.querySelector('.article-shell');
      const content = document.getElementById('article-content');
      const progressBar = document.getElementById('reading-progress-bar');
      const toc = document.getElementById('article-toc-list');
      const backToTop = document.getElementById('back-to-top');
      if (!article || !content || !progressBar || !toc || !backToTop) return;

      const sizeButtons = Array.from(document.querySelectorAll('[data-reader-size]'));
      const focusButton = document.getElementById('focus-reading');
      const allowedSizes = new Set(['small', 'default', 'large']);
      const storedSize = localStorage.getItem('joylab-reader-size');
      const initialSize = allowedSizes.has(storedSize) ? storedSize : 'default';
      const applyReaderSize = (size) => {
        document.documentElement.dataset.readerSize = size;
        sizeButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.readerSize === size)));
        localStorage.setItem('joylab-reader-size', size);
      };
      applyReaderSize(initialSize);
      sizeButtons.forEach((button) => button.addEventListener('click', () => applyReaderSize(button.dataset.readerSize || 'default')));
      focusButton?.addEventListener('click', () => {
        const enabled = document.body.classList.toggle('focus-reading');
        focusButton.setAttribute('aria-pressed', String(enabled));
        focusButton.textContent = enabled ? '집중 모드 해제' : '집중 읽기';
      });

      const headings = Array.from(content.querySelectorAll('h2'));
      const tocLinks = [];
      headings.forEach((heading, index) => {
        if (!heading.id) heading.id = `section-${index + 1}`;
        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent || `섹션 ${index + 1}`;
        toc.appendChild(link);
        tocLinks.push(link);
      });

      const normalizeHeading = (value) => String(value || '').replace(/\s+/g, '').toLocaleLowerCase('ko-KR');
      const anchoredFigures = Array.from(document.querySelectorAll('[data-visual-anchor]'));
      anchoredFigures.forEach((figure) => {
        const anchor = normalizeHeading(figure.dataset.visualAnchor);
        if (!anchor) return;
        const target = headings.find((heading) => normalizeHeading(heading.textContent).includes(anchor));
        if (!target) return;
        let insertionPoint = target;
        while (insertionPoint.nextElementSibling?.classList.contains('research-anchored-visual')) insertionPoint = insertionPoint.nextElementSibling;
        insertionPoint.insertAdjacentElement('afterend', figure);
        figure.classList.add('research-anchored-visual');
      });
      const visualSection = document.getElementById('visual-research');
      if (visualSection && visualSection.querySelectorAll('figure').length === 0) visualSection.remove();

      const updateProgress = () => {
        const articleTop = article.getBoundingClientRect().top + window.scrollY;
        const articleEnd = articleTop + article.offsetHeight - window.innerHeight;
        const range = Math.max(articleEnd - articleTop, 1);
        const progress = Math.min(1, Math.max(0, (window.scrollY - articleTop) / range));
        progressBar.style.transform = `scaleX(${progress})`;
        backToTop.classList.toggle('is-visible', window.scrollY > 700);
      };
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => { updateProgress(); ticking = false; });
      };

      if ('IntersectionObserver' in window && headings.length > 0) {
        const observer = new IntersectionObserver((entries) => {
          const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (!visible) return;
          tocLinks.forEach((link) => link.classList.toggle('is-active', link.getAttribute('href') === `#${visible.target.id}`));
        }, { rootMargin: '-18% 0px -68% 0px', threshold: 0 });
        headings.forEach((heading) => observer.observe(heading));
      }

      const scorecard = document.getElementById('compare-scorecard');
      if (scorecard) {
        const rows = Array.from(scorecard.querySelectorAll('[data-score-row]'));
        const totalSamsung = scorecard.querySelector('[data-total="samsung"]');
        const totalHynix = scorecard.querySelector('[data-total="hynix"]');
        const boxSamsung = scorecard.querySelector('[data-total-box="samsung"]');
        const boxHynix = scorecard.querySelector('[data-total-box="hynix"]');
        const presetButtons = Array.from(scorecard.querySelectorAll('[data-weights]'));
        const calculateScore = () => {
          let weightSum = 0, samsung = 0, hynix = 0;
          rows.forEach((row) => {
            const input = row.querySelector('[data-weight]');
            const output = row.querySelector('[data-weight-output]');
            if (!input) return;
            const weight = Number(input.value);
            weightSum += weight;
            samsung += weight * Number(row.dataset.samsung || 0);
            hynix += weight * Number(row.dataset.hynix || 0);
            if (output) output.textContent = String(weight);
          });
          const max = Math.max(weightSum * 5, 1);
          const samsungScore = Math.round((samsung / max) * 100);
          const hynixScore = Math.round((hynix / max) * 100);
          if (totalSamsung) totalSamsung.firstChild.textContent = String(samsungScore);
          if (totalHynix) totalHynix.firstChild.textContent = String(hynixScore);
          boxSamsung?.classList.toggle('is-leading', samsungScore > hynixScore);
          boxHynix?.classList.toggle('is-leading', hynixScore > samsungScore);
        };
        rows.forEach((row) => row.querySelector('[data-weight]')?.addEventListener('input', () => { presetButtons.forEach((button) => button.classList.remove('is-active')); calculateScore(); }));
        presetButtons.forEach((button) => button.addEventListener('click', () => {
          const weights = (button.dataset.weights || '').split(',').map(Number);
          rows.forEach((row, index) => { const input = row.querySelector('[data-weight]'); if (input && weights[index]) input.value = String(weights[index]); });
          presetButtons.forEach((item) => item.classList.toggle('is-active', item === button));
          calculateScore();
        }));
        calculateScore();
      }

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      backToTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: prefersReducedMotion ? 'auto' : 'smooth' }));
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', updateProgress);
      updateProgress();
    })();
  </script>

  <ArticleSeoSchema article={article} articleImageUrl={articleImageUrl} seriesItems={seriesItems} />
</BaseLayout>