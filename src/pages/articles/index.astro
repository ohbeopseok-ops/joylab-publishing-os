---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { AD_PLACEMENT } from '../../config/adPlacement';
import { getCollection } from 'astro:content';
import '../../styles/homepage-v2.css';
import '../../styles/homepage-v2-fidelity.css';

const articles = (await getCollection('articles'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const archiveMinCards = AD_PLACEMENT.slots.archiveInFeed.minCardsBefore;

const pillars = [
  {
    href: '/guides/investing',
    label: '투자·경제',
    description: '시장·기업·정책·금리를 투자 판단으로 연결합니다.'
  },
  {
    href: '/guides/ai-productivity',
    label: 'AI·생산성',
    description: 'AI Agent·Workflow·ROI와 산업 변화를 분석합니다.'
  },
  {
    href: '/guides/growth-leadership',
    label: '성장·리더십',
    description: '성과·피드백·공정성·회복을 실행 프레임으로 정리합니다.'
  }
];
---
<BaseLayout
  title="JoyLab Research｜투자·경제, AI·생산성, 성장·리더십 전체 리서치"
  description="JoyLab의 투자·경제, AI·생산성, 성장·리더십 리서치를 한곳에서 탐색하세요. 최신 분석과 핵심 Research Guide를 주제별로 연결합니다."
  canonical="https://aijoylab.kr/articles"
  bodyClass="homepage-v2 research-hub-page"
>
  <div class="home-v2">
    <section class="home-section" style="padding-top:72px">
      <div class="home-section-head">
        <div class="home-section-title">
          <div>
            <div class="home-eyebrow">JOYLAB RESEARCH</div>
            <h1 style="font-size:clamp(2.2rem,5vw,4.8rem);line-height:1.04;margin:14px 0 18px">복잡한 정보를,<br />판단 가능한 리서치로.</h1>
            <p>투자·경제, AI·생산성, 성장·리더십을 연결해 사실 → 해석 → 시나리오 → 실행의 흐름으로 정리합니다.</p>
            <a class="research-map-entry" href="/research-map">Investing · AI · Leadership Global Research Map →</a>
          </div>
        </div>
      </div>

      <div class="home-pillars" aria-label="JoyLab Research Guide">
        {pillars.map((pillar) => (
          <a class="home-pillar" href={pillar.href}>
            <span class="home-pillar__copy">
              <small>RESEARCH GUIDE</small>
              <strong>{pillar.label}</strong>
              <p>{pillar.description}</p>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="home-archive" id="all-research">
      <div class="home-section-head">
        <div class="home-section-title">
          <div>
            <h2>전체 리서치</h2>
            <p>최신순으로 {articles.length}개의 공개 리서치를 제공합니다.</p>
          </div>
        </div>
      </div>

      <div class="grid">
        {articles.slice(0, archiveMinCards).map((article, index) => (
          <a class={`card article-card ${index === 0 ? 'card-accent' : ''}`} href={`/articles/${article.id}`}>
            <div class="card-top">
              <div class="meta">{article.data.category}</div>
              <span>{article.data.readingTime ?? '약 6분'}</span>
            </div>
            <h3>{article.data.cardTitle ?? article.data.title}</h3>
            <p>{article.data.cardDescription ?? article.data.description}</p>
            <div class="card-footer">
              <span>{article.data.series ?? article.data.publishedAt.toLocaleDateString('ko-KR')}</span>
              <b>→</b>
            </div>
          </a>
        ))}

        <div class="archive-in-feed-ad-shell" data-archive-in-feed-after={archiveMinCards}>
          <AdSlot placement="archive-in-feed" />
        </div>

        {articles.slice(archiveMinCards).map((article) => (
          <a class="card article-card" href={`/articles/${article.id}`}>
            <div class="card-top">
              <div class="meta">{article.data.category}</div>
              <span>{article.data.readingTime ?? '약 6분'}</span>
            </div>
            <h3>{article.data.cardTitle ?? article.data.title}</h3>
            <p>{article.data.cardDescription ?? article.data.description}</p>
            <div class="card-footer">
              <span>{article.data.series ?? article.data.publishedAt.toLocaleDateString('ko-KR')}</span>
              <b>→</b>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': 'https://aijoylab.kr/articles#collection',
    url: 'https://aijoylab.kr/articles',
    name: 'JoyLab Research',
    description: 'JoyLab의 투자·경제, AI·생산성, 성장·리더십 전체 리서치 아카이브',
    inLanguage: 'ko-KR',
    isPartOf: { '@id': 'https://aijoylab.kr/#website' },
    hasPart: articles.slice(0, 30).map((article) => ({
      '@type': 'Article',
      '@id': `https://aijoylab.kr/articles/${article.id}#article`,
      url: `https://aijoylab.kr/articles/${article.id}`,
      headline: article.data.title
    }))
  })}></script>

<style is:global>
  .research-map-entry{display:inline-flex;margin-top:18px;padding:10px 14px;border:1px solid #cbd8e8;border-radius:999px;color:#0d63ce;font-size:.82rem;font-weight:900;text-decoration:none;background:#fff}
  .research-map-entry:hover{border-color:#1677ff}
  .archive-in-feed-ad-shell{grid-column:1/-1;width:100%;min-width:0}
  @media (max-width: 900px) {
    body.research-hub-page .home-archive .article-card {
      min-height: 0;
      padding: 16px;
    }
    body.research-hub-page .home-archive .article-card > p {
      display: none;
    }
    body.research-hub-page .home-archive .article-card h3 {
      margin-bottom: 10px;
    }
    body.research-hub-page .home-archive .article-card .card-footer {
      margin-top: 10px;
    }
  }
</style>
</BaseLayout>
