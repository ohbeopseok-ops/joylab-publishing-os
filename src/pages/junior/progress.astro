---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/junior.css';
---
<BaseLayout title="학습 기록 | JoyLab Junior" description="자녀별 시사논술 학습 기록을 이 기기에 저장하는 로컬 대시보드">
<div class="junior-shell">
<section class="junior-hero"><div class="junior-eyebrow">JOYLAB JUNIOR · LEARNING LOG</div><h1>자녀별 누적 학습 대시보드</h1><p>점수 경쟁보다 사고 과정의 변화를 기록합니다. 입력 내용은 브라우저의 로컬 저장소에만 저장됩니다.</p></section>
<div class="progress-grid"><div class="metric"><span>총 학습</span><strong id="totalCount">0</strong><small>완료 기록</small></div><div class="metric"><span>평균 사고점수</span><strong id="avgScore">-</strong><small>FACT~WRITE 평균</small></div><div class="metric"><span>가장 강한 영역</span><strong id="bestArea">-</strong><small>누적 기준</small></div></div>
<section class="junior-card" style="margin-top:16px"><h2>학습 기록 추가</h2><div class="record-row"><select id="child"><option>자녀 A</option><option>자녀 B</option></select><select id="lesson"><option value="#001 네팔 대홍수">#001 네팔 대홍수</option><option value="#002 AI와 일자리">#002 AI와 일자리</option></select><input class="score" id="fact" type="number" min="1" max="5" placeholder="FACT 1-5"/><input class="score" id="why" type="number" min="1" max="5" placeholder="WHY 1-5"/><input class="score" id="view" type="number" min="1" max="5" placeholder="VIEW 1-5"/><input class="score" id="think" type="number" min="1" max="5" placeholder="THINK 1-5"/><input class="score" id="write" type="number" min="1" max="5" placeholder="WRITE 1-5"/></div><div class="junior-actions"><button id="saveBtn" class="junior-btn primary">기록 저장</button><button id="exportBtn" class="junior-btn">CSV 내보내기</button><button id="clearBtn" class="junior-btn">전체 삭제</button></div></section>
<section class="junior-card" style="margin-top:16px"><h2>누적 기록</h2><div class="table-wrap"><table class="junior-table"><thead><tr><th>날짜</th><th>학생</th><th>학습지</th><th>F</th><th>W</th><th>V</th><th>T</th><th>Write</th><th></th></tr></thead><tbody id="rows"></tbody></table></div></section>
<script is:inline>
(()=>{const KEY='joylabJuniorProgressV1';const areas=['fact','why','view','think','write'];const load=()=>JSON.parse(localStorage.getItem(KEY)||'[]');const save=d=>localStorage.setItem(KEY,JSON.stringify(d));const el=id=>document.getElementById(id);function render(){const d=load();el('totalCount').textContent=d.length;if(d.length){const all=d.flatMap(r=>areas.map(a=>r[a]));el('avgScore').textContent=(all.reduce((a,b)=>a+b,0)/all.length).toFixed(1);const sums=Object.fromEntries(areas.map(a=>[a,d.reduce((s,r)=>s+r[a],0)]));const best=[...areas].sort((a,b)=>sums[b]-sums[a])[0].toUpperCase();el('bestArea').textContent=best}else{el('avgScore').textContent='-';el('bestArea').textContent='-'}el('rows').innerHTML=d.map((r,i)=>`<tr><td>${r.date}</td><td>${r.child}</td><td>${r.lesson}</td><td>${r.fact}</td><td>${r.why}</td><td>${r.view}</td><td>${r.think}</td><td>${r.write}</td><td><button data-i="${i}" class="junior-btn del">삭제</button></td></tr>`).join('');document.querySelectorAll('.del').forEach(b=>b.onclick=()=>{const x=load();x.splice(+b.dataset.i,1);save(x);render()})}el('saveBtn').onclick=()=>{const scores=Object.fromEntries(areas.map(a=>[a,+el(a).value]));if(Object.values(scores).some(v=>v<1||v>5)){alert('FACT~WRITE를 1~5점으로 모두 입력하세요.');return}const d=load();d.unshift({date:new Date().toLocaleDateString('ko-KR'),child:el('child').value,lesson:el('lesson').value,...scores});save(d);areas.forEach(a=>el(a).value='');render()};el('exportBtn').onclick=()=>{const d=load();const head=['date','child','lesson',...areas];const csv=[head.join(','),...d.map(r=>head.map(k=>`"${String(r[k]??'').replaceAll('"','""')}"`).join(','))].join('\n');const blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='joylab-junior-progress.csv';a.click();URL.revokeObjectURL(a.href)};el('clearBtn').onclick=()=>{if(confirm('이 기기의 모든 학습 기록을 삭제할까요?')){localStorage.removeItem(KEY);render()}};render()})()
</script>
</div></BaseLayout>
