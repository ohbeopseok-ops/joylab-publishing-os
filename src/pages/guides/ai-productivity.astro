---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/semiconductor-guide-v2.css';
import '../../styles/ai-productivity-guide-v2.css';
import { getCollection } from 'astro:content';

const sequence = [
  { id: 'what-is-ai-agent', step: '01', role: 'AGENT', short: 'Agent', note: '챗봇과 에이전트의 차이를 위임·도구·완료조건·통제 구조로 이해합니다.' },
  { id: 'ai-workflow-automation', step: '02', role: 'WORKFLOW', short: 'Workflow', note: 'Model → Tool → Workflow → Human Approval로 실제 업무자동화 구조를 설계합니다.' },
  { id: 'ai-productivity-roi', step: '03', role: 'MEASUREMENT', short: 'ROI', note: '사용량이 아니라 Task Completion·Quality·Cost·Rework로 AI 성과를 측정합니다.' },
  { id: 'ai-agent-governance', step: '04', role: 'GOVERNANCE', short: 'Governance', note: '권한·승인·로그·관측성·실패 복구를 실제 운영 통제로 묶습니다.' },
  { id: 'ai-agent-system-design-anthropic-2026', step: '05', role: 'SYSTEM DESIGN', short: 'System', note: 'Anthropic의 Orchestrator·Worker·Context·Containment 원칙을 실제 운영 가능한 Agent System 구조로 연결합니다.' },
  { id: 'ai-productivity-operating-model', step: '06', role: 'OPERATING MODEL', short: 'Operating', note: '개인 AI 활용을 팀 표준·역할·측정·개선 루프를 갖춘 조직 운영모델로 확장합니다.' },
  { id: 'ai-productivity-platforms-compare', step: '07', role: 'COMPARE HUB', short: 'Compare', note: 'ChatGPT·Claude·Gemini·Copilot을 기능 수가 아니라 업무 적합성·통제·측정 기준으로 비교합니다.' }
];

const collection = (await getCollection('articles')).filter((item) => !item.data.draft);
const byId = new Map(collection.map((item) => [item.id, item]));
const steps = sequence.map((entry) => ({ ...entry, article: byId.get(entry.id) }));
const published = steps.filter((entry) => entry.article);
const customerCenterAxTrack = [
  { id: 'customer-center-ax-operating-model', step: '01', role: 'AX MODEL', title: 'AX 운영모델', note: 'AI를 상담사 대체가 아니라 판단 보조 시스템으로 설계하고, 사람이 남아야 할 결정 지점을 분리합니다.' },
  { id: 'customer-center-ai-security-guardrails', step: '02', role: 'AI SECURITY', title: 'AI 보안', note: 'PII·SOP·환각·승인·기록을 하나의 가드레일로 묶어 실제 상담 업무의 통제 기준을 만듭니다.' },
  { id: 'customer-center-crm-productivity', step: '03', role: 'PRODUCTIVITY', title: '상담 생산성', note: 'CRM 3줄 요약과 현장형 미니 웹도구를 반복업무 축소와 재작업 감소로 연결합니다.' },
  { id: 'customer-center-qa-coaching-loop', step: '04', role: 'QA COACHING', title: 'QA 코칭', note: 'SBI + Alternative 구조로 평가를 행동 변화와 재실행 확인까지 연결합니다.' },
  { id: 'customer-center-ax-leadership', step: '05', role: 'LEADERSHIP', title: 'AX 리더십', note: '성과·보안·코칭·학습을 리더의 운영 리듬 안에 통합합니다.' }
].map((entry) => ({ ...entry, article: byId.get(entry.id) }));
const publishedCustomerCenterAx = customerCenterAxTrack.filter((entry) => entry.article);
---
<BaseLayout
  title="AI·생산성 가이드｜에이전트부터 운영모델·플랫폼 비교까지 | JoyLab"
  description="AI 에이전트·업무자동화·ROI·거버넌스·운영모델·플랫폼 비교를 하나의 Research Map으로 연결해 AI를 실제 업무 성과로 전환하는 JoyLab AI·생산성 가이드입니다."
  bodyClass="semiconductor-guide-v2 ai-productivity-guide-v2"
>
  <section class="sg-hero ai-prod-hero">
    <div class="sg-wrap sg-hero__inner">
      <div class="sg-hero__top">
        <div class="sg-hero__copy">
          <div class="sg-eyebrow">AI PRODUCTIVITY RESEARCH · JOYLAB</div>
          <h1>AI는 도구보다<br /><span>업무 구조입니다.</span></h1>
          <p class="sg-hero__lead">AI를 더 많이 쓰는 것이 목표가 아닙니다. <strong>Agent → Workflow → ROI → Governance → System Design → Operating Model → Compare</strong>로 연결해, 어떤 일을 어디까지 위임하고 어떻게 통제·측정할지 하나의 판단 구조로 읽습니다.</p>
          <div class="sg-hero__chips" aria-label="AI 생산성 핵심 주제">
            <span>#AI에이전트</span><span>#업무자동화</span><span>#ROI</span><span>#거버넌스</span><span>#생산성</span>
          </div>
          <div class="sg-hero__meta" aria-label="가이드 정보">
            <span><strong>{published.length}</strong> Core Research</span>
            <span><strong>8</strong> Decision Lenses</span>
            <span><strong>1</strong> Research Map</span>
          </div>
        </div>

        <aside class="sg-lens" aria-label="AI 생산성 판단 축">
          <div class="sg-lens__brand">JOYLAB<br /><b>AI PRODUCTIVITY</b></div>
          <div class="sg-lens__item"><em>01</em><div><b>업무 적합성</b><span>무엇을 자동화할지가 아니라 어떤 업무에 AI가 맞는지 먼저 봅니다.</span></div></div>
          <div class="sg-lens__item"><em>02</em><div><b>통제 가능성</b><span>권한·승인·예외·복구를 포함해 사람이 남아야 할 지점을 봅니다.</span></div></div>
          <div class="sg-lens__item"><em>03</em><div><b>성과 측정</b><span>사용량보다 완료율·품질·비용·재작업으로 실제 생산성을 봅니다.</span></div></div>
        </aside>
      </div>

      <div class="sg-map-head">
        <div><span>START HERE</span><b>AI·생산성 Research Map</b></div>
        <a href="#research-path">{published.length}개 리서치 한 번에 보기 →</a>
      </div>

      <nav class="sg-map" aria-label="AI 생산성 리서치 경로">
        {published.map(({ article, step, short, role }, index) => (
          <a class={`sg-map__step ${index === 0 ? 'is-start' : ''} ${index === published.length - 1 ? 'is-compare' : ''}`} href={`/articles/${article!.id}`}>
            <em>{step}</em><b>{short}</b><span>{role}</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <main class="sg-main" id="research-path">
    <div class="sg-wrap sg-layout">
      <section>
        <div class="sg-section-head">
          <div><div class="sg-eyebrow">RESEARCH PATH</div><h2>AI 기능이 아니라 업무 결과까지 읽습니다</h2></div>
          <p>에이전트 개념에서 워크플로우·ROI·거버넌스·운영모델로 확장한 뒤, 마지막 Compare Hub에서 실제 업무 플랫폼을 같은 Lens로 비교합니다.</p>
        </div>

        <div class="sg-path">
          {published.map(({ article, step, role, note }, index) => (
            <article class={`sg-card ${index === published.length - 1 ? 'is-key' : ''}`}>
              <div class="sg-card__no">{step}</div>
              <div>
                <div class="sg-card__role">{role}</div>
                <h3><a href={`/articles/${article!.id}`}>{article!.data.title}</a></h3>
                <p>{note}</p>
                <div class="sg-card__foot">
                  {article!.data.tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}
                  <a class="sg-card__cta" href={`/articles/${article!.id}`}>{index === published.length - 1 ? '플랫폼 비교 보기 →' : '리서치 읽기 →'}</a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <section class="sg-insights" aria-labelledby="ai-prod-insights-title">
          <div class="sg-section-head sg-section-head--compact">
            <div><div class="sg-eyebrow">AI PRODUCTIVITY INSIGHTS</div><h2 id="ai-prod-insights-title">세 가지 기준으로 다시 봅니다</h2></div>
          </div>
          <div class="sg-insights__grid">
            <div><em>FIT</em><b>모든 업무를 에이전트화하지 않습니다</b><p>규칙·예외·비정형 입력·도구 이동을 보고 AI가 실제로 필요한 업무인지 판단합니다.</p></div>
            <div><em>CONTROL</em><b>자율성보다 통제 설계가 먼저입니다</b><p>최소권한·Human Approval·로그·중단·복구를 업무 흐름 안에 넣습니다.</p></div>
            <div><em>OUTCOME</em><b>사용량보다 완료된 일을 봅니다</b><p>Task Completion·Quality·Cost per Success·Rework를 같은 화면에서 확인합니다.</p></div>
          </div>
        </section>


        <section class="sg-insights" id="customer-center-ax-track" aria-labelledby="customer-center-ax-title">
          <div class="sg-section-head">
            <div>
              <div class="sg-eyebrow">CUSTOMER CENTER AX TRACK</div>
              <h2 id="customer-center-ax-title">고객센터 AX를 5단계 실무 구조로 연결합니다</h2>
            </div>
            <p>AI 생산성의 공통 원칙을 고객센터 현장에 적용한 전용 Track입니다. 자동화보다 먼저 판단 경계와 보안을 정하고, 생산성 → QA 코칭 → 리더십으로 확장합니다.</p>
          </div>

          <nav class="sg-map" aria-label="Customer Center AX 5단계 경로">
            {publishedCustomerCenterAx.map(({ article, step, title, role }, index) => (
              <a class={`sg-map__step ${index === 0 ? 'is-start' : ''} ${index === publishedCustomerCenterAx.length - 1 ? 'is-compare' : ''}`} href={`/articles/${article!.id}`}>
                <em>{step}</em><b>{title}</b><span>{role}</span>
              </a>
            ))}
          </nav>

          <div class="sg-path" style="margin-top:22px">
            {publishedCustomerCenterAx.map(({ article, step, role, note }, index) => (
              <article class={`sg-card ${index === publishedCustomerCenterAx.length - 1 ? 'is-key' : ''}`}>
                <div class="sg-card__no">{step}</div>
                <div>
                  <div class="sg-card__role">{role}</div>
                  <h3><a href={`/articles/${article!.id}`}>{article!.data.title}</a></h3>
                  <p>{note}</p>
                  <div class="sg-card__foot">
                    {article!.data.tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}
                    <a class="sg-card__cta" href={`/articles/${article!.id}`}>리서치 읽기 →</a>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <div class="sg-rule" style="margin-top:22px">
            <div class="sg-eyebrow">AX PRODUCT HUB</div>
            <h2>Research에서 끝내지 않고 전자책과 실행 도구로 이어집니다</h2>
            <div class="sg-rule__grid ai-prod-rule-grid">
              <div class="sg-rule__step"><b>BOOK</b><span>『AX 시대 살아남는 고객센터』에서 전체 구조와 실전 프롬프트를 통합해서 봅니다.</span></div>
              <div class="sg-rule__step"><b>GRAPH</b><span>Customer Center AX Guide에서 5개 리서치의 관계를 Research Graph로 탐색합니다.</span></div>
              <div class="sg-rule__step"><b>READER</b><span>Web Reader에서 테마·글꼴·글자크기를 저장하며 현장형 도구와 함께 읽습니다.</span></div>
              <div class="sg-rule__step"><b>NEXT</b><span>다음 단계는 Playbook과 Copilot Knowledge로 연결해 실제 운영 순간에 호출 가능한 지식으로 전환합니다.</span></div>
            </div>
            <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:18px">
              <a class="sg-card__cta" href="/guides/customer-center-ax">Customer Center AX Guide →</a>
              <a class="sg-card__cta" href="/books/ax-customer-center">AX 전자책 보기 →</a>
            </div>
          </div>
        </section>

        <section class="sg-rule" aria-labelledby="ai-prod-rule-title">
          <div class="sg-eyebrow">JOYLAB METHOD</div>
          <h2 id="ai-prod-rule-title">Problem → Capability → Workflow Fit → Human Control → Measurement → Risk → Scenario → Action</h2>
          <div class="sg-rule__grid ai-prod-rule-grid">
            <div class="sg-rule__step"><b>PROBLEM</b><span>어떤 업무 문제를 해결하려는지 먼저 정의합니다.</span></div>
            <div class="sg-rule__step"><b>CAPABILITY</b><span>모델·도구·에이전트가 실제로 가능한 범위를 확인합니다.</span></div>
            <div class="sg-rule__step"><b>WORKFLOW FIT</b><span>기존 프로세스 어디에 넣을지 설계합니다.</span></div>
            <div class="sg-rule__step"><b>HUMAN CONTROL</b><span>승인·검토·예외처리를 어디에 남길지 정합니다.</span></div>
            <div class="sg-rule__step"><b>MEASUREMENT</b><span>완료율·품질·비용·재작업을 측정합니다.</span></div>
            <div class="sg-rule__step"><b>RISK</b><span>권한·보안·환각·운영 리스크를 점검합니다.</span></div>
            <div class="sg-rule__step"><b>SCENARIO</b><span>성공·부분 성공·실패 조건을 나눠 봅니다.</span></div>
            <div class="sg-rule__step"><b>ACTION</b><span>다음에 설계·측정·검증할 조건을 남깁니다.</span></div>
          </div>
        </section>
      </section>

      <aside class="sg-rail" aria-label="AI 생산성 가이드 사용법">
        <section class="sg-rail-card sg-rail-card--dark">
          <small>START HERE</small>
          <h3>먼저 AI 에이전트부터</h3>
          <p>챗봇과 에이전트의 차이를 이해하면 이후 Workflow·ROI·Governance를 훨씬 쉽게 연결할 수 있습니다.</p>
          <a href="/articles/what-is-ai-agent">GC-A01부터 시작하기 →</a>
        </section>
        <section class="sg-rail-card">
          <small>CORE RESEARCH</small>
          <h3>7개 Gold Case 연결</h3>
          <ol><li>AI 에이전트</li><li>AI 업무자동화 구조</li><li>AI 도입 ROI</li><li>Agent Governance</li><li>Agent System Design</li><li>Operating Model</li><li>플랫폼 Compare Hub</li></ol>
        </section>

        <section class="sg-rail-card">
          <small>CUSTOMER CENTER AX</small>
          <h3>현장형 AX 5단 Track</h3>
          <p>AX 운영모델 → AI 보안 → 상담 생산성 → QA 코칭 → 리더십으로 이어지는 고객센터 전용 실행 경로입니다.</p>
          <a href="#customer-center-ax-track">5단 Track 바로가기 →</a>
        </section>
        <section class="sg-rail-card">
          <small>CODEX HUB</small>
          <h3>비개발자 Codex 실행 가이드</h3>
          <p>기본 세팅 → 자동화 사례 → Skill 설계를 하나의 학습 경로로 연결합니다.</p>
          <a href="/guides/codex">Codex Hub 바로가기 →</a>
        </section>
        <section class="sg-rail-card">
          <small>COMPARE HUB</small>
          <h3>마지막은 플랫폼 비교</h3>
          <p>ChatGPT·Claude·Gemini·Copilot을 모델 성능이 아니라 업무 적합성·통제·측정·조직 운영 기준으로 비교합니다.</p>
          <a href="/articles/ai-productivity-platforms-compare">4개 플랫폼 비교 바로가기 →</a>
        </section>
      </aside>
    </div>
  </main>
</BaseLayout>
