---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/semiconductor-guide-v2.css';
import { getCollection } from 'astro:content';

const sequence = [
  { id: 'what-is-hbm', step: '01', role: '기초 개념', short: 'HBM', note: 'AI 메모리의 핵심인 HBM 구조와 투자 체크포인트를 이해합니다.' },
  { id: 'semiconductor-cycle', step: '02', role: '업황 판단', short: 'Cycle', note: 'D램 가격·재고·CAPEX로 반도체 사이클의 위치를 판단합니다.' },
  { id: 'foreign-investor-flow', step: '03', role: '시장 수급', short: 'Flow', note: '외국인 순매수를 환율·지속성·가격 반응과 함께 해석합니다.' },
  { id: 'samsung-electronics-outlook', step: '04', role: '종목 허브', short: 'Samsung', note: '실적·HBM·수급을 삼성전자 투자 판단으로 연결합니다.' },
  { id: 'sk-hynix-outlook', step: '05', role: '종목 허브', short: 'SK hynix', note: 'HBM4·실적·CAPEX·수급을 SK하이닉스 관점에서 연결합니다.' },
  { id: 'samsung-vs-sk-hynix-ai-memory', step: '06', role: '비교 판단', short: 'Compare', note: '두 종목의 AI 메모리 투자 논리와 리스크를 같은 기준으로 비교합니다.' }
];

const collection = (await getCollection('articles')).filter((item) => !item.data.draft);
const byId = new Map(collection.map((item) => [item.id, item]));
const articles = sequence
  .map((entry) => ({ ...entry, article: byId.get(entry.id) }))
  .filter((entry) => entry.article);
---
<BaseLayout
  title="반도체 투자 가이드｜HBM부터 삼성전자·SK하이닉스 비교까지 | JoyLab"
  description="HBM, 반도체 사이클, 외국인 수급, 삼성전자, SK하이닉스, 두 종목 비교까지 JoyLab의 반도체 투자 핵심 글 6개를 한 흐름으로 연결합니다."
  bodyClass="semiconductor-guide-v2"
>
  <section class="sg-hero">
    <div class="sg-wrap sg-hero__inner">
      <div class="sg-eyebrow">JOYLAB RESEARCH MAP · SEMICONDUCTOR</div>
      <h1>반도체 투자 가이드</h1>
      <p class="sg-hero__lead">종목부터 보지 않습니다. <strong>기술 → 업황 → 수급 → 종목 → 비교</strong> 순서로 판단 근거를 쌓습니다. 아래 6개 리서치는 JoyLab 반도체 투자 클러스터의 기준 경로입니다.</p>
      <div class="sg-hero__meta" aria-label="가이드 정보">
        <span><strong>6</strong> Research</span>
        <span><strong>5</strong> Decision Layers</span>
        <span><strong>1</strong> Research Map</span>
      </div>

      <nav class="sg-map" aria-label="반도체 리서치 경로">
        {articles.map(({ article, step, short, role }, index) => (
          <a class={`sg-map__step ${index === 0 ? 'is-start' : ''}`} href={`/articles/${article!.id}`}>
            <em>{step}</em>
            <b>{short}</b>
            <span>{role}</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <main class="sg-main">
    <div class="sg-wrap sg-layout">
      <section>
        <div class="sg-section-head">
          <div>
            <div class="sg-eyebrow">RESEARCH PATH</div>
            <h2>판단 근거를 순서대로 쌓습니다</h2>
          </div>
          <p>HBM을 이해하고 업황을 확인한 뒤, 실제 자금의 방향을 보고, 마지막에 삼성전자와 SK하이닉스를 같은 기준으로 비교합니다.</p>
        </div>

        <div class="sg-path">
          {articles.map(({ article, step, role, note }, index) => (
            <article class={`sg-card ${index === 3 || index === 4 ? 'is-key' : ''}`}>
              <div class="sg-card__no">{step}</div>
              <div>
                <div class="sg-card__role">{role}</div>
                <h3><a href={`/articles/${article!.id}`}>{article!.data.title}</a></h3>
                <p>{note}</p>
                <div class="sg-card__foot">
                  {article!.data.tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}
                  <a class="sg-card__cta" href={`/articles/${article!.id}`}>리서치 읽기 →</a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <section class="sg-rule" aria-labelledby="sg-rule-title">
          <div class="sg-eyebrow">JOYLAB METHOD</div>
          <h2 id="sg-rule-title">Fact → Interpretation → Scenario → Action</h2>
          <div class="sg-rule__grid">
            <div class="sg-rule__step"><b>FACT</b><span>실적·가격·수급·공식 발표를 먼저 확인합니다.</span></div>
            <div class="sg-rule__step"><b>INTERPRETATION</b><span>숫자가 업황과 기업에 어떤 의미인지 연결합니다.</span></div>
            <div class="sg-rule__step"><b>SCENARIO</b><span>Bull·Base·Bear 조건을 나눠 가능성을 봅니다.</span></div>
            <div class="sg-rule__step"><b>ACTION</b><span>확인해야 할 다음 조건과 판단 기준을 남깁니다.</span></div>
          </div>
        </section>
      </section>

      <aside class="sg-rail" aria-label="가이드 사용법">
        <section class="sg-rail-card sg-rail-card--dark">
          <small>START HERE</small>
          <h3>처음이라면 01부터</h3>
          <p>HBM 개념 → 사이클 → 수급까지 먼저 읽은 뒤 종목 분석으로 넘어가면 뉴스 한 줄에 판단이 흔들리는 것을 줄일 수 있습니다.</p>
          <a href="/articles/what-is-hbm">HBM부터 시작하기 →</a>
        </section>

        <section class="sg-rail-card">
          <small>HOW TO USE</small>
          <h3>세 번 나눠 읽기</h3>
          <ol>
            <li>01~02: 기술과 업황</li>
            <li>03: 자금의 방향</li>
            <li>04~06: 종목과 비교</li>
          </ol>
        </section>

        <section class="sg-rail-card">
          <small>DECISION RULE</small>
          <h3>종목보다 조건을 먼저</h3>
          <p>이 페이지는 매수·매도 추천이 아니라 반도체 투자 판단에 필요한 조건과 읽는 순서를 제공합니다.</p>
        </section>
      </aside>
    </div>
  </main>
</BaseLayout>
