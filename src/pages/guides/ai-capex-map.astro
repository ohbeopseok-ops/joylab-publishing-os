---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/ai-capex-map-v1.css';
import capex from '../../data/ai-capex-leader-v1.json';
import regime from '../../data/ai-capex-regime-events-v1.json';
import history from '../../data/ai-capex-leader-history-v1.json';

const leaders = capex.leaders;
const gate = capex.skHynixGate;
const events = regime.events;
const latestHistory = [...history.snapshots].reverse().find((snapshot) => snapshot.asOf <= capex.asOf) ?? history.snapshots.at(-1);
const momentumByTicker = Object.fromEntries(
  leaders.map((leader) => {
    const series = history.snapshots.filter((snapshot) => snapshot.asOf <= capex.asOf).slice(-30).map((snapshot) => {
      const index = snapshot.leaders.findIndex((item) => item.ticker === leader.ticker);
      const item = index >= 0 ? snapshot.leaders[index] : null;
      return item ? {
        asOf: snapshot.asOf,
        score: item.score,
        rank: index + 1,
        status: item.status
      } : null;
    }).filter(Boolean);
    return [leader.ticker, series];
  })
);
const defaultMomentumTicker = leaders.find((x) => x.ticker === '000660')?.ticker ?? leaders[0]?.ticker;
const defaultMomentumSeries = momentumByTicker[defaultMomentumTicker] ?? [];
const defaultMomentumCurrent = defaultMomentumSeries.at(-1);
const defaultMomentumPrev = defaultMomentumSeries.at(-2);
const defaultScoreDelta = defaultMomentumCurrent && defaultMomentumPrev ? defaultMomentumCurrent.score - defaultMomentumPrev.score : 0;
const defaultRankDelta = defaultMomentumCurrent && defaultMomentumPrev ? defaultMomentumPrev.rank - defaultMomentumCurrent.rank : 0;
const layers = [
  ['01','POLICY / BIG TECH','US AI ecosystem'],
  ['02','CAPEX','GPU · ASIC · Data Center'],
  ['03','BOTTLENECK','HBM · FCBGA · Grid'],
  ['04','KOREA SUPPLY','Memory · PCB · Power'],
  ['05','EARNINGS','Revenue · EPS · Backlog'],
  ['06','MARKET','Flow · 20DMA · RS'],
  ['07','LEADER','Score + Hard Gate']
];
---
<BaseLayout
  title="AI CAPEX Leader Map｜미국 AI CAPEX에서 한국 주도주까지 | JoyLab"
  description="미국 AI CAPEX가 GPU·HBM·기판·전력망을 거쳐 한국 기업의 실적과 주가로 전달되는 경로를 JoyLab AI CAPEX Leader Engine V1.0으로 추적합니다."
  bodyClass="ai-capex-map-v1"
>
  <section class="acm-hero">
    <div class="acm-wrap">
      <div class="acm-kicker">JOYLAB · AI CAPEX LEADER ENGINE V1.0</div>
      <h1>미국 AI CAPEX가<br/><span>한국 주도주로 바뀌는 경로</span></h1>
      <p>정책·빅테크 이름보다 <strong>CAPEX → Bottleneck → Supply Chain → EPS → Price</strong>의 전달 경로를 봅니다. 점수는 투자 추천이 아니라 같은 기준으로 리서치 우선순위를 비교하기 위한 프레임입니다.</p>
      <div class="acm-meta"><span>As of <b>{capex.asOf}</b></span><span>Universe <b>10</b></span><span>Hard Gate <b>3</b></span></div>
    </div>
  </section>

  <main class="acm-wrap acm-main">
    <section class="acm-flow" aria-label="AI CAPEX evidence chain">
      {layers.map(([no,title,desc]) => <div class="acm-flow-card"><em>{no}</em><b>{title}</b><span>{desc}</span></div>)}
    </section>

    <section class="acm-section">
      <div class="acm-head"><div><small>LEADER BOARD</small><h2>AI CAPEX TOP10</h2></div><p>Exposure 30 + Bottleneck 25 + EPS Revision 25 + Price Confirmation 20</p></div>
      <div class="acm-table-shell">
        <table class="acm-table">
          <thead><tr><th>#</th><th>기업</th><th>Layer</th><th>Score</th><th>Status</th><th>Evidence path</th></tr></thead>
          <tbody>
            {leaders.map((x) => (
              <tr class={x.ticker === '000660' ? 'is-focus' : ''} data-company={x.ticker}>
                <td>{x.rank}</td>
                <td><button class="acm-company" type="button" data-target={x.ticker}><b>{x.company}</b><span>{x.ticker}</span></button></td>
                <td>{x.layer}</td>
                <td><strong class="acm-score">{x.score}</strong></td>
                <td><span class:list={['acm-status', x.status.toLowerCase()]}>{x.status}</span></td>
                <td>{x.path}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div id="acm-detail" class="acm-detail" aria-live="polite">
        <small>SELECTED · {leaders[0].ticker}</small>
        <h3>{leaders[0].company} · {leaders[0].score}</h3>
        <p>{leaders[0].note}</p>
        <div>{leaders[0].path}</div>
      </div>
    </section>

    <section class="acm-section acm-momentum">
      <div class="acm-head"><div><small>LEADER MOMENTUM 30D</small><h2>Score · Rank · Regime</h2></div><p>일별 Snapshot이 쌓일수록 최근 30거래일의 점수 방향, 순위 지속성, Regime 변화를 함께 봅니다.</p></div>
      <div class="acm-momentum-picker" role="group" aria-label="Momentum company selector">
        {leaders.map((x) => <button type="button" data-momentum-ticker={x.ticker} class={x.ticker === defaultMomentumTicker ? 'is-active' : ''}>{x.company}</button>)}
      </div>
      <div class="acm-momentum-strip">
        <article><small>Current Score</small><strong id="acm-m-score">{defaultMomentumCurrent?.score ?? '—'}</strong></article>
        <article><small>Δ Previous</small><strong id="acm-m-score-delta">{defaultScoreDelta >= 0 ? '+' : ''}{defaultScoreDelta}</strong></article>
        <article><small>Current Rank</small><strong id="acm-m-rank">{defaultMomentumCurrent?.rank ? '#' + defaultMomentumCurrent.rank : '—'}</strong></article>
        <article><small>Rank Change</small><strong id="acm-m-rank-delta">{defaultRankDelta >= 0 ? '+' : ''}{defaultRankDelta}</strong></article>
        <article><small>Regime</small><strong id="acm-m-regime">{defaultMomentumCurrent?.status ?? '—'}</strong></article>
      </div>
      <div class="acm-momentum-grid">
        <article class="acm-chart-card">
          <div><small>SCORE</small><b id="acm-score-range">Last {defaultMomentumSeries.length} snapshots</b></div>
          <svg id="acm-score-chart" viewBox="0 0 600 160" role="img" aria-label="Leader Score trend"><line x1="0" y1="80" x2="600" y2="80"></line><line x1="0" y1="115" x2="600" y2="115"></line><polyline points=""></polyline></svg>
          <div class="acm-chart-foot"><span>Leader 80</span><span>Strong 70</span></div>
        </article>
        <article class="acm-chart-card">
          <div><small>RANK</small><b id="acm-rank-range">1 = strongest</b></div>
          <svg id="acm-rank-chart" viewBox="0 0 600 160" role="img" aria-label="Leader rank trend"><polyline points=""></polyline></svg>
          <div class="acm-chart-foot"><span>Top 3</span><span>Top 5</span></div>
        </article>
      </div>
      <div class="acm-regime-lane">
        <small>REGIME LANE</small>
        <div id="acm-regime-lane"></div>
      </div>
    </section>

    <section class="acm-section acm-gate">
      <div class="acm-head"><div><small>ENTRY GATE</small><h2>SK하이닉스 · Leader-WAIT → Leader-CONFIRMED</h2></div><p>총점이 높아도 세 개의 Hard Gate가 모두 통과해야 Confirmed로 승격합니다.</p></div>
      <div class="acm-gate-grid">
        {gate.checks.map((x) => (
          <article>
            <div><b>{x.label}</b><span class:list={['gate-badge', x.status.toLowerCase()]}>{x.status}</span></div>
            <p>{x.rule}</p><small>{x.evidence}</small>
          </article>
        ))}
      </div>
      <div class="acm-confirm-rule">
        <b>CONFIRMED RULE</b>
        <span>5D 외국인 Flow 양전환</span><i>+</i><span>20DMA 2일 연속 상회·기울기 ≥ 0</span><i>+</i><span>20D RS ≥ KOSPI +2.0%p</span><i>=</i><strong>LEADER-CONFIRMED</strong>
      </div>
    </section>

    <section class="acm-section acm-timeline">
      <div class="acm-head"><div><small>REGIME CHANGE TIMELINE</small><h2>WAIT ↔ CONFIRMED가 바뀔 때만 기록합니다</h2></div><p>일별 점수는 History에 쌓고, Timeline에는 SK하이닉스의 상태 전환 이벤트만 남깁니다.</p></div>
      <div class="acm-history-summary"><span>Latest snapshot <b>{latestHistory?.asOf ?? capex.asOf}</b></span><span>Stored snapshots <b>{history.snapshots.length}</b></span><span>Regime events <b>{events.length}</b></span></div>
      {events.length ? (
        <div class="acm-timeline-list">
          {events.slice().reverse().map((event) => (
            <article>
              <time>{event.asOf}</time>
              <div><b>{event.company}</b><span>{event.from}</span><i>→</i><strong>{event.to}</strong></div>
              <em>Score {event.score}</em>
            </article>
          ))}
        </div>
      ) : (
        <div class="acm-empty-event"><b>아직 Regime Change 없음</b><span>현재 기준선은 {gate.currentStatus}. 다음 WAIT ↔ CONFIRMED 전환부터 자동 기록됩니다.</span></div>
      )}
    </section>

    <section class="acm-section acm-method">
      <div class="acm-head"><div><small>METHOD</small><h2>점수와 Gate를 분리합니다</h2></div></div>
      <div class="acm-method-grid">
        <article><em>30</em><b>AI CAPEX Exposure</b><p>빅테크 CAPEX가 해당 기업의 제품·매출로 얼마나 직접 연결되는지 봅니다.</p></article>
        <article><em>25</em><b>Bottleneck</b><p>공급 희소성, 진입장벽, 공급부족 지속성을 평가합니다.</p></article>
        <article><em>25</em><b>EPS Revision</b><p>실적 성장, 추정치 상향, 수주·LTA 가시성을 봅니다.</p></article>
        <article><em>20</em><b>Price Confirmation</b><p>20일 상대강도, 추세, 외국인·기관 Flow, 거래 유동성을 봅니다.</p></article>
      </div>
    </section>
  </main>

  <script define:vars={{ leaders, momentumByTicker, defaultMomentumTicker }}>
    const detail = document.getElementById('acm-detail');
    const rows = document.querySelectorAll('[data-company]');
    const buttons = document.querySelectorAll('[data-target]');
    const byTicker = new Map(leaders.map((x) => [x.ticker, x]));
    const momentumButtons = document.querySelectorAll('[data-momentum-ticker]');
    const scoreChart = document.querySelector('#acm-score-chart polyline');
    const rankChart = document.querySelector('#acm-rank-chart polyline');
    const regimeLane = document.getElementById('acm-regime-lane');
    const mScore = document.getElementById('acm-m-score');
    const mScoreDelta = document.getElementById('acm-m-score-delta');
    const mRank = document.getElementById('acm-m-rank');
    const mRankDelta = document.getElementById('acm-m-rank-delta');
    const mRegime = document.getElementById('acm-m-regime');
    const scoreRange = document.getElementById('acm-score-range');

    const makePoints = (series, key, invert = false) => {
      if (!series.length) return '';
      const values = series.map((item) => Number(item[key]));
      const min = key === 'score' ? 60 : 1;
      const max = key === 'score' ? 100 : Math.max(10, ...values);
      const width = 600;
      const height = 140;
      return series.map((item, index) => {
        const x = series.length === 1 ? width / 2 : (index / (series.length - 1)) * width;
        const raw = Number(item[key]);
        const ratioRaw = max === min ? .5 : (raw - min) / (max - min);
        const ratio = Math.max(0, Math.min(1, ratioRaw));
        const y = invert ? ratio * height + 10 : (1 - ratio) * height + 10;
        return `${x.toFixed(1)},${y.toFixed(1)}`;
      }).join(' ');
    };

    const renderMomentum = (ticker) => {
      const series = momentumByTicker[ticker] || [];
      const current = series.at(-1);
      const prev = series.at(-2);
      const scoreDelta = current && prev ? current.score - prev.score : 0;
      const rankDelta = current && prev ? prev.rank - current.rank : 0;
      if (mScore) mScore.textContent = current ? String(current.score) : '—';
      if (mScoreDelta) mScoreDelta.textContent = current && prev ? `${scoreDelta >= 0 ? '+' : ''}${scoreDelta}` : '—';
      if (mRank) mRank.textContent = current ? `#${current.rank}` : '—';
      if (mRankDelta) mRankDelta.textContent = current && prev ? `${rankDelta >= 0 ? '+' : ''}${rankDelta}` : '—';
      if (mRegime) mRegime.textContent = current?.status || '—';
      if (scoreRange) scoreRange.textContent = `Last ${series.length} snapshots`;
      if (scoreChart) scoreChart.setAttribute('points', makePoints(series, 'score', false));
      if (rankChart) rankChart.setAttribute('points', makePoints(series, 'rank', true));
      if (regimeLane) {
        regimeLane.replaceChildren();
        series.forEach((item) => {
          const node = document.createElement('span');
          node.textContent = item.status;
          node.title = `${item.asOf} · ${item.status}`;
          node.dataset.regime = item.status.toLowerCase();
          regimeLane.append(node);
        });
      }
      momentumButtons.forEach((button) => button.classList.toggle('is-active', button.getAttribute('data-momentum-ticker') === ticker));
    };

    momentumButtons.forEach((button) => button.addEventListener('click', () => {
      const ticker = button.getAttribute('data-momentum-ticker');
      if (ticker) renderMomentum(ticker);
    }));
    renderMomentum(defaultMomentumTicker);

    buttons.forEach((button) => button.addEventListener('click', () => {
      const ticker = button.getAttribute('data-target');
      const item = byTicker.get(ticker);
      if (!item || !detail) return;
      rows.forEach((row) => row.classList.toggle('is-selected', row.getAttribute('data-company') === ticker));
      detail.replaceChildren();
      const meta = document.createElement('small');
      meta.textContent = `SELECTED · ${item.ticker}`;
      const title = document.createElement('h3');
      title.textContent = `${item.company} · ${item.score}`;
      const note = document.createElement('p');
      note.textContent = item.note;
      const path = document.createElement('div');
      path.textContent = item.path;
      detail.append(meta, title, note, path);
    }));
  </script>
</BaseLayout>
