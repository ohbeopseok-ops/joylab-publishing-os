---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/semiconductor-guide-v2.css';
import '../../../../styles/growth-leadership-guide-v2.css';

const faq = [
  ['『노인과 바다』에서 배울 수 있는 핵심 리더십은 무엇인가요?', '현재 성과와 사람의 전체 가치를 분리해서 보는 관점입니다. 결과를 평가하되 실패 이후의 학습, 태도, 행동 변화와 다시 시도할 가능성까지 함께 봅니다.'],
  ['성과가 낮은 구성원에게 가장 먼저 확인해야 할 것은 무엇인가요?', '의지, 역량, 방법, 환경 중 어디에서 문제가 발생했는지 먼저 구분해야 합니다.'],
  ['GRIT은 단순히 오래 버티는 것인가요?', '무조건 버티는 것이 아니라 목표를 유지하면서 현실을 인정하고 방법을 수정하며 다시 시도하는 힘으로 보는 편이 실무적으로 유용합니다.'],
  ['공정한 성과관리는 어떻게 해야 하나요?', '개인이 통제할 수 있었던 행동과 통제할 수 없었던 외부 변수를 분리하고, 단일 결과보다 행동 변화와 추세를 함께 봐야 합니다.']
];

const takeaways = [
  ['01', '성과부진과 역량 부족은 같은 말이 아니다', '성과는 현재 상태를 보여주는 중요한 신호지만 한 사람의 전체 가능성을 설명하는 완전한 데이터는 아닙니다. 단일 KPI보다 추세, 피드백 적용, 반복 실수 감소, 학습 속도를 함께 봐야 합니다.'],
  ['02', 'KPI가 같아도 원인은 다를 수 있다', '같은 성과 미달이라도 WILL·SKILL·METHOD·ENVIRONMENT 중 어디에서 문제가 발생했는지 먼저 분리해야 코칭이 정확해집니다.'],
  ['03', 'GRIT은 버티기가 아니라 조정하며 계속 가는 힘이다', '목표는 유지하되 현실을 인정하고 방법을 수정할 수 있어야 합니다. 같은 행동을 반복하는 끈기는 성장보다 고착에 가까울 수 있습니다.'],
  ['04', '책임은 통제 가능한 영역에서 정의해야 한다', '개인이 바꿀 수 있는 행동과 콜량·시스템·정책·시장처럼 직접 통제하기 어려운 외부 변수를 분리해야 공정한 평가와 책임 설정이 가능합니다.'],
  ['05', '실패 이후 행동이 다음 평가의 핵심이다', '실패를 허용한다는 것은 기준을 낮추는 것이 아닙니다. 무엇을 배웠고, 무엇을 바꿨고, 같은 문제가 줄었는지를 더 엄격하게 보는 것입니다.']
];

const coachingQuestions = [
  '최근 성과 중 가장 먼저 개선해야 한다고 느끼는 항목은 무엇인가요?',
  '성과가 흔들리기 시작한 시점에 이전과 달라진 것은 무엇인가요?',
  '현재 어려움은 의지·지식·기술·방법·환경 중 어디에 가장 가깝나요?',
  '이번 결과에서 본인이 통제할 수 없었던 부분은 무엇이었나요?',
  '반대로 본인이 바꿀 수 있었던 행동은 무엇이었나요?',
  '같은 상황이 다시 온다면 한 가지 다르게 할 행동은 무엇인가요?',
  '최근 받은 피드백 가운데 실제 업무에 적용한 것은 무엇인가요?',
  '알고 있지만 아직 실행되지 않는 부분은 무엇인가요?',
  '최근 스스로 잘했다고 생각하는 사례는 무엇인가요?',
  '성과를 올리기 위해 리더에게 필요한 지원은 무엇인가요?',
  '이번 주에 반드시 바꿀 행동 하나는 무엇인가요?',
  '언제, 무엇을 기준으로 변화 여부를 다시 확인하면 좋을까요?'
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: '성과가 무너졌을 때 사람이 보인다',
  alternativeHeadline: '『노인과 바다』에서 배우는 성과관리와 리더십',
  description: '『노인과 바다』를 성과관리, GRIT, 공정한 평가, 성과부진 코칭 관점에서 분석하고 실제 리더 행동으로 번역한 JoyLab Literature & Leadership Research.',
  mainEntityOfPage: 'https://aijoylab.kr/guides/growth-leadership/literature/old-man-and-the-sea',
  image: 'https://aijoylab.kr/images/leadership/literature/ep01-old-man-and-the-sea.webp',
  author: { '@type': 'Organization', name: 'JoyLab', url: 'https://aijoylab.kr' },
  publisher: { '@type': 'Organization', name: 'JoyLab', url: 'https://aijoylab.kr' },
  about: ['Leadership', 'Performance Management', 'GRIT', 'Coaching', 'The Old Man and the Sea']
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q, a]) => ({
    '@type': 'Question', name: q,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};
---

<BaseLayout
  title="노인과 바다 리더십｜성과가 무너졌을 때 사람이 보인다 | JoyLab"
  description="헤밍웨이 『노인과 바다』를 성과관리와 리더십 관점에서 다시 읽습니다. GRIT, 성과부진 코칭, 공정한 평가와 구성원 성장의 원칙을 실제 리더 행동으로 번역합니다."
  canonical="https://aijoylab.kr/guides/growth-leadership/literature/old-man-and-the-sea"
  type="article"
  image="/images/leadership/literature/ep01-old-man-and-the-sea.webp"
  imageWidth={1200}
  imageHeight={675}
  bodyClass="growth-leadership-guide-v2 literature-essay-page literature-research-page"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main class="le-wrap">
    <nav class="le-breadcrumb" aria-label="Breadcrumb">
      <a href="/">JoyLab</a><span>›</span>
      <a href="/guides/growth-leadership">성장·리더십</a><span>›</span>
      <a href="/guides/growth-leadership/literature">문학에서 배우는 리더십</a>
    </nav>

    <header class="le-hero">
      <div class="sg-eyebrow">LITERATURE & LEADERSHIP RESEARCH · EP01</div>
      <h1>성과가 무너졌을 때<br /><span>사람이 보인다</span></h1>
      <p class="le-subtitle">『노인과 바다』에서 배우는 성과관리와 리더십</p>
      <p class="le-intro">산티아고는 84일 동안 물고기를 잡지 못했습니다. 숫자만 보면 성과부진자입니다. 그러나 성과가 없다는 사실과 그 사람이 무능하다는 판단은 정말 같은 말일까요?</p>
      <div class="le-meta" aria-label="리서치 핵심 주제">
        <span>Performance Management</span>
        <span>GRIT</span>
        <span>Coaching</span>
        <span>Fair Evaluation</span>
      </div>
    </header>

    <section class="le-visual le-visual--ep01" aria-label="노인과 바다 리더십 비주얼">
      <div><span>EP01</span><b>PERFORMANCE × GRIT</b></div>
    </section>

    <article class="le-body">
      <section class="le-research-brief">
        <div class="sg-eyebrow">RESEARCH BRIEF</div>
        <h2>성과가 보이지 않는 시간에도, 사람에 대한 평가는 계속 만들어진다.</h2>
        <p>『노인과 바다』에서 산티아고는 장기간 성과를 내지 못한 뒤 거대한 청새치를 잡지만, 돌아오는 길에 상어 떼에게 결과의 대부분을 빼앗깁니다. 겉으로 보면 그는 다시 실패했습니다.</p>
        <p>하지만 그 과정에는 단일 결과로 설명되지 않는 것이 남습니다. 경험, 판단, 끈기, 문제 해결, 자기통제, 재도전 의지, 그리고 끝까지 자신의 역할을 수행하는 태도입니다.</p>
        <blockquote>성과가 낮다는 사실을 확인하는 것은 관리다.<br />왜 성과가 낮은지 보는 것은 리더십이다.</blockquote>
        <div class="le-diagnosis">
          <article><b>WILL</b><span>하려는 의지가 있는가</span></article>
          <article><b>SKILL</b><span>할 수 있는 역량이 있는가</span></article>
          <article><b>METHOD</b><span>현재 방법이 맞는가</span></article>
          <article><b>ENVIRONMENT</b><span>환경이 성과를 막고 있는가</span></article>
        </div>
      </section>

      <section class="le-key-takeaways">
        <div class="sg-eyebrow">KEY TAKEAWAYS</div>
        <h2>『노인과 바다』가 리더에게 남기는 5가지 판단 기준</h2>
        <div class="le-takeaway-list">
          {takeaways.map(([no, title, body]) => (
            <article>
              <div class="le-takeaway-list__no">{no}</div>
              <div>
                <h3>{title}</h3>
                <p>{body}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section>
        <div class="sg-eyebrow">DEEP DIVE · PERFORMANCE</div>
        <h2>성과와 사람을 분리해서 보는 법</h2>
        <p>“이번 성과가 좋지 않았다”와 “이 사람은 역량이 없다”는 전혀 다른 문장입니다. 첫 번째는 현재 상태에 대한 관찰이고, 두 번째는 사람 전체에 대한 판단입니다.</p>
        <p>리더가 이 둘을 구분하지 못하면 코칭은 쉽게 낙인으로 변합니다. 그래서 단일 KPI보다 다음 변화를 함께 봐야 합니다.</p>
        <ul>
          <li>성과 추세는 개선되고 있는가</li>
          <li>같은 실수가 줄고 있는가</li>
          <li>피드백 이후 행동이 바뀌었는가</li>
          <li>학습 속도가 빨라지고 있는가</li>
          <li>도움을 요청하고 실제로 활용하는가</li>
        </ul>
      </section>

      <section>
        <div class="sg-eyebrow">DEEP DIVE · GRIT</div>
        <h2>GRIT은 무조건 오래 버티는 힘이 아니다</h2>
        <p>산티아고는 자신의 현실을 부정하지 않습니다. 자신이 늙었다는 것도, 체력이 예전과 같지 않다는 사실도 압니다. 하지만 현실을 인정하는 것과 포기하는 것은 다릅니다.</p>
        <div class="le-callout">
          <b>JOYLAB INTERPRETATION</b>
          <p>GRIT은 목표를 유지하면서도 방법을 수정할 수 있는 힘이다.</p>
        </div>
      </section>

      <section>
        <div class="sg-eyebrow">DEEP DIVE · RESPONSIBILITY</div>
        <h2>조직에도 상어가 있다</h2>
        <p>산티아고는 청새치를 잡지만 항구로 돌아오는 과정에서 결과를 잃습니다. 조직에도 콜량, 시스템 장애, 정책 변화, 고객 상황, 시장 변화처럼 개인이 직접 통제하기 어려운 변수가 존재합니다.</p>
        <div class="le-control">
          <article><small>CONTROL</small><h3>내가 바꿀 수 있는 것</h3><p>준비, 질문 방식, 설명 순서, 피드백 적용, 재시도, 학습</p></article>
          <article><small>NO CONTROL</small><h3>내가 바꾸기 어려운 것</h3><p>콜량, 시스템 장애, 정책 변화, 특정 고객 상황, 외부 환경</p></article>
        </div>
        <blockquote class="is-dark">좋은 리더는 책임을 없애주는 사람이 아니다.<br />책임의 범위를 정확히 구분하는 사람이다.</blockquote>
      </section>

      <section>
        <div class="sg-eyebrow">COACHING QUESTIONS</div>
        <h2>성과부진 면담에서 바로 쓰는 12개 질문</h2>
        <p>질문은 진단 → 자기인식 → 통제 영역 → 행동설계 → 재점검 순서로 사용합니다.</p>
        <ol class="le-question-list">
          {coachingQuestions.map((question) => <li>{question}</li>)}
        </ol>
        <div class="le-gold-question">
          <small>GOLD QUESTION</small>
          <p>이번 결과에서 본인이 바꿀 수 있었던 행동은 무엇이었나요?</p>
        </div>
      </section>

      <section class="le-action">
        <div class="sg-eyebrow">LEADERSHIP ACTION</div>
        <h2>한 사람을 숫자에서 분리해 다시 본다.</h2>
        <div class="le-action-grid">
          <article><b>01 · DIAGNOSE</b><p>성과가 낮은 구성원 한 명을 선택하고 WILL · SKILL · METHOD · ENVIRONMENT로 원인을 다시 분류합니다.</p></article>
          <article><b>02 · SEPARATE</b><p>개인이 통제할 수 있었던 행동과 통제하기 어려웠던 외부 변수를 구분합니다.</p></article>
          <article><b>03 · COMMIT</b><p>다음 주기에서 바꿀 행동 목표를 1~2개만 합의하고 관찰 가능한 성공 기준을 정합니다.</p></article>
          <article><b>04 · FOLLOW UP</b><p>재점검 시점을 그 자리에서 정하고 KPI보다 먼저 행동 변화가 실제로 일어났는지 확인합니다.</p></article>
        </div>
        <a href="/guides/growth-leadership/playbook/performance-coaching">성과부진 코칭 Leader Playbook →</a>
      </section>

      <section class="le-conclusion">
        <div class="sg-eyebrow">JOYLAB CONCLUSION</div>
        <p>성과를 무시하면 조직이 무너집니다. 하지만 성과만 보면 사람을 잃습니다.</p>
        <h2>결과가 무너진 사람에게서<br />당신은 무엇을 보고 있는가.</h2>
        <p>성과인가, 실패인가, 아니면 아직 끝나지 않은 사람인가.</p>
      </section>
    </article>

    <section class="le-faq">
      <div class="sg-eyebrow">FAQ</div>
      <h2>『노인과 바다』와 리더십</h2>
      {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </section>

    <section class="le-next" aria-labelledby="ep02-next-title">
      <div>
        <small>NEXT · EP02</small>
        <h2 id="ep02-next-title">『어린 왕자』 — 관계를 만든다는 것은 무엇을 책임지는가</h2>
        <p>다음 Research에서는 여우와 어린 왕자의 관계를 통해 신뢰, 책임, 관계 형성, 리더의 영향력을 살펴봅니다.</p>
      </div>
      <a href="/guides/growth-leadership/literature#ep02">EP02 미리 보기 →</a>
    </section>

    <footer class="le-back">
      <a href="/guides/growth-leadership/literature">← 문학에서 배우는 리더십 전체 보기</a>
    </footer>
  </main>
</BaseLayout>
