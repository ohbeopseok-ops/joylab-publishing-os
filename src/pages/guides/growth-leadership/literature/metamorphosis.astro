---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/semiconductor-guide-v2.css';
import '../../../../styles/growth-leadership-guide-v2.css';

const faq = [
  ['『변신』을 리더십 관점에서 읽을 때 핵심 질문은 무엇인가요?', '한 사람이 기존 역할과 생산성을 잃었을 때 조직이 그 사람의 가치까지 함께 낮춰 보는지 묻는 것입니다. 성과 평가와 인간 존엄은 분리해서 다뤄야 합니다.'],
  ['성과가 낮은 구성원을 존중하면 기준이 느슨해지지 않나요?', '존중과 기준은 반대말이 아닙니다. 성과 기준은 명확하게 유지하되 사람을 모욕하거나 존재 가치까지 부정하지 않는 것이 핵심입니다.'],
  ['역할을 바꿔야 할 때 리더가 먼저 해야 할 일은 무엇인가요?', '현재 역할에서의 성과 문제와 다른 역할에서 활용 가능한 강점, 학습 가능성, 지원 필요성을 분리해 확인하는 것입니다.'],
  ['성과부진이 오래 지속되면 결국 판단해야 하지 않나요?', '그렇습니다. 다만 판단은 구체적인 성과 기준, 지원 이력, 행동 변화, 재배치 가능성에 근거해야 하며 사람 전체에 대한 낙인으로 확장되어서는 안 됩니다.']
];

const takeaways = [
  ['01', '성과의 상실과 인간의 가치 상실은 같은 사건이 아니다', '역할 수행이 어려워졌다는 사실은 중요하지만 그것이 곧 사람 전체의 가치가 사라졌다는 뜻은 아닙니다. 리더는 성과와 존재 가치를 분리해서 판단해야 합니다.'],
  ['02', '조직은 사람을 역할로 축소하기 쉽다', '직무, 직책, 생산성은 조직 운영에 필요하지만 사람이 그 역할과 동일한 존재로 취급되면 역할 변화나 실패 순간 존엄까지 흔들릴 수 있습니다.'],
  ['03', '성과부진은 관계의 질을 드러낸다', '성과가 좋을 때의 존중보다 성과가 무너졌을 때 어떤 언어와 태도로 대하는지가 조직문화의 실제 기준을 보여줍니다.'],
  ['04', '재배치와 회복 가능성은 평가의 일부다', '현재 역할에서의 실패만 볼 것이 아니라 다른 역할에서의 강점, 학습 가능성, 필요한 지원과 전환 옵션까지 검토해야 더 정확한 판단이 됩니다.'],
  ['05', '존엄을 지키는 평가는 책임을 흐리지 않는다', '무엇이 부족했는지, 어떤 기준을 충족하지 못했는지 분명히 말하면서도 사람 자체를 낮추지 않는 것이 공정한 리더십입니다.']
];

const coachingQuestions = [
  '지금 나는 성과 문제를 사람의 성격이나 가치 문제로 확대하고 있지 않나요?',
  '이 구성원이 충족하지 못한 기준을 구체적으로 설명할 수 있나요?',
  '성과 하락 전에는 이 사람이 어떤 강점을 보여줬나요?',
  '현재 역할이 이 사람의 강점과 맞지 않을 가능성은 없나요?',
  '충분한 교육·도구·시간·피드백을 제공했나요?',
  '지원 이후 실제 행동 변화가 있었나요?',
  '같은 기준을 다른 구성원에게도 동일하게 적용하고 있나요?',
  '성과가 좋을 때와 나쁠 때 내가 사용하는 언어가 달라지나요?',
  '재배치·업무 조정·학습 기회를 검토했나요?',
  '성과 기준과 인간적 존중을 동시에 유지하고 있나요?',
  '이 사람에게 지금 필요한 것은 경고, 지원, 재설계, 전환 중 무엇인가요?',
  '다음 판단 시점에 무엇을 기준으로 계속·전환·종료를 결정할 것인가요?'
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: '쓸모를 잃으면 사람의 가치도 사라지는가',
  alternativeHeadline: '『변신』에서 배우는 성과와 존엄의 리더십',
  description: '카프카 『변신』을 성과, 역할상실, 존엄, 재배치와 공정한 평가의 관점에서 분석하고 실제 리더 행동으로 번역한 JoyLab Literature & Leadership Research.',
  mainEntityOfPage: 'https://aijoylab.kr/guides/growth-leadership/literature/metamorphosis',
  image: 'https://aijoylab.kr/images/leadership/literature/ep04-metamorphosis-v1.webp',
  author: { '@type': 'Organization', name: 'JoyLab', url: 'https://aijoylab.kr' },
  publisher: { '@type': 'Organization', name: 'JoyLab', url: 'https://aijoylab.kr' },
  about: ['Leadership','Performance','Human Dignity','Role Transition','Metamorphosis']
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q,a]) => ({
    '@type':'Question', name:q,
    acceptedAnswer:{ '@type':'Answer', text:a }
  }))
};
---

<BaseLayout
  title="변신 리더십｜쓸모를 잃으면 사람의 가치도 사라지는가 | JoyLab"
  description="카프카 『변신』을 성과와 존엄의 리더십 관점에서 다시 읽습니다. 역할상실, 성과부진, 재배치, 공정한 평가와 인간적 존중을 실제 조직 행동으로 번역합니다."
  canonical="https://aijoylab.kr/guides/growth-leadership/literature/metamorphosis"
  type="article"
  image="/images/leadership/literature/ep04-metamorphosis-v1.webp"
  imageWidth={1200}
  imageHeight={675}
  bodyClass="growth-leadership-guide-v2 literature-essay-page literature-research-page"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main class="le-wrap">
    <nav class="le-breadcrumb" aria-label="Breadcrumb">
      <a href="/">JoyLab</a><span>›</span>
      <a href="/guides/growth-leadership">성장·리더십</a><span>›</span>
      <a href="/guides/growth-leadership/literature">문학에서 배우는 리더십</a>
    </nav>

    <header class="le-hero">
      <div class="sg-eyebrow">LITERATURE & LEADERSHIP RESEARCH · EP04</div>
      <h1>쓸모를 잃으면<br /><span>사람의 가치도 사라지는가</span></h1>
      <p class="le-subtitle">『변신』에서 배우는 성과와 존엄의 리더십</p>
      <p class="le-intro">조직은 사람에게 역할을 부여하고 성과를 요구합니다. 문제는 역할 수행이 무너졌을 때 시작됩니다. 성과가 사라진 순간 우리는 그 사람의 가치까지 함께 낮춰 보고 있지는 않을까요?</p>
      <div class="le-meta">
        <span>Performance</span><span>Dignity</span><span>Role Transition</span><span>Fair Evaluation</span>
      </div>
    </header>

    <section class="le-visual le-visual--ep04" aria-label="변신 성과와 존엄 리더십 비주얼">
      <div><span>EP04</span><b>PERFORMANCE × DIGNITY</b></div>
      <i aria-hidden="true"></i>
    </section>

    <article class="le-body">
      <section class="le-research-brief">
        <div class="sg-eyebrow">RESEARCH BRIEF</div>
        <h2>사람은 역할보다 크지만, 조직은 사람을 역할로 기억하기 쉽다.</h2>
        <p>『변신』의 불편함은 외형의 변화 자체보다 그 이후 관계가 어떻게 달라지는지에 있습니다. 가족과 주변 사람들은 더 이상 예전과 같은 역할을 수행하지 못하는 존재를 점점 부담으로 바라봅니다.</p>
        <p>조직에서도 비슷한 일이 생깁니다. 높은 성과를 내던 사람이 부진해지거나, 익숙한 역할을 수행하지 못하거나, 변화된 업무에 적응하지 못하면 평가의 언어가 쉽게 사람 전체로 확장됩니다.</p>
        <blockquote>성과를 평가하는 것은 필요하다.<br />하지만 사람을 성과와 동일시하는 순간 평가는 낙인이 된다.</blockquote>
        <div class="le-diagnosis">
          <article><b>PERFORMANCE</b><span>현재 결과는 어떤가</span></article>
          <article><b>ROLE FIT</b><span>역할과 강점은 맞는가</span></article>
          <article><b>SUPPORT</b><span>충분한 지원이 있었는가</span></article>
          <article><b>DIGNITY</b><span>존중은 유지되고 있는가</span></article>
        </div>
      </section>

      <section class="le-key-takeaways">
        <div class="sg-eyebrow">KEY TAKEAWAYS</div>
        <h2>『변신』이 리더에게 남기는 5가지 평가 원칙</h2>
        <div class="le-takeaway-list">
          {takeaways.map(([no,title,body]) => (
            <article><div class="le-takeaway-list__no">{no}</div><div><h3>{title}</h3><p>{body}</p></div></article>
          ))}
        </div>
      </section>

      <section>
        <div class="sg-eyebrow">DEEP DIVE · PERFORMANCE</div>
        <h2>성과가 무너지면 우리는 사람을 얼마나 빨리 다시 정의하는가</h2>
        <p>성과가 좋을 때는 성실함, 책임감, 역량을 이야기하다가 성과가 떨어지는 순간 태도와 인성까지 의심하는 경우가 있습니다. 하지만 결과의 변화가 곧 사람 전체의 변화는 아닙니다.</p>
        <div class="le-callout"><b>JOYLAB INTERPRETATION</b><p>성과는 평가해야 하지만 사람을 설명하는 유일한 문장이 되어서는 안 된다.</p></div>
      </section>

      <section>
        <div class="sg-eyebrow">DEEP DIVE · ROLE FIT</div>
        <h2>지금 역할에서 실패한 것과 조직에서 쓸모가 없는 것은 다르다</h2>
        <p>어떤 사람은 역할이 바뀌면 다시 강점을 드러냅니다. 그래서 성과부진을 볼 때는 현재 역할 적합성과 전환 가능성을 함께 봐야 합니다.</p>
        <div class="le-control">
          <article><small>CHECK FIRST</small><h3>현재 역할에서 확인할 것</h3><p>기대 기준, 업무 난이도, 숙련도, 지원 수준, 반복 오류</p></article>
          <article><small>CHECK NEXT</small><h3>전환 가능성에서 확인할 것</h3><p>강점, 이전 성공 사례, 학습 속도, 다른 역할 적합성, 재배치 가능성</p></article>
        </div>
        <blockquote class="is-dark">역할 실패는 사람의 실패가 아니다.<br />다만 다음 역할을 찾는 책임까지 사라지는 것도 아니다.</blockquote>
      </section>

      <section>
        <div class="sg-eyebrow">DEEP DIVE · DIGNITY</div>
        <h2>존엄을 지키는 평가는 기준을 낮추지 않는다</h2>
        <p>인간적 존중은 성과 문제를 말하지 않는 것이 아닙니다. 오히려 구체적인 기준과 사실을 분명하게 말하면서 모욕, 비꼼, 공개적 낙인, 과도한 일반화를 피하는 것입니다.</p>
        <ul>
          <li>사람이 아니라 행동과 결과를 말하는가</li>
          <li>기준을 사전에 공유했는가</li>
          <li>개선 기회를 실제로 제공했는가</li>
          <li>동일한 기준을 적용하고 있는가</li>
          <li>판단의 근거를 설명할 수 있는가</li>
        </ul>
      </section>

      <section>
        <div class="sg-eyebrow">COACHING QUESTIONS</div>
        <h2>성과와 존엄을 동시에 지키는 12개 리더 질문</h2>
        <p>질문은 사실 확인 → 역할 적합성 → 지원 → 책임 → 전환 판단 순서로 사용합니다.</p>
        <ol class="le-question-list">
          {coachingQuestions.map((q)=><li>{q}</li>)}
        </ol>
        <div class="le-gold-question">
          <small>GOLD QUESTION</small>
          <p>나는 지금 이 사람의 성과를 평가하고 있는가, 사람 전체를 평가하고 있는가?</p>
        </div>
      </section>

      <section class="le-action">
        <div class="sg-eyebrow">LEADERSHIP ACTION</div>
        <h2>성과부진자를 ‘문제 인력’으로 부르기 전에 역할과 지원을 다시 본다.</h2>
        <div class="le-action-grid">
          <article><b>01 · FACT</b><p>감정과 인상을 제외하고 현재 성과와 반복 행동을 사실로 정리합니다.</p></article>
          <article><b>02 · FIT</b><p>현재 역할과 개인의 강점이 맞는지, 다른 역할 가능성이 있는지 확인합니다.</p></article>
          <article><b>03 · SUPPORT</b><p>교육·도구·피드백·시간 등 조직이 제공해야 할 지원을 점검합니다.</p></article>
          <article><b>04 · DECIDE</b><p>명확한 시점과 기준으로 유지·재설계·전환·종료를 판단합니다.</p></article>
        </div>
        <a href="/guides/growth-leadership/playbook/performance-coaching">성과부진 코칭 Leader Playbook →</a>
      </section>

      <section class="le-conclusion">
        <div class="sg-eyebrow">JOYLAB CONCLUSION</div>
        <p>좋은 조직은 성과를 엄격하게 보면서도 사람을 함부로 축소하지 않습니다.</p>
        <h2>역할이 무너진 순간에도<br />당신은 그 사람에게 무엇을 남겨두는가.</h2>
        <p>기준인가, 기회인가, 아니면 최소한의 존엄인가.</p>
      </section>
    </article>

    <section class="le-faq">
      <div class="sg-eyebrow">FAQ</div>
      <h2>『변신』과 성과·존엄 리더십</h2>
      {faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}
    </section>

    <section class="le-next" aria-labelledby="ep05-next-title">
      <div>
        <small>NEXT · EP05</small>
        <h2 id="ep05-next-title">『동물농장』 — 좋은 규칙은 왜 시간이 지나며 변질되는가</h2>
        <p>다음 Research에서는 권력과 조직문화의 관점에서 규칙이 어떻게 바뀌고, 구성원은 왜 그 변화를 받아들이게 되는지 살펴봅니다.</p>
      </div>
      <a href="/guides/growth-leadership/literature#ep05">EP05 미리 보기 →</a>
    </section>

    <footer class="le-back">
      <a href="/guides/growth-leadership/literature">← 문학에서 배우는 리더십 전체 보기</a>
    </footer>
  </main>
</BaseLayout>
