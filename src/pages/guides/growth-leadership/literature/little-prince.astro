---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/semiconductor-guide-v2.css';
import '../../../../styles/growth-leadership-guide-v2.css';

const faq = [
  ['『어린 왕자』에서 리더십과 가장 직접적으로 연결되는 주제는 무엇인가요?', '관계는 단순한 친밀감이 아니라 반복되는 관심, 시간, 약속, 기억을 통해 만들어지고 그만큼 책임이 생긴다는 점입니다.'],
  ['좋은 리더는 모든 구성원과 가까워져야 하나요?', '가까움 자체보다 예측 가능한 관심과 일관된 기준이 중요합니다. 관계의 질은 친밀도보다 신뢰 가능성에 더 가깝습니다.'],
  ['신뢰를 쌓는 가장 작은 행동은 무엇인가요?', '약속한 시점에 다시 확인하고, 이전 대화의 맥락을 기억하며, 구성원의 말을 다음 행동에 반영하는 것입니다.'],
  ['책임감 있는 관계와 과잉 개입은 어떻게 구분하나요?', '리더의 책임은 대신 결정해주는 것이 아니라 필요한 정보와 기준을 제공하고, 상대가 스스로 선택하고 성장할 수 있게 돕는 데 있습니다.']
];

const takeaways = [
  ['01', '관계는 선언이 아니라 반복되는 행동으로 만들어진다', '한 번의 좋은 대화보다 약속을 지키고 다시 확인하며 맥락을 기억하는 반복이 신뢰를 만듭니다.'],
  ['02', '관계를 맺는 순간 서로에게 영향력이 생긴다', '리더의 말과 반응은 구성원의 자기인식과 행동에 영향을 줍니다. 관계가 깊을수록 리더의 피드백은 더 큰 무게를 가집니다.'],
  ['03', '시간을 쓴 대상은 특별해진다', '리더가 누구에게 어떤 시간을 쓰는지는 조직의 우선순위를 보여줍니다. 관심은 말보다 일정과 후속 행동에서 드러납니다.'],
  ['04', '신뢰는 예측 가능성에서 자란다', '좋은 관계는 감정 기복이 적고 기준이 일관됩니다. 같은 상황에서 비슷한 원칙이 적용될 때 구성원은 리더를 신뢰할 수 있습니다.'],
  ['05', '책임은 대신 해주는 것이 아니라 끝까지 연결하는 것이다', '리더가 모든 문제를 해결해주는 것이 아니라, 다음 행동과 재점검까지 연결해 상대가 스스로 성장하도록 돕는 것이 관계의 책임입니다.']
];

const coachingQuestions = [
  '최근 구성원과 약속하고 다시 확인하지 못한 것은 무엇인가요?',
  '내가 자주 대화하는 사람과 그렇지 않은 사람 사이에 정보 격차가 생기고 있지는 않나요?',
  '구성원은 내가 어떤 기준으로 판단하는지 예측할 수 있나요?',
  '최근 피드백에서 상대의 맥락보다 내 해석을 먼저 말한 적은 없나요?',
  '이 사람에게 지금 필요한 것은 답, 질문, 정보, 시간 중 무엇인가요?',
  '내가 준 피드백이 상대의 행동에 어떤 영향을 만들었나요?',
  '신뢰를 낮춘 작은 약속 불이행은 없었나요?',
  '관계를 좋게 유지하려고 필요한 기준을 말하지 못한 적은 없나요?',
  '구성원에게 기대하는 책임과 내가 져야 할 책임은 각각 무엇인가요?',
  '내가 대신 해주고 있어 오히려 성장 기회를 빼앗는 일은 없나요?',
  '이번 주 한 사람과 관계를 더 나아지게 할 구체적 행동은 무엇인가요?',
  '언제 다시 확인하고, 무엇이 달라졌는지 어떻게 볼 것인가요?'
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: '관계를 만든다는 것은 무엇을 책임지는가',
  alternativeHeadline: '『어린 왕자』에서 배우는 신뢰와 책임의 리더십',
  description: '『어린 왕자』의 관계 형성 장면을 신뢰, 책임, 피드백, 리더의 영향력 관점에서 분석하고 실제 리더 행동으로 번역한 JoyLab Literature & Leadership Research.',
  mainEntityOfPage: 'https://aijoylab.kr/guides/growth-leadership/literature/little-prince',
  image: 'https://aijoylab.kr/images/leadership/literature/ep02-little-prince.webp',
  author: { '@type': 'Organization', name: 'JoyLab', url: 'https://aijoylab.kr' },
  publisher: { '@type': 'Organization', name: 'JoyLab', url: 'https://aijoylab.kr' },
  about: ['Leadership', 'Trust', 'Responsibility', 'Feedback', 'The Little Prince']
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q, a]) => ({
    '@type': 'Question', name: q,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};
---

<BaseLayout
  title="어린 왕자 리더십｜관계를 만든다는 것은 무엇을 책임지는가 | JoyLab"
  description="『어린 왕자』를 신뢰와 책임의 리더십 관점에서 다시 읽습니다. 관계 형성, 피드백, 일관성, 리더의 영향력을 실제 조직 행동으로 번역합니다."
  canonical="https://aijoylab.kr/guides/growth-leadership/literature/little-prince"
  type="article"
  image="/images/leadership/literature/ep02-little-prince.webp"
  imageWidth={1200}
  imageHeight={675}
  bodyClass="growth-leadership-guide-v2 literature-essay-page literature-research-page"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main class="le-wrap">
    <nav class="le-breadcrumb" aria-label="Breadcrumb">
      <a href="/">JoyLab</a><span>›</span>
      <a href="/guides/growth-leadership">성장·리더십</a><span>›</span>
      <a href="/guides/growth-leadership/literature">문학에서 배우는 리더십</a>
    </nav>

    <header class="le-hero">
      <div class="sg-eyebrow">LITERATURE & LEADERSHIP RESEARCH · EP02</div>
      <h1>관계를 만든다는 것은<br /><span>무엇을 책임지는가</span></h1>
      <p class="le-subtitle">『어린 왕자』에서 배우는 신뢰와 책임의 리더십</p>
      <p class="le-intro">관계는 호감만으로 유지되지 않습니다. 시간을 쓰고, 약속을 만들고, 서로의 행동에 영향을 주기 시작하는 순간 책임도 함께 생깁니다. 리더의 관계 역시 같습니다.</p>
      <div class="le-meta" aria-label="리서치 핵심 주제">
        <span>Trust</span>
        <span>Responsibility</span>
        <span>Feedback</span>
        <span>Leadership Relationship</span>
      </div>
    </header>

    <section class="le-visual le-visual--ep02" aria-label="어린 왕자 관계 리더십 비주얼">
      <div><span>EP02</span><b>RELATIONSHIP × RESPONSIBILITY</b></div>
      <i aria-hidden="true"></i>
    </section>

    <article class="le-body">
      <section class="le-research-brief">
        <div class="sg-eyebrow">RESEARCH BRIEF</div>
        <h2>좋은 관계는 가까움보다 책임의 구조에 가깝다.</h2>
        <p>『어린 왕자』에서 중요한 변화는 누군가가 갑자기 특별해지는 데 있지 않습니다. 서로에게 시간을 쓰고, 기다리고, 반복해서 만나며, 이전에는 없던 의미가 생기는 과정에 있습니다.</p>
        <p>조직에서도 관계는 비슷하게 만들어집니다. 구성원은 리더가 한 말을 기억하고, 약속한 피드백을 기다리며, 어떤 상황에서 어떤 기준이 적용되는지를 관찰합니다. 신뢰는 친밀한 분위기보다 반복되는 경험에서 만들어집니다.</p>
        <blockquote>관계를 만든다는 것은 상대에게 영향력을 갖는 일이고,<br />영향력을 갖는 순간 책임도 시작된다.</blockquote>
        <div class="le-diagnosis">
          <article><b>ATTENTION</b><span>관심을 실제 시간으로 쓰는가</span></article>
          <article><b>CONSISTENCY</b><span>기준과 반응이 일관적인가</span></article>
          <article><b>MEMORY</b><span>이전 대화와 약속을 기억하는가</span></article>
          <article><b>FOLLOW-UP</b><span>관계를 다음 행동까지 연결하는가</span></article>
        </div>
      </section>

      <section class="le-key-takeaways">
        <div class="sg-eyebrow">KEY TAKEAWAYS</div>
        <h2>『어린 왕자』가 리더에게 남기는 5가지 관계 원칙</h2>
        <div class="le-takeaway-list">
          {takeaways.map(([no, title, body]) => (
            <article>
              <div class="le-takeaway-list__no">{no}</div>
              <div><h3>{title}</h3><p>{body}</p></div>
            </article>
          ))}
        </div>
      </section>

      <section>
        <div class="sg-eyebrow">DEEP DIVE · TRUST</div>
        <h2>신뢰는 좋은 의도가 아니라 예측 가능성에서 생긴다</h2>
        <p>구성원이 리더를 신뢰한다는 것은 리더가 항상 친절하다는 뜻이 아닙니다. 오히려 어떤 상황에서 어떤 기준을 적용할지 예상할 수 있다는 의미에 가깝습니다.</p>
        <p>기준이 사람마다 달라지고, 피드백 시점이 들쭉날쭉하며, 약속한 후속 조치가 사라지면 좋은 의도만으로는 신뢰를 유지하기 어렵습니다.</p>
        <div class="le-callout"><b>JOYLAB INTERPRETATION</b><p>신뢰는 감정의 결과가 아니라 반복되는 일관성의 결과다.</p></div>
      </section>

      <section>
        <div class="sg-eyebrow">DEEP DIVE · RESPONSIBILITY</div>
        <h2>관계를 맺었다면 피드백 이후까지 책임져야 한다</h2>
        <p>리더는 평가와 피드백을 통해 구성원의 행동에 영향을 줍니다. 그래서 피드백을 말하는 순간이 끝이 아니라 시작에 가깝습니다.</p>
        <div class="le-control">
          <article><small>LEADER RESPONSIBILITY</small><h3>리더가 해야 할 것</h3><p>기준 설명, 맥락 확인, 약속 기록, 장애 제거, 재점검</p></article>
          <article><small>MEMBER RESPONSIBILITY</small><h3>구성원이 해야 할 것</h3><p>행동 선택, 실행, 질문, 학습, 결과 공유</p></article>
        </div>
        <blockquote class="is-dark">좋은 관계는 책임을 대신 떠안는 것이 아니라,<br />서로의 책임이 어디까지인지 분명히 하는 것이다.</blockquote>
      </section>

      <section>
        <div class="sg-eyebrow">DEEP DIVE · LEADERSHIP</div>
        <h2>관계를 좋게 유지하려고 기준을 낮추면 오히려 신뢰가 무너진다</h2>
        <p>관계를 중시하는 리더가 빠지기 쉬운 함정은 불편한 피드백을 미루는 것입니다. 하지만 필요한 말을 하지 않는 것은 배려가 아니라 책임 회피가 될 수 있습니다.</p>
        <ul>
          <li>관계를 지키기 위해 사실을 흐리지 않는가</li>
          <li>기대 수준을 명확하게 설명했는가</li>
          <li>사람이 아니라 행동을 기준으로 피드백하는가</li>
          <li>피드백 이후 다시 확인하는가</li>
          <li>좋은 관계와 낮은 기준을 혼동하고 있지는 않은가</li>
        </ul>
      </section>

      <section>
        <div class="sg-eyebrow">COACHING QUESTIONS</div>
        <h2>관계와 신뢰를 점검하는 12개 리더 질문</h2>
        <p>질문은 관계 진단 → 책임 구분 → 행동 설계 → 재점검 순서로 사용합니다.</p>
        <ol class="le-question-list">
          {coachingQuestions.map((question) => <li>{question}</li>)}
        </ol>
        <div class="le-gold-question">
          <small>GOLD QUESTION</small>
          <p>이 관계에서 내가 약속했지만 아직 끝까지 연결하지 못한 것은 무엇인가요?</p>
        </div>
      </section>

      <section class="le-action">
        <div class="sg-eyebrow">LEADERSHIP ACTION</div>
        <h2>한 사람과의 관계를 ‘좋은 느낌’이 아니라 행동으로 점검한다.</h2>
        <div class="le-action-grid">
          <article><b>01 · REMEMBER</b><p>최근 1:1에서 나눈 핵심 약속과 구성원이 요청한 지원을 한 줄로 정리합니다.</p></article>
          <article><b>02 · CLARIFY</b><p>리더와 구성원이 각각 책임져야 할 행동을 분리해 다시 확인합니다.</p></article>
          <article><b>03 · ACT</b><p>리더가 먼저 지켜야 할 약속 하나를 실행하고 상대가 체감할 수 있게 연결합니다.</p></article>
          <article><b>04 · FOLLOW UP</b><p>정해진 시점에 다시 만나 관계의 느낌이 아니라 실제 행동 변화와 신뢰 회복 여부를 확인합니다.</p></article>
        </div>
        <a href="/guides/growth-leadership/literature">Literature & Leadership 전체 보기 →</a>
      </section>

      <section class="le-conclusion">
        <div class="sg-eyebrow">JOYLAB CONCLUSION</div>
        <p>관계는 리더십의 부가 요소가 아니라 실행을 움직이는 인프라입니다.</p>
        <h2>누군가와 관계를 만들었다면<br />그 관계에서 무엇을 책임지고 있는가.</h2>
        <p>좋은 의도인가, 일관된 행동인가, 아니면 끝까지 이어지는 약속인가.</p>
      </section>
    </article>

    <section class="le-faq">
      <div class="sg-eyebrow">FAQ</div>
      <h2>『어린 왕자』와 관계 리더십</h2>
      {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </section>

    <section class="le-next" aria-labelledby="ep03-next-title">
      <div>
        <small>NEXT · EP03</small>
        <h2 id="ep03-next-title">『데미안』 — 리더는 답을 줘야 하는가, 찾게 해야 하는가</h2>
        <p>다음 Research에서는 성장과 자기결정의 관점에서 리더가 답을 주는 사람인지, 스스로 답을 찾게 돕는 사람인지 살펴봅니다.</p>
      </div>
      <a href="/guides/growth-leadership/literature/demian">EP03 Research 읽기 →</a>
    </section>

    <footer class="le-back">
      <a href="/guides/growth-leadership/literature">← 문학에서 배우는 리더십 전체 보기</a>
    </footer>
  </main>
</BaseLayout>
