---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/semiconductor-guide-v2.css';
import '../../../../styles/growth-leadership-guide-v2.css';

const faq = [
  [
    "변화 저항은 결국 태도 문제 아닌가요?",
    "일부는 태도 문제일 수 있지만 학습 부담, 실패 위험, 역할 상실감, 보상 구조 등 현실적 비용도 함께 봐야 합니다."
  ],
  [
    "변화를 빠르게 정착시키려면 무엇이 필요한가요?",
    "변화 이유, 새 행동, 학습 시간, 지원 자원, 초기 성공 경험을 함께 설계하는 것이 중요합니다."
  ],
  [
    "모든 사람의 속도를 맞춰줘야 하나요?",
    "속도를 무한정 맞출 수는 없습니다. 다만 최소 학습 기간과 지원을 제공한 뒤 명확한 전환 기준을 적용해야 합니다."
  ]
];
const takeaways = [
  [
    "01",
    "변화는 손실을 동반한다",
    "익숙한 능력, 지위, 자신감 일부를 내려놓아야 할 수 있습니다."
  ],
  [
    "02",
    "저항을 의지로만 설명하지 않는다",
    "학습 비용과 실패 위험을 함께 봐야 합니다."
  ],
  [
    "03",
    "작은 성공이 전환을 가속한다",
    "초기 성공 경험은 변화의 불확실성을 낮춥니다."
  ],
  [
    "04",
    "학습 시간도 자원이다",
    "새 방식을 요구하면서 학습 시간을 주지 않으면 변화는 추가 업무가 됩니다."
  ],
  [
    "05",
    "지원 이후에는 기준이 필요하다",
    "충분한 지원 뒤에는 새 기준에 대한 책임도 분명히 해야 합니다."
  ]
];
const coachingQuestions = [
  "구성원은 왜 바뀌어야 하는지 이해하나요?",
  "변화로 잃게 되는 것은 무엇인가요?",
  "새로 배워야 할 기술은 무엇인가요?",
  "학습 시간이 실제로 확보돼 있나요?",
  "초기 실패를 허용할 범위가 있나요?",
  "작은 성공을 경험할 과제가 있나요?",
  "변화 전후의 기대 행동이 명확한가요?",
  "기존 KPI가 새 행동을 방해하지 않나요?",
  "리더 자신도 새 방식을 사용하고 있나요?",
  "도움을 요청할 채널이 있나요?",
  "지원 종료 시점과 새 기준이 정해져 있나요?",
  "나는 저항을 태도로 판단하는가, 전환 비용으로 분석하는가?"
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: "익숙함을 떠나는 비용을 조직은 어떻게 다루는가",
  alternativeHeadline: "『갈매기의 꿈』에서 배우는 변화와 성장의 리더십",
  description: "리처드 바크 『갈매기의 꿈』을 변화, 성장, 학습 비용과 전환 지원 관점에서 분석한 JoyLab Literature & Leadership Research.",
  mainEntityOfPage: "https://aijoylab.kr/guides/growth-leadership/literature/jonathan-livingston-seagull",
  author: { '@type':'Organization', name:'JoyLab', url:'https://aijoylab.kr' },
  publisher: { '@type':'Organization', name:'JoyLab', url:'https://aijoylab.kr' },
  about: ["Leadership","Change","Growth","Learning","Jonathan Livingston Seagull"]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q,a]) => ({
    '@type':'Question', name:q,
    acceptedAnswer:{ '@type':'Answer', text:a }
  }))
};

const breadcrumbSchema = {
  '@context':'https://schema.org',
  '@type':'BreadcrumbList',
  itemListElement:[
    { '@type':'ListItem', position:1, name:'JoyLab', item:'https://aijoylab.kr/' },
    { '@type':'ListItem', position:2, name:'성장·리더십', item:'https://aijoylab.kr/guides/growth-leadership' },
    { '@type':'ListItem', position:3, name:'문학에서 배우는 리더십', item:'https://aijoylab.kr/guides/growth-leadership/literature' },
    { '@type':'ListItem', position:4, name:"갈매기의 꿈", item:"https://aijoylab.kr/guides/growth-leadership/literature/jonathan-livingston-seagull" }
  ]
};
---

<BaseLayout
  title="갈매기의 꿈 리더십｜익숙함을 떠나는 비용을 조직은 어떻게 다루는가 | JoyLab"
  description="리처드 바크 『갈매기의 꿈』을 통해 변화 저항, 학습 비용, 성장 욕구와 조직의 전환 지원을 살펴봅니다."
  canonical="https://aijoylab.kr/guides/growth-leadership/literature/jonathan-livingston-seagull"
  type="article"
  bodyClass="growth-leadership-guide-v2 literature-essay-page literature-research-page"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <main class="le-wrap">
    <nav class="le-breadcrumb" aria-label="Breadcrumb">
      <a href="/">JoyLab</a><span>›</span>
      <a href="/guides/growth-leadership">성장·리더십</a><span>›</span>
      <a href="/guides/growth-leadership/literature">문학에서 배우는 리더십</a>
    </nav>

    <header class="le-hero">
      <div class="sg-eyebrow">LITERATURE & LEADERSHIP RESEARCH · EP14</div>
      <h1>익숙함을 떠나는 비용을<br /><span>조직은 어떻게 다루는가</span></h1>
      <p class="le-subtitle">『갈매기의 꿈』에서 배우는 변화와 성장</p>
      <p class="le-intro">변화를 거부하는 사람을 쉽게 의지 부족으로 설명할 수 있습니다. 하지만 새로운 방식은 학습 시간, 실패 위험, 정체성 변화라는 비용을 요구합니다. 성장 리더십은 변화의 필요성뿐 아니라 변화의 비용까지 설계합니다.</p>
      <div class="le-meta"><span>Change</span><span>Growth</span><span>Learning</span><span>Transition</span></div>
    </header>

    <section class="le-visual le-visual--ep14" aria-label="갈매기의 꿈 변화와 성장 비주얼">
      <div><span>EP14</span><b>CHANGE × GROWTH</b></div>
      <i aria-hidden="true"></i>
    </section>

    <article class="le-body">
      <section class="le-research-brief">
        <div class="sg-eyebrow">RESEARCH BRIEF</div>
        <h2>변화 저항은 의지의 문제가 아니라 익숙한 능력을 내려놓고 다시 초보가 되는 비용의 문제일 수 있다.</h2>
        <p>『갈매기의 꿈』은 익숙한 방식에 머무르는 집단과 더 높은 가능성을 탐색하는 개인의 긴장을 보여줍니다. 변화는 단순한 선택이 아니라 기존 질서와 정체성을 벗어나는 과정입니다.</p>
        <p>조직에서도 새로운 도구, 역할, KPI를 도입할 때 “왜 안 하느냐”만 묻기보다 무엇을 잃고 무엇을 새로 배워야 하는지 확인해야 합니다.</p>
        <blockquote>변화의 필요성을 설명하는 것만으로는 부족하다.<br />변화의 비용을 감당할 수 있게 만들어야 한다.</blockquote>
        <div class="le-diagnosis">
          <article><b>WHY</b><span>왜 바뀌어야 하는가</span></article>
          <article><b>LOSS</b><span>무엇을 잃는가</span></article>
          <article><b>LEARN</b><span>무엇을 새로 배워야 하는가</span></article>
          <article><b>SUPPORT</b><span>누가 어떻게 지원하는가</span></article>
        </div>
      </section>

      <section class="le-key-takeaways">
        <div class="sg-eyebrow">KEY TAKEAWAYS</div>
        <h2>『갈매기의 꿈』이 리더에게 남기는 5가지 원칙</h2>
        <div class="le-takeaway-list">
          {takeaways.map(([no,title,body]) => (
            <article><div class="le-takeaway-list__no">{no}</div><div><h3>{title}</h3><p>{body}</p></div></article>
          ))}
        </div>
      </section>

      <section>
        <div class="sg-eyebrow">DEEP DIVE · CHANGE</div>
        <h2>새로운 방식은 기존의 능숙함을 잠시 무너뜨린다</h2>
        <p>숙련자는 변화 순간 다시 초보자가 될 수 있습니다. 그래서 변화에는 기술 학습뿐 아니라 자신감과 정체성의 재조정이 포함됩니다.</p>
        <div class="le-callout"><b>JOYLAB INTERPRETATION</b><p>변화 관리의 핵심은 사람을 설득하는 것만이 아니라 다시 초보가 될 수 있는 안전한 학습 구간을 만드는 것이다.</p></div>
      </section>

      <section>
        <div class="sg-eyebrow">DEEP DIVE · GROWTH</div>
        <h2>지원과 책임을 순서대로 배치한다</h2>
        <p>초기에는 교육, 시간, 코칭과 작은 성공을 제공하고 전환 기간 이후에는 새 기준에 대한 책임을 명확히 해야 합니다. 지원만 있고 기준이 없거나 기준만 있고 지원이 없으면 둘 다 실패합니다.</p>
        <div class="le-control">
          <article><small>CHECK FIRST</small><h3>전환 초기에</h3><p>이유, 학습시간, 지원자, 작은 성공 과제를 제공합니다.</p></article>
          <article><small>CHECK NEXT</small><h3>전환 이후</h3><p>새 행동 기준, 점검 시점, 미달 시 후속 조치를 명확히 합니다.</p></article>
        </div>
        <blockquote class="is-dark">사람은 변화를 싫어해서가 아니라<br />변화 과정에서 잃을 것을 두려워할 수 있다.</blockquote>
      </section>

      <section>
        <div class="sg-eyebrow">COACHING QUESTIONS</div>
        <h2>변화와 성장을 설계하는 12개 리더 질문</h2>
        <p>이유 → 손실 → 학습 → 지원 → 책임 순으로 확인합니다.</p>
        <ol class="le-question-list">
          {coachingQuestions.map((q)=><li>{q}</li>)}
        </ol>
        <div class="le-gold-question">
          <small>GOLD QUESTION</small>
          <p>변화 저항은 의지의 문제인가, 익숙함을 떠나는 비용의 문제인가?</p>
        </div>
      </section>

      <section class="le-action">
        <div class="sg-eyebrow">LEADERSHIP ACTION</div>
        <h2>다음 변화 과제를 “요구사항”이 아니라 “전환 설계”로 다시 작성한다.</h2>
        <div class="le-action-grid">
          <article><b>01 · WHY</b><p>변화 이유와 기대 결과를 한 문장으로 씁니다.</p></article>
          <article><b>02 · COST</b><p>구성원이 치를 학습 비용을 적습니다.</p></article>
          <article><b>03 · SUPPORT</b><p>시간·교육·코칭을 배정합니다.</p></article>
          <article><b>04 · STANDARD</b><p>전환 후 새 기준과 점검 시점을 정합니다.</p></article>
        </div>
        <a href="/guides/growth-leadership/literature/framework">Leadership Framework V2 →</a>
      </section>

      <section class="le-conclusion">
        <div class="sg-eyebrow">JOYLAB CONCLUSION</div>
        <p>변화는 구호로 정착하지 않습니다.</p>
        <h2>새 행동을 요구한다면<br />새 행동을 배울 조건도 함께 제공해야 한다.</h2>
        <p>성장 리더십은 지원과 책임을 동시에 설계합니다.</p>
      </section>
    </article>

    <section class="le-faq">
      <div class="sg-eyebrow">FAQ</div>
      <h2>『갈매기의 꿈』과 변화와 성장</h2>
      {faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}
    </section>

    <section class="le-next">
      <div>
        <small>NEXT · EP15</small>
        <h2>『우리들의 일그러진 영웅』 — 권위는 언제 질서에서 지배로 변하는가</h2>
        <p>다음 Wave에서는 권위, 복종과 침묵이 조직문화로 굳어지는 과정을 살펴봅니다.</p>
      </div>
      <a href="/guides/growth-leadership/literature#ep15">EP15 미리 보기 →</a>
    </section>

    <footer class="le-back">
      <a href="/guides/growth-leadership/literature/othello">← EP13 오셀로</a>
      <a href="/guides/growth-leadership/literature">전체 시리즈 →</a>
    </footer>
  </main>
</BaseLayout>
