---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/semiconductor-guide-v2.css';
import '../../../../styles/growth-leadership-guide-v2.css';

const nodes = [
  { ep:'EP01', title:'노인과 바다', domain:'SELF', theme:'성과', concern:'performance', href:'/guides/growth-leadership/literature/old-man-and-the-sea', live:true },
  { ep:'EP02', title:'어린 왕자', domain:'PEOPLE', theme:'관계', concern:'relationship', href:'/guides/growth-leadership/literature/little-prince', live:true },
  { ep:'EP03', title:'데미안', domain:'SELF', theme:'성장', concern:'growth', href:'/guides/growth-leadership/literature/demian', live:true },
  { ep:'EP04', title:'변신', domain:'PEOPLE', theme:'존엄', concern:'fairness', href:'/guides/growth-leadership/literature/metamorphosis', live:true },
  { ep:'EP05', title:'동물농장', domain:'ORGANIZATION', theme:'권력', concern:'power', href:'/guides/growth-leadership/literature/animal-farm', live:true },
  { ep:'EP06', title:'1984', domain:'ORGANIZATION', theme:'심리적 안전', concern:'safety', href:'/guides/growth-leadership/literature/1984', live:true },
  { ep:'EP07', title:'이방인', domain:'SELF', theme:'판단', concern:'judgment', href:'/guides/growth-leadership/literature/the-stranger', live:true },
  { ep:'EP08', title:'레미제라블', domain:'PEOPLE', theme:'공정성', concern:'fairness', href:'/guides/growth-leadership/literature/les-miserables', live:true },
  { ep:'EP09', title:'파리대왕', domain:'ORGANIZATION', theme:'시스템', concern:'system', href:'/guides/growth-leadership/literature/lord-of-the-flies', live:true },
  { ep:'EP10', title:'죄와 벌', domain:'ORGANIZATION', theme:'책임', concern:'accountability', href:'/guides/growth-leadership/literature/crime-and-punishment', live:true },
  { ep:'EP11', title:'햄릿', domain:'LEADERSHIP', theme:'의사결정', concern:'decision', href:'/guides/growth-leadership/literature/hamlet', live:true },
  { ep:'EP12', title:'안티고네', domain:'LEADERSHIP', theme:'갈등', concern:'conflict', href:'/guides/growth-leadership/literature/antigone', live:true },
  { ep:'EP13', title:'오셀로', domain:'PEOPLE', theme:'신뢰', concern:'trust', href:'/guides/growth-leadership/literature/othello', live:true },
  { ep:'EP14', title:'갈매기의 꿈', domain:'LEADERSHIP', theme:'변화', concern:'change', href:'/guides/growth-leadership/literature/jonathan-livingston-seagull', live:true },
  { ep:'EP15', title:'우리들의 일그러진 영웅', domain:'ORGANIZATION', theme:'권위', concern:'power', href:'/guides/growth-leadership/literature/our-twisted-hero', live:true },
  { ep:'EP16', title:'모비 딕', domain:'LEADERSHIP', theme:'몰입', concern:'focus', href:'/guides/growth-leadership/literature/moby-dick', live:true },
  { ep:'EP17', title:'카라마조프가의 형제들', domain:'LEADERSHIP', theme:'윤리', concern:'ethics', href:'/guides/growth-leadership/literature/brothers-karamazov', live:true },
  { ep:'EP18', title:'페스트', domain:'LEADERSHIP', theme:'위기', concern:'crisis', href:'/guides/growth-leadership/literature/the-plague', live:true },
  { ep:'EP19', title:'인간의 조건', domain:'SELF', theme:'의미', concern:'meaning', href:'/guides/growth-leadership/literature/human-condition', live:true },
  { ep:'EP20', title:'리어 왕', domain:'LEADERSHIP', theme:'승계', concern:'succession', href:'/guides/growth-leadership/literature/king-lear', live:true }
];

const domains = [
  ['ALL','전체'],
  ['SELF','SELF · 나의 판단'],
  ['PEOPLE','PEOPLE · 관계'],
  ['ORGANIZATION','ORGANIZATION · 조직'],
  ['LEADERSHIP','LEADERSHIP · 리더의 선택']
];

const diagnostics = [
  ['performance','성과가 떨어진 사람을 어떻게 봐야 할까?'],
  ['fairness','공정하게 평가하고 있는지 확신이 없다'],
  ['power','권위와 규칙이 왜곡되는 것이 걱정된다'],
  ['safety','팀이 불편한 사실을 말하지 않는다'],
  ['decision','결정을 계속 미루고 있다'],
  ['conflict','규정과 원칙이 충돌한다'],
  ['trust','소문과 사실을 구분하기 어렵다'],
  ['change','변화에 대한 저항이 크다'],
  ['system','몇 명의 헌신에 운영이 의존한다'],
  ['accountability','실패 이후 책임과 학습을 설계하고 싶다']
];

const collectionSchema = {
  '@context':'https://schema.org',
  '@type':'CollectionPage',
  name:'JoyLab Literature Leadership Framework V2',
  description:'20개의 문학 작품을 SELF, PEOPLE, ORGANIZATION, LEADERSHIP 네 영역으로 연결한 JoyLab 진단형 리더십 맵.',
  url:'https://aijoylab.kr/guides/growth-leadership/literature/framework'
};
---

<BaseLayout
  title="Literature Leadership Framework V2｜20개의 문학으로 보는 리더십 지도 | JoyLab"
  description="현재 고민을 선택하면 관련 문학 리더십 Research로 연결되는 JoyLab 진단형 Leadership Map입니다."
  canonical="https://aijoylab.kr/guides/growth-leadership/literature/framework"
  bodyClass="growth-leadership-guide-v2 literature-framework-page"
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <main class="lf-wrap">
    <nav class="le-breadcrumb" aria-label="Breadcrumb">
      <a href="/">JoyLab</a><span>›</span>
      <a href="/guides/growth-leadership">성장·리더십</a><span>›</span>
      <a href="/guides/growth-leadership/literature">문학에서 배우는 리더십</a>
    </nav>

    <header class="lf-hero">
      <div class="sg-eyebrow">LITERATURE LEADERSHIP FRAMEWORK · V2</div>
      <h1>지금 당신의 문제는<br /><span>어디에서 시작되는가</span></h1>
      <p>20개의 작품을 순서대로 읽는 대신, 현재 리더십 고민에서 시작해 필요한 Research로 이동할 수 있습니다.</p>
      <div class="lf-status"><b>LIVE 20</b><span>EP01–EP20</span><b>COMPLETE</b><span>SEASON 1 + 2</span></div>
    </header>


    <section class="lf-assessment" aria-labelledby="assessment-title">
      <div class="sg-eyebrow">5-QUESTION LEADERSHIP DIAGNOSIS</div>
      <h2 id="assessment-title">5개 질문으로 지금 읽을 EP 3개를 찾습니다.</h2>
      <p class="lf-assessment__lead">가장 가까운 답을 하나씩 선택하면 현재 리더십 고민과 연결된 Research 3개를 추천합니다. 점수는 브라우저에서만 계산하며 저장하지 않습니다.</p>

      <form data-assessment>
        <fieldset>
          <legend>1. 지금 가장 먼저 풀고 싶은 문제는 무엇인가요?</legend>
          <label><input type="radio" name="q1" value="performance" required /> 성과가 떨어진 사람을 어떻게 볼지 어렵다</label>
          <label><input type="radio" name="q1" value="decision" /> 결정을 계속 미루고 있다</label>
          <label><input type="radio" name="q1" value="power" /> 권위와 규칙이 왜곡되는 것이 걱정된다</label>
          <label><input type="radio" name="q1" value="system" /> 몇 명의 헌신에 운영이 의존한다</label>
        </fieldset>

        <fieldset>
          <legend>2. 팀에서 가장 불편한 신호는 무엇인가요?</legend>
          <label><input type="radio" name="q2" value="safety" required /> 불편한 사실을 잘 말하지 않는다</label>
          <label><input type="radio" name="q2" value="trust" /> 소문과 사실이 뒤섞인다</label>
          <label><input type="radio" name="q2" value="fairness" /> 같은 기준인데도 공정하지 않다는 말이 나온다</label>
          <label><input type="radio" name="q2" value="conflict" /> 규정과 원칙이 자주 충돌한다</label>
        </fieldset>

        <fieldset>
          <legend>3. 리더 자신의 판단에서 가장 점검하고 싶은 것은 무엇인가요?</legend>
          <label><input type="radio" name="q3" value="judgment" required /> 사람을 행동보다 먼저 판단하는 편이다</label>
          <label><input type="radio" name="q3" value="focus" /> 목표를 끝까지 밀어붙이는 편이다</label>
          <label><input type="radio" name="q3" value="decision" /> 정보가 더 필요하다는 이유로 기다리는 편이다</label>
          <label><input type="radio" name="q3" value="ethics" /> 자율성과 책임의 경계가 모호하다</label>
        </fieldset>

        <fieldset>
          <legend>4. 조직 운영에서 가장 강화하고 싶은 것은 무엇인가요?</legend>
          <label><input type="radio" name="q4" value="accountability" required /> 실패 이후 책임과 학습</label>
          <label><input type="radio" name="q4" value="change" /> 변화와 전환의 실행력</label>
          <label><input type="radio" name="q4" value="system" /> 반복 가능한 시스템</label>
          <label><input type="radio" name="q4" value="power" /> 건강한 권위와 반대 의견</label>
        </fieldset>

        <fieldset>
          <legend>5. 다음 코칭에서 가장 먼저 던지고 싶은 질문은 무엇인가요?</legend>
          <label><input type="radio" name="q5" value="growth" required /> “다음에는 무엇을 다르게 해볼 수 있을까?”</label>
          <label><input type="radio" name="q5" value="fairness" /> “같은 기준을 누구에게나 적용하고 있는가?”</label>
          <label><input type="radio" name="q5" value="trust" /> “이 정보는 사실인가, 해석인가?”</label>
          <label><input type="radio" name="q5" value="change" /> “새 행동을 배울 조건이 준비됐는가?”</label>
        </fieldset>

        <button class="lf-assessment__submit" type="submit">추천 EP 3개 보기 →</button>
      </form>

      <div class="lf-assessment__result" data-assessment-result hidden aria-live="polite">
        <small>YOUR RECOMMENDED RESEARCH</small>
        <h3>지금은 이 3편부터 읽어보세요.</h3>
        <div class="lf-profile" data-profile hidden>
          <span data-profile-kicker></span>
          <h4 data-profile-title></h4>
          <p data-profile-body></p>
        </div>
        <div class="lf-assessment__cards" data-assessment-cards></div>
        <button type="button" class="lf-reset" data-assessment-reset>다시 진단하기</button>
      </div>
    </section>

    <section class="lf-diagnostic" aria-labelledby="diagnostic-title">
      <div class="sg-eyebrow">QUICK DIAGNOSIS</div>
      <h2 id="diagnostic-title">지금 가장 가까운 고민을 선택하세요.</h2>
      <div class="lf-diagnostic__grid">
        {diagnostics.map(([key,label]) => (
          <button type="button" class="lf-diagnostic__button" data-concern-filter={key}>{label}</button>
        ))}
      </div>
      <button type="button" class="lf-reset" data-reset>전체 지도 보기</button>
    </section>

    <section class="lf-map" aria-labelledby="framework-title">
      <div class="lf-map__head">
        <div>
          <div class="sg-eyebrow">20 EPISODES · 4 DOMAINS</div>
          <h2 id="framework-title">Leadership Map</h2>
        </div>
        <div class="lf-domain-tabs" role="group" aria-label="리더십 영역 필터">
          {domains.map(([key,label]) => <button type="button" data-domain-filter={key}>{label}</button>)}
        </div>
      </div>

      <p class="lf-result" aria-live="polite">전체 20개 Episode를 표시합니다.</p>

      <div class="lf-grid">
        {nodes.map((node) => node.live ? (
          <a
            class="lf-node"
            data-node
            data-domain={node.domain}
            data-concern={node.concern}
            href={node.href}
          >
            <div><span>{node.ep}</span><small>{node.domain}</small></div>
            <h3>{node.title}</h3>
            <p>{node.theme}</p>
            <b>READ →</b>
          </a>
        ) : (
          <article
            class="lf-node is-planned"
            data-node
            data-domain={node.domain}
            data-concern={node.concern}
            aria-disabled="true"
          >
            <div><span>{node.ep}</span><small>{node.domain}</small></div>
            <h3>{node.title}</h3>
            <p>{node.theme}</p>
            <b>PLANNED</b>
          </article>
        ))}
      </div>
    </section>

    <section class="lf-principle">
      <div class="sg-eyebrow">JOYLAB LEADERSHIP OS</div>
      <h2>문학을 읽는 목적은 정답을 찾는 것이 아니라 판단 기준을 축적하는 것입니다.</h2>
      <div class="lf-principle__grid">
        <article><b>SELF</b><p>성과 · 성장 · 판단 · 의미</p></article>
        <article><b>PEOPLE</b><p>관계 · 존엄 · 공정성 · 신뢰</p></article>
        <article><b>ORGANIZATION</b><p>권력 · 심리적 안전 · 시스템 · 책임 · 권위</p></article>
        <article><b>LEADERSHIP</b><p>의사결정 · 갈등 · 변화 · 몰입 · 윤리 · 위기 · 승계</p></article>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const nodes = Array.from(document.querySelectorAll('[data-node]'));
      const result = document.querySelector('.lf-result');
      const domainButtons = Array.from(document.querySelectorAll('[data-domain-filter]'));
      const concernButtons = Array.from(document.querySelectorAll('[data-concern-filter]'));
      const reset = document.querySelector('[data-reset]');

      const apply = ({ domain = 'ALL', concern = '' } = {}) => {
        let visible = 0;
        nodes.forEach((node) => {
          const domainOk = domain === 'ALL' || node.dataset.domain === domain;
          const concernOk = !concern || node.dataset.concern === concern;
          const show = domainOk && concernOk;
          node.hidden = !show;
          if (show) visible += 1;
        });
        domainButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.domainFilter === domain)));
        concernButtons.forEach((button) => button.setAttribute('aria-pressed', String(Boolean(concern) && button.dataset.concernFilter === concern)));
        if (result) result.textContent = concern
          ? `현재 고민과 연결된 ${visible}개 Episode입니다.`
          : domain === 'ALL'
            ? '전체 20개 Episode를 표시합니다.'
            : `${domain} 영역의 ${visible}개 Episode입니다.`;
      };

      domainButtons.forEach((button) => button.addEventListener('click', () => apply({ domain: button.dataset.domainFilter })));
      concernButtons.forEach((button) => button.addEventListener('click', () => apply({ concern: button.dataset.concernFilter })));
      reset?.addEventListener('click', () => apply());
      apply();
    })();
  </script>


  <script is:inline>
    (() => {
      const form = document.querySelector('[data-assessment]');
      const result = document.querySelector('[data-assessment-result]');
      const cards = document.querySelector('[data-assessment-cards]');
      const profileBox = document.querySelector('[data-profile]');
      const profileKicker = document.querySelector('[data-profile-kicker]');
      const profileTitle = document.querySelector('[data-profile-title]');
      const profileBody = document.querySelector('[data-profile-body]');
      const reset = document.querySelector('[data-assessment-reset]');
      if (!form || !result || !cards) return;

      const catalog = {
        performance:{ep:'EP01',title:'노인과 바다',theme:'성과 · GRIT',href:'/guides/growth-leadership/literature/old-man-and-the-sea'},
        growth:{ep:'EP03',title:'데미안',theme:'성장 · 자기결정',href:'/guides/growth-leadership/literature/demian'},
        fairness:{ep:'EP08',title:'레미제라블',theme:'공정성 · 기회',href:'/guides/growth-leadership/literature/les-miserables'},
        power:{ep:'EP15',title:'우리들의 일그러진 영웅',theme:'권위 · 복종',href:'/guides/growth-leadership/literature/our-twisted-hero'},
        safety:{ep:'EP06',title:'1984',theme:'심리적 안전 · 정보',href:'/guides/growth-leadership/literature/1984'},
        judgment:{ep:'EP07',title:'이방인',theme:'판단 · 편견',href:'/guides/growth-leadership/literature/the-stranger'},
        system:{ep:'EP09',title:'파리대왕',theme:'시스템 · 규칙',href:'/guides/growth-leadership/literature/lord-of-the-flies'},
        accountability:{ep:'EP10',title:'죄와 벌',theme:'책임 · 회복',href:'/guides/growth-leadership/literature/crime-and-punishment'},
        decision:{ep:'EP11',title:'햄릿',theme:'의사결정 · 지연',href:'/guides/growth-leadership/literature/hamlet'},
        conflict:{ep:'EP12',title:'안티고네',theme:'갈등 · 원칙',href:'/guides/growth-leadership/literature/antigone'},
        trust:{ep:'EP13',title:'오셀로',theme:'신뢰 · 정보오염',href:'/guides/growth-leadership/literature/othello'},
        change:{ep:'EP14',title:'갈매기의 꿈',theme:'변화 · 성장',href:'/guides/growth-leadership/literature/jonathan-livingston-seagull'},
        focus:{ep:'EP16',title:'모비 딕',theme:'몰입 · 집착',href:'/guides/growth-leadership/literature/moby-dick'},
        ethics:{ep:'EP17',title:'카라마조프가의 형제들',theme:'윤리 · 책임',href:'/guides/growth-leadership/literature/brothers-karamazov'}
      };

      const fallback = ['decision','fairness','system'];

      const profiles = {
        performance:{label:'성과형',title:'성과를 정확히 보고 성장으로 연결하는 리더',body:'성과 기준, 성장 가능성, 피드백과 회복을 함께 설계하는 경향이 강합니다.'},
        relationship:{label:'관계형',title:'신뢰와 공정성을 통해 사람을 움직이는 리더',body:'관계, 심리적 안전, 공정성, 신뢰의 질을 우선 점검하는 경향이 강합니다.'},
        organization:{label:'조직형',title:'규칙과 시스템으로 반복 가능성을 만드는 리더',body:'권력, 시스템, 책임, 운영 구조와 재발 방지에 초점을 두는 경향이 강합니다.'},
        judgment:{label:'판단형',title:'불확실성 속에서 기준을 만들고 결정하는 리더',body:'의사결정, 갈등, 정보 검증, 변화와 윤리적 판단에 강한 관심을 보입니다.'}
      };

      const profileWeights = {
        performance:'performance', growth:'performance', change:'performance',
        fairness:'relationship', safety:'relationship', trust:'relationship',
        power:'organization', system:'organization', accountability:'organization',
        decision:'judgment', conflict:'judgment', judgment:'judgment', focus:'judgment', ethics:'judgment'
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const values = Array.from(new FormData(form).values());
        const questionWeights = [5, 4, 4, 5, 4];
        const tiePriority = {
          decision: 14, conflict: 13, trust: 12, change: 11, power: 10,
          system: 9, accountability: 8, fairness: 7, safety: 6, judgment: 5,
          focus: 4, ethics: 3, performance: 2, growth: 1
        };
        const scores = {};
        values.forEach((key, index) => {
          scores[key] = (scores[key] || 0) + questionWeights[index];
        });
        const ordered = Object.keys(scores).sort((a,b) =>
          (scores[b] - scores[a]) || ((tiePriority[b] || 0) - (tiePriority[a] || 0))
        );
        fallback.forEach((key) => { if (!ordered.includes(key)) ordered.push(key); });
        const picks = ordered.filter((key) => catalog[key]).slice(0,3);

        const profileScores = {};
        values.forEach((key) => {
          const group = profileWeights[key] || 'judgment';
          profileScores[group] = (profileScores[group] || 0) + 1;
        });
        const profileKey = Object.keys(profileScores).sort((a,b) => profileScores[b] - profileScores[a])[0] || 'judgment';
        const profile = profiles[profileKey];
        if (profileBox && profileKicker && profileTitle && profileBody) {
          profileKicker.textContent = `LEADERSHIP PROFILE · ${profile.label}`;
          profileTitle.textContent = profile.title;
          profileBody.textContent = profile.body;
          profileBox.hidden = false;
        }

        cards.innerHTML = picks.map((key, index) => {
          const item = catalog[key];
          return `<a class="lf-assessment__card" href="${item.href}">
            <span>#${index + 1} · ${item.ep}</span>
            <h4>${item.title}</h4>
            <p>${item.theme}</p>
            <b>READ RESEARCH →</b>
          </a>`;
        }).join('');

        result.hidden = false;
        result.scrollIntoView({behavior:'smooth',block:'center'});
      });

      reset?.addEventListener('click', () => {
        form.reset();
        cards.innerHTML = '';
        result.hidden = true;
        if (profileBox) profileBox.hidden = true;
        form.scrollIntoView({behavior:'smooth',block:'start'});
      });
    })();
  </script>

