---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/semiconductor-guide-v2.css';
import '../../../../styles/growth-leadership-guide-v2.css';

const episodes = [
  { ep: 'EP01', title: '노인과 바다', theme: '성과 · GRIT', question: '성과가 무너졌을 때 무엇을 볼 것인가', href: '/guides/growth-leadership/literature/old-man-and-the-sea', live: true },
  { ep: 'EP02', title: '어린 왕자', theme: '관계 · 책임', question: '관계를 만든다는 것은 무엇을 책임지는가', href: '/guides/growth-leadership/literature/little-prince', live: true },
  { ep: 'EP03', title: '데미안', theme: '성장 · 자기결정', question: '리더는 답을 줘야 하는가, 찾게 해야 하는가', href: '/guides/growth-leadership/literature/demian', live: true },
  { ep: 'EP04', title: '변신', theme: '성과 · 존엄', question: '쓸모를 잃으면 사람의 가치도 사라지는가', href: '/guides/growth-leadership/literature/metamorphosis', live: true },
  { ep: 'EP05', title: '동물농장', theme: '권력 · 조직문화', question: '좋은 규칙은 왜 변질되는가', href: '/guides/growth-leadership/literature/animal-farm', live: true },
  { ep: 'EP06', title: '1984', theme: '심리적 안전 · 정보', question: '사람들이 진실을 말하지 않을 때', href: '/guides/growth-leadership/literature/1984', live: true },
  { ep: 'EP07', title: '이방인', theme: '판단 · 편견', question: '우리는 행동보다 사람을 판단한다', href: '/guides/growth-leadership/literature/the-stranger', live: true },
  { ep: 'EP08', title: '레미제라블', theme: '공정성 · 기회', question: '똑같이 대하는 것이 공정할까', href: '/guides/growth-leadership/literature/les-miserables', live: true },
  { ep: 'EP09', title: '파리대왕', theme: '집단행동 · 규칙', question: '좋은 조직은 선의만으로 유지되지 않는다', href: '/guides/growth-leadership/literature/lord-of-the-flies', live: true },
  { ep: 'EP10', title: '죄와 벌', theme: '책임 · 회복', question: '책임은 어디에서 끝나는가', href: '/guides/growth-leadership/literature/crime-and-punishment', live: true },
  { ep: 'EP11', title: '햄릿', theme: '의사결정 · 지연', question: '언제 결정해야 하는가', href: '/guides/growth-leadership/literature/hamlet', live: true },
  { ep: 'EP12', title: '안티고네', theme: '갈등 · 원칙', question: '규정과 양심이 충돌할 때', href: '/guides/growth-leadership/literature/antigone', live: true },
  { ep: 'EP13', title: '오셀로', theme: '신뢰 · 정보오염', question: '사실과 소문을 어떻게 구분할까', href: '/guides/growth-leadership/literature/othello', live: true },
  { ep: 'EP14', title: '갈매기의 꿈', theme: '변화 · 성장', question: '익숙함을 떠나는 비용', href: '/guides/growth-leadership/literature/jonathan-livingston-seagull', live: true },
  { ep: 'EP15', title: '우리들의 일그러진 영웅', theme: '권위 · 복종', question: '권위는 언제 지배로 변하는가', live: false },
  { ep: 'EP16', title: '모비 딕', theme: '몰입 · 집착', question: '목표 집중은 언제 집착이 되는가', live: false },
  { ep: 'EP17', title: '카라마조프가의 형제들', theme: '윤리 · 책임', question: '자유가 커질수록 책임은 어떻게 달라지는가', live: false },
  { ep: 'EP18', title: '페스트', theme: '불확실성 · 위기', question: '답이 없는 위기에서 무엇을 제공할까', live: false },
  { ep: 'EP19', title: '인간의 조건', theme: '회복탄력성 · 의미', question: '버티게 하는 힘은 무엇인가', live: false },
  { ep: 'EP20', title: '리어 왕', theme: '권력승계 · 판단', question: '권한을 내려놓을 때 무엇을 남길까', live: false }
];
---

<BaseLayout
  title="문학에서 배우는 리더십｜고전에서 찾는 사람·성과·조직의 원리 | JoyLab"
  description="『노인과 바다』를 시작으로 고전 문학 속 인간 행동을 성과관리, GRIT, 공정성, 조직문화와 실제 리더 행동으로 번역하는 JoyLab 리더십 시리즈입니다."
  canonical="https://aijoylab.kr/guides/growth-leadership/literature"
  bodyClass="growth-leadership-guide-v2 literature-leadership-page"
>
  <section class="ll-hero">
    <div class="sg-wrap">
      <div class="sg-eyebrow">LITERATURE & LEADERSHIP · JOYLAB</div>
      <h1>문학에서 배우는<br /><span>리더십</span></h1>
      <p class="ll-hero__lead">성과, 관계, 권력, 책임, 성장. 좋은 문학은 결국 사람을 이해하는 이야기입니다. JoyLab은 작품 속 인간 행동을 조직의 문제와 실제 리더의 행동으로 번역합니다.</p>
      <div class="ll-hero__actions">
        <a class="ll-btn ll-btn--primary" href="/guides/growth-leadership/literature/old-man-and-the-sea">EP01 읽기 →</a>
        <a class="ll-btn" href="/guides/growth-leadership/literature/framework">Leadership Map V2 →</a>
        <a class="ll-btn" href="/guides/growth-leadership/playbook/performance-coaching">Leader Playbook →</a>
      </div>
    </div>
  </section>

  <main class="ll-main">
    <section class="ll-thesis">
      <div class="sg-wrap">
        <div class="sg-eyebrow">CORE THESIS</div>
        <h2>성과는 평가하되,<br />사람을 성과로 규정하지 않는다.</h2>
        <div class="ll-thesis__grid">
          <article><b>PEOPLE</b><p>동기 · 성장 · 실패 · 회복 · 가능성</p></article>
          <article><b>RELATIONSHIP</b><p>신뢰 · 책임 · 공감 · 갈등 · 영향력</p></article>
          <article><b>ORGANIZATION</b><p>권력 · 공정성 · 문화 · 규칙 · 심리적 안전</p></article>
        </div>
      </div>
    </section>

    <section class="ll-featured sg-wrap">
      <div class="sg-eyebrow">FEATURED RESEARCH · EP01</div>
      <div class="ll-featured__grid">
        <div>
          <small>ERNEST HEMINGWAY · 노인과 바다</small>
          <h2>성과가 무너졌을 때 사람이 보인다</h2>
          <p>산티아고는 84일 동안 성과를 내지 못했습니다. 그러나 결과가 없었다고 그의 경험과 태도, 다시 시도할 가능성까지 사라진 것은 아닙니다.</p>
          <blockquote>성과를 무시하면 조직이 무너지고, 성과만 보면 사람을 잃는다.</blockquote>
          <a href="/guides/growth-leadership/literature/old-man-and-the-sea">EP01 Research 읽기 →</a>
        </div>
        <div class="ll-featured__visual">
          <span>EP01</span>
          <strong>성과 · GRIT</strong>
          <small>THE OLD MAN AND THE SEA</small>
        </div>
      </div>
    </section>

    <section class="ll-method">
      <div class="sg-wrap">
        <div class="sg-eyebrow">THE JOYLAB METHOD</div>
        <h2>문학을 읽고, 조직의 언어로 번역합니다.</h2>
        <div class="ll-method__grid">
          <article><span>01</span><b>SCENE</b><p>문학 속 결정적 장면</p></article>
          <article><span>02</span><b>INSIGHT</b><p>인간 행동에 대한 해석</p></article>
          <article><span>03</span><b>QUESTION</b><p>리더가 스스로 던질 질문</p></article>
          <article><span>04</span><b>ACTION</b><p>현장에서 바꿀 행동</p></article>
        </div>
      </div>
    </section>

    <section class="ll-series sg-wrap" id="series-map">
      <div class="sg-eyebrow">20 EPISODES · SEASON 1 + 2</div>
      <h2>문학에서 배우는 리더십</h2>
      <p><a href="/guides/growth-leadership/literature/framework">현재 고민으로 찾는 Leadership Framework V2 →</a></p>
      <div class="ll-series__grid">
        {episodes.map((item) => item.live ? (
          <a class="ll-episode" id={item.ep.toLowerCase()} href={item.href}>
            <div><span>{item.ep}</span><small>{item.theme}</small></div>
            <h3>{item.title}</h3>
            <p>{item.question}</p>
            <b>READ RESEARCH →</b>
          </a>
        ) : (
          <article class="ll-episode is-upcoming" id={item.ep.toLowerCase()}>
            <div><span>{item.ep}</span><small>{item.theme}</small></div>
            <h3>{item.title}</h3>
            <p>{item.question}</p>
            <b>COMING NEXT</b>
          </article>
        ))}
      </div>
    </section>

    <section class="ll-playbook">
      <div class="sg-wrap ll-playbook__grid">
        <div>
          <div class="sg-eyebrow">LEADER PLAYBOOK</div>
          <h2>읽은 통찰을 현장의 질문으로 바꿉니다.</h2>
        </div>
        <div>
          <p>이번 결과에서 본인이 바꿀 수 있었던 것은 무엇입니까?</p>
          <p>현재 장애물은 의지·역량·방법·환경 중 어디에 있습니까?</p>
          <p>다음 한 번의 행동에서 무엇을 바꾸겠습니까?</p>
          <a href="/guides/growth-leadership/playbook/performance-coaching">성과부진 코칭 Playbook →</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
