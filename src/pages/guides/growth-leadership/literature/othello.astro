---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/semiconductor-guide-v2.css';
import '../../../../styles/growth-leadership-guide-v2.css';

const faq = [
  [
    "소문도 참고 정보로 볼 수 있지 않나요?",
    "초기 신호로는 참고할 수 있지만 평가나 조치의 근거가 되려면 독립된 사실 확인이 필요합니다."
  ],
  [
    "여러 사람이 같은 말을 하면 사실 아닌가요?",
    "같은 원천에서 퍼진 정보일 수 있으므로 사람 수보다 출처의 독립성과 증거를 확인해야 합니다."
  ],
  [
    "당사자 확인은 언제 해야 하나요?",
    "긴급한 안전 문제가 아니라면 중대한 판단 전에 당사자에게 사실을 확인할 기회를 주는 것이 기본입니다."
  ]
];
const takeaways = [
  [
    "01",
    "소문과 증거를 분리한다",
    "반복 횟수는 사실성을 보장하지 않습니다."
  ],
  [
    "02",
    "출처의 독립성을 확인한다",
    "여러 사람이 말해도 같은 원천이면 정보는 하나일 수 있습니다."
  ],
  [
    "03",
    "확증편향을 의심한다",
    "이미 가진 판단과 일치하는 정보일수록 더 엄격하게 검증해야 합니다."
  ],
  [
    "04",
    "당사자 확인 절차를 둔다",
    "중대한 판단에는 반론과 설명의 기회가 필요합니다."
  ],
  [
    "05",
    "신뢰는 검증 절차에서 보호된다",
    "호감이나 불신이 아니라 같은 절차를 적용해야 합니다."
  ]
];
const coachingQuestions = [
  "이 정보의 최초 출처는 누구인가요?",
  "직접 본 사실과 전해 들은 이야기를 구분했나요?",
  "독립된 두 번째 근거가 있나요?",
  "이미 가진 인상과 일치해서 쉽게 믿고 있지 않나요?",
  "반대 증거를 찾아봤나요?",
  "당사자의 설명을 들었나요?",
  "사실 확인 전에 평가 언어를 사용하고 있지 않나요?",
  "여러 증언이 같은 출처에서 나온 것은 아닌가요?",
  "정보 전달 과정에서 내용이 바뀌지 않았나요?",
  "지금 조치가 필요한 긴급 위험인가요?",
  "판단 근거를 기록할 수 있나요?",
  "나는 사실을 확인하는가, 의심을 확증하는가?"
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: "리더는 사실과 소문을 어떻게 구분해야 하는가",
  alternativeHeadline: "『오셀로』에서 배우는 신뢰와 정보오염의 리더십",
  description: "셰익스피어 『오셀로』를 소문, 확증편향, 신뢰 붕괴와 정보 검증 관점에서 분석한 JoyLab Literature & Leadership Research.",
  mainEntityOfPage: "https://aijoylab.kr/guides/growth-leadership/literature/othello",
  author: { '@type':'Organization', name:'JoyLab', url:'https://aijoylab.kr' },
  publisher: { '@type':'Organization', name:'JoyLab', url:'https://aijoylab.kr' },
  about: ["Leadership","Trust","Rumor","Confirmation Bias","Othello"]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q,a]) => ({
    '@type':'Question', name:q,
    acceptedAnswer:{ '@type':'Answer', text:a }
  }))
};

const breadcrumbSchema = {
  '@context':'https://schema.org',
  '@type':'BreadcrumbList',
  itemListElement:[
    { '@type':'ListItem', position:1, name:'JoyLab', item:'https://aijoylab.kr/' },
    { '@type':'ListItem', position:2, name:'성장·리더십', item:'https://aijoylab.kr/guides/growth-leadership' },
    { '@type':'ListItem', position:3, name:'문학에서 배우는 리더십', item:'https://aijoylab.kr/guides/growth-leadership/literature' },
    { '@type':'ListItem', position:4, name:"오셀로", item:"https://aijoylab.kr/guides/growth-leadership/literature/othello" }
  ]
};
---

<BaseLayout
  title="오셀로 리더십｜리더는 사실과 소문을 어떻게 구분해야 하는가 | JoyLab"
  description="셰익스피어 『오셀로』를 통해 소문, 확증편향, 신뢰 붕괴와 사실 검증의 리더십 원칙을 살펴봅니다."
  canonical="https://aijoylab.kr/guides/growth-leadership/literature/othello"
  type="article"
  bodyClass="growth-leadership-guide-v2 literature-essay-page literature-research-page"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <main class="le-wrap">
    <nav class="le-breadcrumb" aria-label="Breadcrumb">
      <a href="/">JoyLab</a><span>›</span>
      <a href="/guides/growth-leadership">성장·리더십</a><span>›</span>
      <a href="/guides/growth-leadership/literature">문학에서 배우는 리더십</a>
    </nav>

    <header class="le-hero">
      <div class="sg-eyebrow">LITERATURE & LEADERSHIP RESEARCH · EP13</div>
      <h1>리더는 사실과 소문을<br /><span>어떻게 구분해야 하는가</span></h1>
      <p class="le-subtitle">『오셀로』에서 배우는 신뢰와 정보오염</p>
      <p class="le-intro">정보는 많을수록 안전해지는 것이 아닙니다. 출처가 불분명한 정보와 이미 가진 의심이 결합하면 리더는 사실보다 이야기를 믿기 시작합니다. 『오셀로』는 정보오염이 신뢰를 무너뜨리는 과정을 극단적으로 보여줍니다.</p>
      <div class="le-meta"><span>Trust</span><span>Rumor</span><span>Bias</span><span>Verification</span></div>
    </header>

    <section class="le-visual le-visual--ep13" aria-label="오셀로 신뢰와 정보오염 비주얼">
      <div><span>EP13</span><b>TRUST × EVIDENCE</b></div>
      <i aria-hidden="true"></i>
    </section>

    <article class="le-body">
      <section class="le-research-brief">
        <div class="sg-eyebrow">RESEARCH BRIEF</div>
        <h2>의심이 먼저 생기면 정보는 사실 확인보다 확증의 재료가 되기 쉽다.</h2>
        <p>오셀로는 반복되는 암시와 조작된 단서를 통해 의심을 확신으로 바꿉니다. 문제는 정보의 양보다 검증되지 않은 정보가 기존 감정과 결합하는 방식입니다.</p>
        <p>조직에서도 “다들 그렇게 말한다”, “원래 그런 사람이다”, “이번에도 분명하다”는 문장이 근거처럼 사용되면 평가는 빠르게 편향될 수 있습니다.</p>
        <blockquote>소문은 정보가 아니다.<br />검증되지 않은 확신은 더 위험한 정보다.</blockquote>
        <div class="le-diagnosis">
          <article><b>SOURCE</b><span>누가 말했는가</span></article>
          <article><b>EVIDENCE</b><span>무엇으로 확인했는가</span></article>
          <article><b>BIAS</b><span>무엇을 믿고 싶은가</span></article>
          <article><b>VERIFY</b><span>당사자와 확인했는가</span></article>
        </div>
      </section>

      <section class="le-key-takeaways">
        <div class="sg-eyebrow">KEY TAKEAWAYS</div>
        <h2>『오셀로』이 리더에게 남기는 5가지 원칙</h2>
        <div class="le-takeaway-list">
          {takeaways.map(([no,title,body]) => (
            <article><div class="le-takeaway-list__no">{no}</div><div><h3>{title}</h3><p>{body}</p></div></article>
          ))}
        </div>
      </section>

      <section>
        <div class="sg-eyebrow">DEEP DIVE · RUMOR</div>
        <h2>“다들 그렇게 말한다”는 증거가 아니다</h2>
        <p>조직의 소문은 전달 과정에서 단순화되고 감정이 섞입니다. 반복적으로 들렸다는 이유만으로 독립적인 증거라고 취급하면 잘못된 확신이 커질 수 있습니다.</p>
        <div class="le-callout"><b>JOYLAB INTERPRETATION</b><p>정보의 신뢰도는 몇 명이 말했는지가 아니라 출처가 독립적이고 검증 가능한지에 달려 있다.</p></div>
      </section>

      <section>
        <div class="sg-eyebrow">DEEP DIVE · BIAS</div>
        <h2>내가 믿고 싶은 정보일수록 더 강하게 검증한다</h2>
        <p>기존 인상과 일치하는 정보는 검증 비용을 낮추는 경향이 있습니다. 그래서 리더는 반대 증거와 당사자 설명을 의도적으로 확인해야 합니다.</p>
        <div class="le-control">
          <article><small>CHECK FIRST</small><h3>판단 전에</h3><p>출처, 직접 사실, 독립 증거와 반대 증거를 확인합니다.</p></article>
          <article><small>CHECK NEXT</small><h3>조치 전에</h3><p>당사자 설명, 기록, 절차적 공정성과 조치 수준을 확인합니다.</p></article>
        </div>
        <blockquote class="is-dark">신뢰는 사람을 무조건 믿는 데서 생기지 않는다.<br />같은 검증 절차를 누구에게나 적용할 때 생긴다.</blockquote>
      </section>

      <section>
        <div class="sg-eyebrow">COACHING QUESTIONS</div>
        <h2>정보오염을 막는 12개 리더 질문</h2>
        <p>출처 → 증거 → 편향 → 당사자 확인 순으로 사용합니다.</p>
        <ol class="le-question-list">
          {coachingQuestions.map((q)=><li>{q}</li>)}
        </ol>
        <div class="le-gold-question">
          <small>GOLD QUESTION</small>
          <p>리더는 사실과 소문을 어떻게 구분해야 하는가?</p>
        </div>
      </section>

      <section class="le-action">
        <div class="sg-eyebrow">LEADERSHIP ACTION</div>
        <h2>중요한 사람 평가에서 “소문·관찰·증거”를 세 칸으로 분리한다.</h2>
        <div class="le-action-grid">
          <article><b>01 · SOURCE</b><p>정보의 최초 출처를 확인합니다.</p></article>
          <article><b>02 · EVIDENCE</b><p>직접 사실과 객관 자료를 분리합니다.</p></article>
          <article><b>03 · COUNTER</b><p>반대 증거를 의도적으로 찾습니다.</p></article>
          <article><b>04 · HEAR</b><p>중대한 판단 전에 당사자 설명을 듣습니다.</p></article>
        </div>
        <a href="/guides/growth-leadership/literature/framework">Leadership Framework V2 →</a>
      </section>

      <section class="le-conclusion">
        <div class="sg-eyebrow">JOYLAB CONCLUSION</div>
        <p>신뢰는 순진함이 아닙니다.</p>
        <h2>사람을 믿기 전에<br />정보를 검증하는 구조를 믿어야 한다.</h2>
        <p>검증 절차가 공정할수록 소문은 판단을 지배하기 어려워집니다.</p>
      </section>
    </article>

    <section class="le-faq">
      <div class="sg-eyebrow">FAQ</div>
      <h2>『오셀로』과 신뢰와 정보오염</h2>
      {faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}
    </section>

    <section class="le-next">
      <div>
        <small>NEXT · EP14</small>
        <h2>『갈매기의 꿈』 — 익숙함을 떠나는 비용을 조직은 어떻게 다루는가</h2>
        <p>다음 Research에서는 변화와 성장, 학습 과정에서 나타나는 저항을 의지 부족이 아니라 전환 비용의 관점에서 살펴봅니다.</p>
      </div>
      <a href="/guides/growth-leadership/literature/jonathan-livingston-seagull">EP14 읽기 →</a>
    </section>

    <footer class="le-back">
      <a href="/guides/growth-leadership/literature/antigone">← EP12 안티고네</a>
      <a href="/guides/growth-leadership/literature">전체 시리즈 →</a>
    </footer>
  </main>
</BaseLayout>
