---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/semiconductor-guide-v2.css';
import '../../../../styles/growth-leadership-guide-v2.css';

const faq = [
  [
    "규정은 예외 없이 지켜야 공정하지 않나요?",
    "일관성은 중요하지만 규정이 예상하지 못한 상황이 있을 수 있습니다. 예외는 근거, 승인, 기록이 있을 때 공정성을 해치지 않을 수 있습니다."
  ],
  [
    "원칙을 이유로 개인 판단을 허용하면 위험하지 않나요?",
    "맞습니다. 그래서 개인의 신념이 아니라 조직의 가치, 고객 영향, 법적·윤리적 기준과 설명 가능성을 함께 봐야 합니다."
  ],
  [
    "갈등 상황에서 리더가 먼저 할 일은 무엇인가요?",
    "누가 옳은지 판단하기 전에 충돌하는 가치가 무엇인지 분리해 이름 붙이는 것이 좋습니다."
  ]
];
const takeaways = [
  [
    "01",
    "갈등은 사람보다 가치의 충돌일 수 있다",
    "입장 뒤에 있는 원칙을 확인해야 해결 가능성이 높아집니다."
  ],
  [
    "02",
    "규정은 정당성의 전부가 아니다",
    "규정 준수와 고객·구성원에게 미치는 영향을 함께 봐야 합니다."
  ],
  [
    "03",
    "예외에는 기록이 필요하다",
    "좋은 예외는 근거와 승인, 종료 조건이 남습니다."
  ],
  [
    "04",
    "권위는 설명 가능성에서 강해진다",
    "결정 이유를 공개할 수 있을수록 정당성이 높아집니다."
  ],
  [
    "05",
    "갈등을 승패로 끝내지 않는다",
    "다음 유사 상황의 기준을 남겨야 조직이 학습합니다."
  ]
];
const coachingQuestions = [
  "지금 충돌하는 두 가치는 무엇인가요?",
  "공식 규정의 원래 목적은 무엇인가요?",
  "규정을 그대로 적용하면 누가 피해를 보나요?",
  "예외를 허용하면 어떤 선례가 생기나요?",
  "법적·윤리적 최소 기준은 무엇인가요?",
  "개인의 선호가 판단에 섞이지 않았나요?",
  "결정 근거를 팀 전체에 설명할 수 있나요?",
  "같은 상황에 같은 원칙을 적용할 수 있나요?",
  "반대 입장의 핵심 우려를 정확히 말할 수 있나요?",
  "제3의 대안은 없나요?",
  "결정 후 기준을 문서화할 수 있나요?",
  "나는 규정을 지키고 있는가, 규정 뒤에 숨고 있는가?"
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: "규정과 양심이 충돌할 때 무엇을 기준으로 판단하는가",
  alternativeHeadline: "『안티고네』에서 배우는 갈등과 원칙의 리더십",
  description: "소포클레스 『안티고네』를 규정, 양심, 정당성, 갈등 관리 관점에서 분석한 JoyLab Literature & Leadership Research.",
  mainEntityOfPage: "https://aijoylab.kr/guides/growth-leadership/literature/antigone",
  author: { '@type':'Organization', name:'JoyLab', url:'https://aijoylab.kr' },
  publisher: { '@type':'Organization', name:'JoyLab', url:'https://aijoylab.kr' },
  about: ["Leadership","Conflict","Principle","Legitimacy","Antigone"]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q,a]) => ({
    '@type':'Question', name:q,
    acceptedAnswer:{ '@type':'Answer', text:a }
  }))
};

const breadcrumbSchema = {
  '@context':'https://schema.org',
  '@type':'BreadcrumbList',
  itemListElement:[
    { '@type':'ListItem', position:1, name:'JoyLab', item:'https://aijoylab.kr/' },
    { '@type':'ListItem', position:2, name:'성장·리더십', item:'https://aijoylab.kr/guides/growth-leadership' },
    { '@type':'ListItem', position:3, name:'문학에서 배우는 리더십', item:'https://aijoylab.kr/guides/growth-leadership/literature' },
    { '@type':'ListItem', position:4, name:"안티고네", item:"https://aijoylab.kr/guides/growth-leadership/literature/antigone" }
  ]
};
---

<BaseLayout
  title="안티고네 리더십｜규정과 양심이 충돌할 때 무엇을 기준으로 판단하는가 | JoyLab"
  description="소포클레스 『안티고네』를 통해 규정과 원칙의 충돌, 정당성, 예외 판단과 갈등 관리의 기준을 살펴봅니다."
  canonical="https://aijoylab.kr/guides/growth-leadership/literature/antigone"
  type="article"
  bodyClass="growth-leadership-guide-v2 literature-essay-page literature-research-page"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <main class="le-wrap">
    <nav class="le-breadcrumb" aria-label="Breadcrumb">
      <a href="/">JoyLab</a><span>›</span>
      <a href="/guides/growth-leadership">성장·리더십</a><span>›</span>
      <a href="/guides/growth-leadership/literature">문학에서 배우는 리더십</a>
    </nav>

    <header class="le-hero">
      <div class="sg-eyebrow">LITERATURE & LEADERSHIP RESEARCH · EP12</div>
      <h1>규정과 양심이 충돌할 때<br /><span>무엇을 기준으로 판단하는가</span></h1>
      <p class="le-subtitle">『안티고네』에서 배우는 갈등과 원칙</p>
      <p class="le-intro">규정은 조직을 안정시키지만 모든 상황을 미리 담을 수는 없습니다. 『안티고네』는 법과 양심, 질서와 정당성이 충돌할 때 리더의 판단이 어디에 뿌리를 두어야 하는지 묻습니다.</p>
      <div class="le-meta"><span>Conflict</span><span>Principle</span><span>Rule</span><span>Legitimacy</span></div>
    </header>

    <section class="le-visual le-visual--ep12" aria-label="안티고네 갈등과 원칙 비주얼">
      <div><span>EP12</span><b>RULE × PRINCIPLE</b></div>
      <i aria-hidden="true"></i>
    </section>

    <article class="le-body">
      <section class="le-research-brief">
        <div class="sg-eyebrow">RESEARCH BRIEF</div>
        <h2>규정을 지키는 것과 정당한 판단이 항상 같은 것은 아니다.</h2>
        <p>크레온은 질서와 통치를 위해 명령을 고수하고, 안티고네는 그 명령보다 더 높은 도덕적 의무가 있다고 믿습니다. 갈등은 단순한 고집이 아니라 서로 다른 정당성의 충돌입니다.</p>
        <p>조직에서도 정책 준수와 고객 보호, 효율과 공정성, 일관성과 예외가 충돌할 수 있습니다. 리더는 어느 한쪽을 감정으로 고르는 대신 판단 근거를 공개해야 합니다.</p>
        <blockquote>규정은 판단을 대신하는 도구가 아니라<br />판단의 일관성을 돕는 기준이다.</blockquote>
        <div class="le-diagnosis">
          <article><b>RULE</b><span>공식 규정은 무엇인가</span></article>
          <article><b>VALUE</b><span>지켜야 할 핵심 가치는 무엇인가</span></article>
          <article><b>HARM</b><span>누가 어떤 피해를 받는가</span></article>
          <article><b>EXPLAIN</b><span>판단을 설명할 수 있는가</span></article>
        </div>
      </section>

      <section class="le-key-takeaways">
        <div class="sg-eyebrow">KEY TAKEAWAYS</div>
        <h2>『안티고네』이 리더에게 남기는 5가지 원칙</h2>
        <div class="le-takeaway-list">
          {takeaways.map(([no,title,body]) => (
            <article><div class="le-takeaway-list__no">{no}</div><div><h3>{title}</h3><p>{body}</p></div></article>
          ))}
        </div>
      </section>

      <section>
        <div class="sg-eyebrow">DEEP DIVE · CONFLICT</div>
        <h2>사람 대 사람이 아니라 가치 대 가치로 본다</h2>
        <p>갈등을 성격 충돌로 해석하면 해결이 어려워집니다. 질서, 공정성, 고객 보호, 자율성처럼 서로 충돌하는 가치가 무엇인지 먼저 분리해야 합니다.</p>
        <div class="le-callout"><b>JOYLAB INTERPRETATION</b><p>갈등 관리의 첫 단계는 누가 문제인지 찾는 것이 아니라 무엇과 무엇이 충돌하는지 명명하는 것이다.</p></div>
      </section>

      <section>
        <div class="sg-eyebrow">DEEP DIVE · LEGITIMACY</div>
        <h2>리더의 권위는 규정 인용보다 설명 가능한 판단에서 나온다</h2>
        <p>예외를 허용하든 규정을 유지하든 판단 근거와 예상되는 영향을 설명할 수 있어야 구성원은 결과에 동의하지 않더라도 절차를 신뢰할 수 있습니다.</p>
        <div class="le-control">
          <article><small>CHECK FIRST</small><h3>판단 전에</h3><p>규정 목적, 충돌 가치, 피해 가능성과 대안을 확인합니다.</p></article>
          <article><small>CHECK NEXT</small><h3>판단 후</h3><p>근거, 예외 여부, 선례와 향후 적용 기준을 기록합니다.</p></article>
        </div>
        <blockquote class="is-dark">규정이 리더를 대신해 판단하게 만들면<br />조직은 일관될 수는 있어도 반드시 공정한 것은 아니다.</blockquote>
      </section>

      <section>
        <div class="sg-eyebrow">COACHING QUESTIONS</div>
        <h2>원칙 충돌을 다루는 12개 리더 질문</h2>
        <p>규정 → 가치 → 피해 → 설명 가능성 순으로 확인합니다.</p>
        <ol class="le-question-list">
          {coachingQuestions.map((q)=><li>{q}</li>)}
        </ol>
        <div class="le-gold-question">
          <small>GOLD QUESTION</small>
          <p>규정과 양심이 충돌할 때 리더는 무엇을 기준으로 판단하는가?</p>
        </div>
      </section>

      <section class="le-action">
        <div class="sg-eyebrow">LEADERSHIP ACTION</div>
        <h2>이번 갈등 하나를 “사람”이 아니라 “충돌 가치”로 다시 정의한다.</h2>
        <div class="le-action-grid">
          <article><b>01 · NAME</b><p>충돌하는 두 가치를 적습니다.</p></article>
          <article><b>02 · PURPOSE</b><p>규정의 원래 목적을 확인합니다.</p></article>
          <article><b>03 · IMPACT</b><p>각 선택의 피해와 선례를 비교합니다.</p></article>
          <article><b>04 · RECORD</b><p>판단 근거와 다음 적용 기준을 남깁니다.</p></article>
        </div>
        <a href="/guides/growth-leadership/literature/framework">Leadership Framework V2 →</a>
      </section>

      <section class="le-conclusion">
        <div class="sg-eyebrow">JOYLAB CONCLUSION</div>
        <p>갈등은 없앨 수 없습니다.</p>
        <h2>리더의 역할은 갈등을 끝내는 것이 아니라<br />판단의 정당성을 만드는 것이다.</h2>
        <p>규정과 원칙이 충돌할수록 결정 과정은 더 투명해야 합니다.</p>
      </section>
    </article>

    <section class="le-faq">
      <div class="sg-eyebrow">FAQ</div>
      <h2>『안티고네』과 갈등과 원칙</h2>
      {faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}
    </section>

    <section class="le-next">
      <div>
        <small>NEXT · EP13</small>
        <h2>『오셀로』 — 리더는 사실과 소문을 어떻게 구분해야 하는가</h2>
        <p>다음 Research에서는 신뢰, 추정, 정보오염이 판단을 어떻게 흔드는지 살펴봅니다.</p>
      </div>
      <a href="/guides/growth-leadership/literature/othello">EP13 읽기 →</a>
    </section>

    <footer class="le-back">
      <a href="/guides/growth-leadership/literature/hamlet">← EP11 햄릿</a>
      <a href="/guides/growth-leadership/literature">전체 시리즈 →</a>
    </footer>
  </main>
</BaseLayout>
