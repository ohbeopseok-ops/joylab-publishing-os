---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/semiconductor-guide-v2.css';
import '../../styles/growth-leadership-guide-v2.css';
import { getCollection } from 'astro:content';

const sequence = [
  { id: 'performance-system-leading-indicators', step: '01', role: 'PERFORMANCE', short: 'Performance', note: '결과 KPI를 Driver·Behavior로 내려 운영 가능한 선행지표를 설계합니다.' },
  { id: 'feedback-system-behavior-change', step: '02', role: 'FEEDBACK', short: 'Feedback', note: '평가가 아니라 관찰·설명·연습·재확인으로 행동 변화를 만드는 피드백 루프를 봅니다.' },
  { id: 'recognition-system-fair-performance', step: '03', role: 'RECOGNITION', short: 'Recognition', note: '성과·성장·팀 기여·고객 가치를 공정한 기준으로 보이게 만드는 인정 구조를 설계합니다.' },
  { id: null, step: '04', role: 'FAIRNESS · NEXT', short: 'Fairness', note: '기회·규칙·판정의 공정성을 분리해 설명 가능한 운영 기준을 만듭니다.' },
  { id: null, step: '05', role: 'LEARNING · NEXT', short: 'Learning', note: '실수와 미달을 개인 평가가 아니라 재학습·재실행 시스템으로 바꿉니다.' },
  { id: null, step: '06', role: 'OPERATING SYSTEM · NEXT', short: 'Operating', note: '성과·피드백·인정·공정성·학습을 팀 운영 주기로 통합합니다.' }
];

const collection = (await getCollection('articles')).filter((item) => !item.data.draft);
const byId = new Map(collection.map((item) => [item.id, item]));
const steps = sequence.map((entry) => ({ ...entry, article: entry.id ? byId.get(entry.id) : undefined }));
const published = steps.filter((entry) => entry.article);
---
<BaseLayout
  title="성장·리더십 가이드｜성과·피드백·인정 시스템을 설계하는 법 | JoyLab"
  description="성과관리·피드백·Recognition·공정성·학습·운영모델을 하나의 Research Map으로 연결해 사람과 팀의 성장을 운영 시스템으로 바꾸는 JoyLab 성장·리더십 가이드입니다."
  bodyClass="semiconductor-guide-v2 growth-leadership-guide-v2"
>
  <section class="sg-hero growth-hero">
    <div class="sg-wrap sg-hero__inner">
      <div class="sg-hero__top">
        <div class="sg-hero__copy">
          <div class="sg-eyebrow">GROWTH & LEADERSHIP RESEARCH · JOYLAB</div>
          <h1>좋은 리더십은 감각보다<br /><span>운영 구조입니다.</span></h1>
          <p class="sg-hero__lead">성과를 압박하는 것보다 <strong>Outcome → Driver → Behavior → Feedback → Recognition → Fairness → Learning → Action</strong>을 연결해, 팀이 반복해서 더 나은 결과를 만들 수 있는 구조를 봅니다.</p>
          <div class="sg-hero__chips" aria-label="성장 리더십 핵심 주제">
            <span>#성과관리</span><span>#피드백</span><span>#Recognition</span><span>#공정성</span><span>#학습</span>
          </div>
          <div class="sg-hero__meta" aria-label="가이드 정보">
            <span><strong>{published.length}</strong> Core Research</span>
            <span><strong>8</strong> Decision Lenses</span>
            <span><strong>1</strong> Research Map</span>
          </div>
        </div>

        <aside class="sg-lens" aria-label="성장 리더십 판단 축">
          <div class="sg-lens__brand">JOYLAB<br /><b>GROWTH & LEADERSHIP</b></div>
          <div class="sg-lens__item"><em>01</em><div><b>성과 구조</b><span>결과 KPI보다 어떤 Driver와 Behavior가 성과를 만드는지 먼저 봅니다.</span></div></div>
          <div class="sg-lens__item"><em>02</em><div><b>행동 변화</b><span>평가보다 피드백·재실행·학습 루프가 실제 행동을 바꾸는지 봅니다.</span></div></div>
          <div class="sg-lens__item"><em>03</em><div><b>공정한 강화</b><span>인정과 판정이 일관되고 설명 가능한 기준으로 운영되는지 봅니다.</span></div></div>
        </aside>
      </div>

      <div class="sg-map-head">
        <div><span>START HERE</span><b>성장·리더십 Research Map</b></div>
        <a href="#research-path">{published.length}개 리서치부터 읽기 →</a>
      </div>

      <nav class="sg-map" aria-label="성장 리더십 리서치 경로">
        {steps.map(({ article, step, short, role }, index) => (
          article ? (
            <a class={`sg-map__step ${index === 0 ? 'is-start' : ''}`} href={`/articles/${article.id}`}>
              <em>{step}</em><b>{short}</b><span>{role}</span>
            </a>
          ) : (
            <div class="sg-map__step is-next" aria-label={`${short} 준비 중`}>
              <em>{step}</em><b>{short}</b><span>{role}</span>
            </div>
          )
        ))}
      </nav>
    </div>
  </section>

  <main class="sg-main" id="research-path">
    <div class="sg-wrap sg-layout">
      <section>
        <div class="sg-section-head">
          <div><div class="sg-eyebrow">RESEARCH PATH</div><h2>사람을 평가하기보다 시스템을 읽습니다</h2></div>
          <p>성과관리에서 시작해 피드백과 Recognition으로 확장하고, 이후 공정성·학습·운영시스템까지 연결합니다. JoyLab은 리더의 감각보다 기준·행동·피드백·재실행을 봅니다.</p>
        </div>

        <div class="sg-path">
          {published.map(({ article, step, role, note }) => (
            <article class="sg-card">
              <div class="sg-card__no">{step}</div>
              <div>
                <div class="sg-card__role">{role}</div>
                <h3><a href={`/articles/${article!.id}`}>{article!.data.title}</a></h3>
                <p>{note}</p>
                <div class="sg-card__foot">
                  {article!.data.tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}
                  <a class="sg-card__cta" href={`/articles/${article!.id}`}>리서치 읽기 →</a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <section class="sg-insights" aria-labelledby="growth-insights-title">
          <div class="sg-section-head sg-section-head--compact">
            <div><div class="sg-eyebrow">GROWTH & LEADERSHIP INSIGHTS</div><h2 id="growth-insights-title">세 가지 기준으로 다시 봅니다</h2></div>
          </div>
          <div class="sg-insights__grid">
            <div><em>DRIVER</em><b>결과보다 결과를 만드는 변수를 봅니다</b><p>후행 KPI 아래 통제 가능한 선행지표와 행동을 분리합니다.</p></div>
            <div><em>LOOP</em><b>평가보다 짧은 학습 루프를 만듭니다</b><p>관찰 → 피드백 → 연습 → 재확인으로 행동 변화 속도를 높입니다.</p></div>
            <div><em>FAIRNESS</em><b>같은 대우보다 같은 기준을 봅니다</b><p>기회·규칙·판정을 나눠 설명 가능한 공정성을 설계합니다.</p></div>
          </div>
        </section>

        <section class="sg-rule" aria-labelledby="growth-rule-title">
          <div class="sg-eyebrow">JOYLAB METHOD</div>
          <h2 id="growth-rule-title">Outcome → Driver → Behavior → Feedback → Recognition → Fairness → Learning → Action</h2>
          <div class="sg-rule__grid growth-rule-grid">
            <div class="sg-rule__step"><b>OUTCOME</b><span>좋은 결과를 무엇으로 볼지 명확히 합니다.</span></div>
            <div class="sg-rule__step"><b>DRIVER</b><span>결과를 만드는 통제 가능한 선행지표를 찾습니다.</span></div>
            <div class="sg-rule__step"><b>BEHAVIOR</b><span>숫자 아래 관찰 가능한 행동을 정의합니다.</span></div>
            <div class="sg-rule__step"><b>FEEDBACK</b><span>다음 행동을 바꾸는 짧은 피드백 루프를 만듭니다.</span></div>
            <div class="sg-rule__step"><b>RECOGNITION</b><span>잘한 행동과 성장을 조직 안에 보이게 합니다.</span></div>
            <div class="sg-rule__step"><b>FAIRNESS</b><span>기회·규칙·판정이 설명 가능한지 확인합니다.</span></div>
            <div class="sg-rule__step"><b>LEARNING</b><span>실패와 미달을 재학습·재실행으로 연결합니다.</span></div>
            <div class="sg-rule__step"><b>ACTION</b><span>다음 운영 주기에서 유지·수정·중단할 것을 정합니다.</span></div>
          </div>
        </section>
      </section>

      <aside class="sg-rail" aria-label="성장 리더십 가이드 사용법">
        <section class="sg-rail-card sg-rail-card--dark">
          <small>START HERE</small>
          <h3>먼저 성과관리 시스템부터</h3>
          <p>결과 KPI와 Driver·Behavior를 구분하면 이후 Feedback과 Recognition을 같은 구조로 연결하기 쉬워집니다.</p>
          <a href="/articles/performance-system-leading-indicators">GC-G01부터 시작하기 →</a>
        </section>
        <section class="sg-rail-card">
          <small>CORE RESEARCH</small>
          <h3>현재 3개 Gold Case</h3>
          <ol><li>Performance System</li><li>Feedback System</li><li>Recognition System</li></ol>
        </section>
        <section class="sg-rail-card">
          <small>NEXT LAYERS</small>
          <h3>다음은 Fairness와 Learning</h3>
          <p>공정성 기준을 기회·규칙·판정으로 나누고, 실패를 재실행으로 연결한 뒤 팀 Operating System으로 확장합니다.</p>
        </section>
      </aside>
    </div>
  </main>
</BaseLayout>
