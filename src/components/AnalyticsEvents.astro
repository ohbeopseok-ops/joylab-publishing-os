<script is:inline>
  (() => {
    const endpoint = '/__analytics/event';
    const privacyOptOut = navigator.globalPrivacyControl === true || navigator.doNotTrack === '1';
    if (privacyOptOut) return;

    const localPreview = location.hostname === '127.0.0.1' || location.hostname === 'localhost' || location.hostname.endsWith('.localhost');

    const clean = (value, fallback = '-') => {
      const normalized = String(value ?? '').trim().slice(0, 120);
      return normalized || fallback;
    };

    const send = (event, target = '-', placement = '-') => {
      if (localPreview) return;

      const payload = JSON.stringify({
        event: clean(event),
        target: clean(target),
        placement: clean(placement),
        path: clean(location.pathname, '/')
      });

      try {
        if (navigator.sendBeacon) {
          const queued = navigator.sendBeacon(
            endpoint,
            new Blob([payload], { type: 'text/plain;charset=UTF-8' })
          );
          if (queued) return;
        }
      } catch {}

      fetch(endpoint, {
        method: 'POST',
        body: payload,
        headers: { 'Content-Type': 'text/plain;charset=UTF-8' },
        keepalive: true,
        credentials: 'same-origin'
      }).catch(() => {});
    };

    const articleMatch = location.pathname.match(/^\/articles\/([^/]+)\/?$/);
    const articleId = articleMatch?.[1] ?? null;
    const isResearchArchive = location.pathname === '/articles' || location.pathname === '/articles/';
    const guideMatch = location.pathname.match(/^\/guides\/(.+?)\/?$/);
    const guideId = guideMatch?.[1] ?? null;
    const isHome = location.pathname === '/' || location.pathname === '/index.html';

    const homeSections = isHome
      ? [
          ['editorial', document.querySelector('.home-hero__today')],
          ['major', document.getElementById('today-research')],
          ['latest', document.querySelector('.home-list-card')],
          ['books', document.querySelector('.home-books-v2')],
          ['guide', document.querySelector('.home-guide')]
        ].filter(([, node]) => node instanceof Element)
      : [];

    window.joylabTrack = send;

    if (homeSections.length && 'IntersectionObserver' in window) {
      const sentImpressions = new Set();
      const sectionByNode = new Map(homeSections.map(([placement, node]) => [node, placement]));
      let observer;

      const visibleRatio = (node) => {
        const rect = node.getBoundingClientRect();
        if (rect.width <= 0 || rect.height <= 0) return 0;
        const visibleWidth = Math.max(0, Math.min(rect.right, innerWidth) - Math.max(rect.left, 0));
        const visibleHeight = Math.max(0, Math.min(rect.bottom, innerHeight) - Math.max(rect.top, 0));
        return (visibleWidth * visibleHeight) / (rect.width * rect.height);
      };

      const tryImpression = (placement, node, ratio = visibleRatio(node)) => {
        if (!placement || sentImpressions.has(placement) || document.hidden || ratio < 0.5) return;
        sentImpressions.add(placement);
        send('home_section_impression', placement, 'home');
        observer?.unobserve(node);
      };

      observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          tryImpression(sectionByNode.get(entry.target), entry.target, entry.intersectionRatio);
        });
      }, { threshold: [0.5] });

      homeSections.forEach(([, node]) => observer.observe(node));
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) return;
        homeSections.forEach(([placement, node]) => tryImpression(placement, node));
      }, { passive: true });
    }

    document.addEventListener('click', (clickEvent) => {
      const targetNode = clickEvent.target;
      if (!(targetNode instanceof Element)) return;

      const tracked = targetNode.closest('[data-analytics-event]');
      if (tracked) {
        send(
          tracked.getAttribute('data-analytics-event'),
          tracked.getAttribute('data-analytics-target'),
          tracked.getAttribute('data-analytics-placement')
        );
      }

      const link = targetNode.closest('a[href]');

      if (isHome && link) {
        const placementEntry = homeSections.find(([, root]) => root.contains(link));
        if (placementEntry) {
          const [placement] = placementEntry;
          const href = link.getAttribute('href') || '';
          const articleTarget = href.match(/^\/articles\/([^/?#]+)\/?(?:[?#].*)?$/)?.[1];
          const guideTarget = href.match(/^\/guides\/[A-Za-z0-9_-]+\/?$/)?.[0];
          const bookTarget = href.match(/^\/books\/([^/?#]+)\/?(?:[?#].*)?$/)?.[1];
          const homeTarget = articleTarget || guideTarget || bookTarget;
          if (homeTarget) send('home_section_click', homeTarget, placement);
        }
      }

      if (articleId && link) {
        const href = link.getAttribute('href') || '';
        if (href.startsWith('/articles/') && href !== location.pathname) {
          const placement = link.closest('.research-related')
            ? 'related_research'
            : link.closest('.research-guide-cta')
              ? 'guide_cta'
              : 'article_body';
          send('article_internal_link_click', href, placement);
        }
      }

      if (guideId && link) {
        const href = link.getAttribute('href') || '';
        const internalContent = href.startsWith('/articles/') || href.startsWith('/guides/') || href.startsWith('/books/');
        if (internalContent && href !== location.pathname) send('guide_cta_click', href, 'guide_page');
      }

      const landingBookMatch = location.pathname.match(/^\/books\/([^/]+)\/?$/);
      if (landingBookMatch && link) {
        const href = link.getAttribute('href') || '';
        if (href.startsWith('/books/') || href.startsWith('/articles/') || href.startsWith('/guides/')) {
          send('book_landing_cta_click', href, 'book_landing');
        }
      }

      const id = targetNode.closest('button, a')?.id;
      if (id === 'contact-submit') send('contact_mail_click', 'mail', 'contact');
      if (id === 'contact-copy') send('contact_copy_click', 'copy', 'contact');
    }, { passive: true });

    if (location.pathname === '/contact' || location.pathname === '/contact/') {
      send('contact_view', 'contact', 'page');
    }

    const bookLandingMatch = location.pathname.match(/^\/books\/([^/]+)\/?$/);
    const bookReaderMatch = location.pathname.match(/^\/books\/([^/]+)\/read\/?$/);
    const bookLandingId = bookLandingMatch?.[1] ?? null;
    const bookReaderId = bookReaderMatch?.[1] ?? null;

    if (bookLandingId) {
      send('book_landing_view', bookLandingId, 'book_landing');

      let visibleSeconds = 0;
      let read50Sent = false;
      let read90Sent = false;
      let exitSent = false;
      let clsValue = 0;
      let clsSessionValue = 0;
      let clsSessionStart = 0;
      let clsSessionLast = 0;

      if ('PerformanceObserver' in window) {
        try {
          const clsObserver = new PerformanceObserver((list) => {
            for (const entry of list.getEntries()) {
              if (entry.hadRecentInput) continue;
              const value = entry.value || 0;
              const withinSession =
                clsSessionValue > 0 &&
                entry.startTime - clsSessionLast < 1000 &&
                entry.startTime - clsSessionStart < 5000;

              if (withinSession) clsSessionValue += value;
              else {
                clsSessionValue = value;
                clsSessionStart = entry.startTime;
              }

              clsSessionLast = entry.startTime;
              clsValue = Math.max(clsValue, clsSessionValue);
            }
          });
          clsObserver.observe({ type: 'layout-shift', buffered: true });
        } catch {}
      }

      const landingDepth = () => {
        const doc = document.documentElement;
        const maxScroll = Math.max(1, doc.scrollHeight - innerHeight);
        return Math.max(0, Math.min(100, (scrollY / maxScroll) * 100));
      };

      const checkLandingDepth = () => {
        const depth = landingDepth();
        if (!read50Sent && depth >= 50) {
          read50Sent = true;
          send('book_landing_read_50', bookLandingId, 'book_landing');
        }
        if (!read90Sent && depth >= 90) {
          read90Sent = true;
          send('book_landing_read_90', bookLandingId, 'book_landing');
        }
      };

      addEventListener('scroll', checkLandingDepth, { passive: true });
      checkLandingDepth();

      const dwellTimer = window.setInterval(() => {
        if (!document.hidden) visibleSeconds += 5;
        if (visibleSeconds >= 60) window.clearInterval(dwellTimer);
      }, 5000);

      const sendBookLandingExit = () => {
        if (exitSent) return;
        exitSent = true;
        checkLandingDepth();
        const early = landingDepth() < 25 && visibleSeconds < 30;
        send('book_landing_exit', bookLandingId, early ? 'early_exit' : 'normal_exit');
        send('book_landing_cls_v2', Math.max(0, clsValue).toFixed(3), 'book_landing');
      };

      addEventListener('pagehide', sendBookLandingExit, { once: true });
    }

    if (bookReaderId) {
      send('book_reader_view', bookReaderId, 'book_reader');

      const sentDepths = new Set();
      const readerContent = document.getElementById('book-reader-content');
      const thresholds = [25, 50, 75, 100];

      const bookDepth = () => {
        if (!(readerContent instanceof HTMLElement)) return 0;
        const top = readerContent.offsetTop;
        const total = Math.max(1, readerContent.scrollHeight - innerHeight);
        const progressed = Math.max(0, scrollY - top);
        return Math.max(0, Math.min(100, (progressed / total) * 100));
      };

      const checkBookDepth = () => {
        const depth = bookDepth();
        for (const threshold of thresholds) {
          const trigger = threshold === 100 ? 95 : threshold;
          if (depth >= trigger && !sentDepths.has(threshold)) {
            sentDepths.add(threshold);
            send(`book_read_${threshold}`, bookReaderId, 'book_reader');
          }
        }
      };

      addEventListener('scroll', checkBookDepth, { passive: true });
      addEventListener('pagehide', checkBookDepth, { once: true });
      checkBookDepth();
    }

    if (isResearchArchive) {
      send('archive_view', 'research', 'archive_page');

      let visibleSeconds = 0;
      let read50Sent = false;
      let read90Sent = false;
      let exitSent = false;
      let clsValue = 0;
      let clsSessionValue = 0;
      let clsSessionStart = 0;
      let clsSessionLast = 0;

      if ('PerformanceObserver' in window) {
        try {
          const clsObserver = new PerformanceObserver((list) => {
            for (const entry of list.getEntries()) {
              if (entry.hadRecentInput) continue;
              const value = entry.value || 0;
              const withinSession =
                clsSessionValue > 0 &&
                entry.startTime - clsSessionLast < 1000 &&
                entry.startTime - clsSessionStart < 5000;

              if (withinSession) clsSessionValue += value;
              else {
                clsSessionValue = value;
                clsSessionStart = entry.startTime;
              }

              clsSessionLast = entry.startTime;
              clsValue = Math.max(clsValue, clsSessionValue);
            }
          });
          clsObserver.observe({ type: 'layout-shift', buffered: true });
        } catch {}
      }

      const archiveDepth = () => {
        const doc = document.documentElement;
        const maxScroll = Math.max(1, doc.scrollHeight - innerHeight);
        return Math.max(0, Math.min(100, (scrollY / maxScroll) * 100));
      };

      const checkArchiveDepth = () => {
        const depth = archiveDepth();
        if (!read50Sent && depth >= 50) {
          read50Sent = true;
          send('archive_read_50', 'research', 'archive_page');
        }
        if (!read90Sent && depth >= 90) {
          read90Sent = true;
          send('archive_read_90', 'research', 'archive_page');
        }
      };

      addEventListener('scroll', checkArchiveDepth, { passive: true });
      checkArchiveDepth();

      const archiveDwellTimer = window.setInterval(() => {
        if (!document.hidden) visibleSeconds += 5;
        if (visibleSeconds >= 60) window.clearInterval(archiveDwellTimer);
      }, 5000);

      const sendArchiveExit = () => {
        if (exitSent) return;
        exitSent = true;
        checkArchiveDepth();
        const early = archiveDepth() < 25 && visibleSeconds < 30;
        send('archive_exit', 'research', early ? 'early_exit' : 'normal_exit');
        send('archive_cls_v2', Math.max(0, clsValue).toFixed(3), 'archive_page');
      };

      addEventListener('pagehide', sendArchiveExit, { once: true });
    }

    if (guideId) {
      send('guide_view', guideId, 'guide_page');

      let visibleSeconds = 0;
      let read50Sent = false;
      let read90Sent = false;
      let exitSent = false;
      let clsValue = 0;
      let clsSessionValue = 0;
      let clsSessionStart = 0;
      let clsSessionLast = 0;

      if ('PerformanceObserver' in window) {
        try {
          const clsObserver = new PerformanceObserver((list) => {
            for (const entry of list.getEntries()) {
              if (entry.hadRecentInput) continue;
              const value = entry.value || 0;
              const withinSession =
                clsSessionValue > 0 &&
                entry.startTime - clsSessionLast < 1000 &&
                entry.startTime - clsSessionStart < 5000;

              if (withinSession) clsSessionValue += value;
              else {
                clsSessionValue = value;
                clsSessionStart = entry.startTime;
              }

              clsSessionLast = entry.startTime;
              clsValue = Math.max(clsValue, clsSessionValue);
            }
          });
          clsObserver.observe({ type: 'layout-shift', buffered: true });
        } catch {}
      }

      const readingDepth = () => {
        const doc = document.documentElement;
        const maxScroll = Math.max(1, doc.scrollHeight - innerHeight);
        return Math.max(0, Math.min(100, (scrollY / maxScroll) * 100));
      };

      const checkDepth = () => {
        const depth = readingDepth();
        if (!read50Sent && depth >= 50) {
          read50Sent = true;
          send('guide_read_50', guideId, 'guide_page');
        }
        if (!read90Sent && depth >= 90) {
          read90Sent = true;
          send('guide_read_90', guideId, 'guide_page');
        }
      };

      addEventListener('scroll', checkDepth, { passive: true });
      checkDepth();

      const dwellTimer = window.setInterval(() => {
        if (!document.hidden) visibleSeconds += 5;
        if (visibleSeconds >= 60) window.clearInterval(dwellTimer);
      }, 5000);

      const sendExitSignals = () => {
        if (exitSent) return;
        exitSent = true;
        checkDepth();
        const early = readingDepth() < 25 && visibleSeconds < 30;
        send('guide_exit', guideId, early ? 'early_exit' : 'normal_exit');
        send('guide_cls_v2', Math.max(0, clsValue).toFixed(3), 'guide_page');
      };

      addEventListener('pagehide', sendExitSignals, { once: true });
    }

    if (articleId) {
      send('article_view', articleId, 'article_page');

      let visibleSeconds = 0;
      let dwellSent = false;
      let read50Sent = false;
      let read90Sent = false;
      let exitSent = false;
      let clsValue = 0;
      let clsSessionValue = 0;
      let clsSessionStart = 0;
      let clsSessionLast = 0;

      if ('PerformanceObserver' in window) {
        try {
          const clsObserver = new PerformanceObserver((list) => {
            for (const entry of list.getEntries()) {
              if (entry.hadRecentInput) continue;
              const value = entry.value || 0;
              const withinSession =
                clsSessionValue > 0 &&
                entry.startTime - clsSessionLast < 1000 &&
                entry.startTime - clsSessionStart < 5000;

              if (withinSession) {
                clsSessionValue += value;
              } else {
                clsSessionValue = value;
                clsSessionStart = entry.startTime;
              }

              clsSessionLast = entry.startTime;
              clsValue = Math.max(clsValue, clsSessionValue);
            }
          });
          clsObserver.observe({ type: 'layout-shift', buffered: true });
        } catch {}
      }

      const readingDepth = () => {
        const doc = document.documentElement;
        const maxScroll = Math.max(1, doc.scrollHeight - innerHeight);
        return Math.max(0, Math.min(100, (scrollY / maxScroll) * 100));
      };

      const checkDepth = () => {
        const depth = readingDepth();
        if (!read50Sent && depth >= 50) {
          read50Sent = true;
          send('article_read_50', articleId, 'article_page');
        }
        if (!read90Sent && depth >= 90) {
          read90Sent = true;
          send('article_read_90', articleId, 'article_page');
        }
      };

      addEventListener('scroll', checkDepth, { passive: true });
      checkDepth();

      const dwellTimer = window.setInterval(() => {
        if (!document.hidden) visibleSeconds += 5;
        if (!dwellSent && visibleSeconds >= 60) {
          dwellSent = true;
          send('article_dwell_60', articleId, 'article_page');
          window.clearInterval(dwellTimer);
        }
      }, 5000);

      const sendExitSignals = () => {
        if (exitSent) return;
        exitSent = true;
        checkDepth();
        const early = readingDepth() < 25 && visibleSeconds < 30;
        send('article_exit', articleId, early ? 'early_exit' : 'normal_exit');
        send('article_cls_v2', Math.max(0, clsValue).toFixed(3), 'article_page');
      };

      addEventListener('pagehide', sendExitSignals, { once: true });
    }
  })();
</script>

<script is:inline>
  (() => {
    const endpoint='/__analytics/event';
    const privacyOptOut=navigator.globalPrivacyControl===true||navigator.doNotTrack==='1';
    const localPreview=location.hostname==='127.0.0.1'||location.hostname==='localhost'||location.hostname.endsWith('.localhost');
    if(privacyOptOut||localPreview||!('PerformanceObserver' in window)) return;

    const device=innerWidth<=640?'mobile':innerWidth<=1024?'tablet':'desktop';
    let lcp=0;
    let cls=0;
    let clsSession=0;
    let clsStart=0;
    let clsLast=0;
    const interactions=new Map();
    const sent=new Set();

    const post=(metric,value)=>{
      if(sent.has(metric)||!Number.isFinite(value)) return;
      sent.add(metric);
      const payload=JSON.stringify({event:'web_vital',target:metric,placement:device,path:location.pathname,value});
      try{
        if(navigator.sendBeacon){
          const ok=navigator.sendBeacon(endpoint,new Blob([payload],{type:'text/plain;charset=UTF-8'}));
          if(ok) return;
        }
      }catch{}
      fetch(endpoint,{method:'POST',body:payload,headers:{'Content-Type':'text/plain;charset=UTF-8'},keepalive:true,credentials:'same-origin'}).catch(()=>{});
    };

    try{
      const observer=new PerformanceObserver((list)=>{
        const entries=list.getEntries();
        const last=entries[entries.length-1];
        if(last) lcp=last.startTime;
      });
      observer.observe({type:'largest-contentful-paint',buffered:true});
    }catch{}

    try{
      const observer=new PerformanceObserver((list)=>{
        for(const entry of list.getEntries()){
          if(entry.hadRecentInput) continue;
          const within=clsSession>0&&entry.startTime-clsLast<1000&&entry.startTime-clsStart<5000;
          if(within) clsSession+=entry.value||0;
          else{clsSession=entry.value||0;clsStart=entry.startTime;}
          clsLast=entry.startTime;
          cls=Math.max(cls,clsSession);
        }
      });
      observer.observe({type:'layout-shift',buffered:true});
    }catch{}

    try{
      const observer=new PerformanceObserver((list)=>{
        for(const entry of list.getEntries()){
          const id=Number(entry.interactionId||0);
          if(!id) continue;
          interactions.set(id,Math.max(interactions.get(id)||0,Number(entry.duration||0)));
        }
      });
      observer.observe({type:'event',buffered:true,durationThreshold:40});
    }catch{}

    const inpValue=()=>{
      const values=[...interactions.values()].sort((a,b)=>b-a);
      if(!values.length) return null;
      const ignored=Math.floor(values.length/50);
      return values[Math.min(ignored,values.length-1)];
    };

    const flush=()=>{
      if(lcp>0) post('lcp',Math.round(lcp));
      post('cls',Number(cls.toFixed(4)));
      const inp=inpValue();
      if(inp!==null) post('inp',Math.round(inp));
    };
    addEventListener('pagehide',flush,{once:true});
    document.addEventListener('visibilitychange',()=>{if(document.hidden) flush();},{passive:true});
  })();
</script>
