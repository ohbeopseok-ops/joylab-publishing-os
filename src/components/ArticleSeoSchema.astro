---
const { article, articleImageUrl, seriesItems = [] } = Astro.props;
const origin = Astro.site ?? Astro.url.origin;
const articleUrl = article.data.canonical ?? new URL(`/articles/${article.id}`, origin).toString();
const graph = [
  {
    '@type': 'Article',
    '@id': `${articleUrl}#article`,
    headline: article.data.title,
    description: article.data.description,
    inLanguage: 'ko-KR',
    datePublished: article.data.publishedAt.toISOString(),
    dateModified: (article.data.updatedAt ?? article.data.publishedAt).toISOString(),
    mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
    ...(articleImageUrl ? { image: [articleImageUrl] } : {}),
    author: {
      '@type': article.data.author === 'JoyLab' ? 'Organization' : 'Person',
      name: article.data.author
    },
    publisher: { '@id': 'https://aijoylab.kr/#organization' },
    isPartOf: { '@id': 'https://aijoylab.kr/#website' }
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${articleUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'JoyLab', item: new URL('/', origin).toString() },
      { '@type': 'ListItem', position: 2, name: 'Research', item: new URL('/articles', origin).toString() },
      { '@type': 'ListItem', position: 3, name: article.data.title, item: articleUrl }
    ]
  },
  ...(seriesItems.length > 1 ? [{
    '@type': 'ItemList',
    '@id': `${articleUrl}#series`,
    name: article.data.series ?? 'Related Research',
    numberOfItems: seriesItems.length,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: seriesItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.data.title,
      url: new URL(`/articles/${item.id}`, origin).toString()
    }))
  }] : [])
];
---
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': graph
})}></script>
