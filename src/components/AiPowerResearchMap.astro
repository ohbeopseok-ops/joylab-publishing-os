---
import graph from '../../config/research-graph-ai-power-v1.json';

const groups = [
  { key: 'macro', label: 'MACRO', types: ['macro'] },
  { key: 'value_chain', label: 'VALUE CHAIN', types: ['demand','value_chain','bottleneck'] },
  { key: 'company', label: 'COMPANY', types: ['company'] },
  { key: 'kpi', label: 'KPI', types: ['kpi','earnings'] },
  { key: 'valuation', label: 'VALUATION', types: ['valuation'] }
];

const publishedArticles = graph.articles.filter((article) => article.status === 'published');
const articleMap = new Map(publishedArticles.map((article) => [article.id, article]));
const nodeArticles = new Map();
for (const edge of graph.edges) {
  if (edge.type !== 'covered_by') continue;
  const article = articleMap.get(edge.from);
  if (!article) continue;
  const list = nodeArticles.get(edge.to) ?? [];
  list.push(article);
  nodeArticles.set(edge.to, list);
}

const neighbors = (id) => graph.edges
  .filter((edge) => edge.from === id || edge.to === id)
  .map((edge) => edge.from === id ? edge.to : edge.from)
  .filter((value, index, array) => array.indexOf(value) === index);

const nodePayload = Object.fromEntries(graph.nodes.map((node) => [
  node.id,
  {
    ...node,
    neighbors: neighbors(node.id),
    articles: nodeArticles.get(node.id) ?? []
  }
]));
---

<section class="rg" data-research-map-v1>
  <div class="rg__head">
    <div>
      <span>JOYLAB RESEARCH GRAPH V1</span>
      <h2>Macro → Value Chain → Company → KPI → Valuation</h2>
      <p>노드를 선택하면 직접 연결된 투자 논리와 관련 리서치를 확인할 수 있습니다.</p>
    </div>
    <a href="/guides/investing">Investment Hub →</a>
  </div>

  <div class="rg__grid" role="list" aria-label="AI Power Research Graph">
    {groups.map((group, groupIndex) => (
      <section class="rg__column" aria-labelledby={`rg-${group.key}`}>
        <div class="rg__column-title" id={`rg-${group.key}`}>
          <em>{String(groupIndex + 1).padStart(2, '0')}</em>
          <strong>{group.label}</strong>
        </div>
        <div class="rg__nodes">
          {graph.nodes
            .filter((node) => group.types.includes(node.type))
            .map((node) => (
              <button
                class="rg__node"
                type="button"
                data-node-id={node.id}
                aria-pressed="false"
              >
                <span>{node.label}</span>
                {node.ticker && <small>{node.market} · {node.ticker}</small>}
              </button>
            ))}
        </div>
      </section>
    ))}
  </div>

  <aside class="rg__detail" aria-live="polite">
    <div>
      <span class="rg__detail-kicker">SELECT A NODE</span>
      <h3 data-rg-title>AI Power Infrastructure</h3>
      <p data-rg-summary>금리에서 밸류에이션까지 이어지는 Research Graph를 탐색해 보세요.</p>
    </div>
    <div class="rg__detail-links" data-rg-links>
      <a href="/guides/ai-power-infrastructure">Pillar 전체 보기 →</a>
    </div>
  </aside>

  <script type="application/json" id="ai-power-research-graph-payload" set:html={JSON.stringify(nodePayload)}></script>
</section>

<script is:inline>
(() => {
  const root = document.querySelector('[data-research-map-v1]');
  if (!root) return;
  const payloadEl = document.getElementById('ai-power-research-graph-payload');
  if (!payloadEl) return;
  const payload = JSON.parse(payloadEl.textContent || '{}');
  const title = root.querySelector('[data-rg-title]');
  const summary = root.querySelector('[data-rg-summary]');
  const links = root.querySelector('[data-rg-links]');
  const buttons = [...root.querySelectorAll('[data-node-id]')];

  function selectNode(id) {
    const node = payload[id];
    if (!node) return;
    buttons.forEach((button) => {
      const active = button.dataset.nodeId === id;
      const related = node.neighbors.includes(button.dataset.nodeId);
      button.classList.toggle('is-active', active);
      button.classList.toggle('is-related', !active && related);
      button.setAttribute('aria-pressed', String(active));
    });
    title.textContent = node.label;
    summary.textContent = node.type === 'company'
      ? `${node.market || ''} ${node.ticker || ''} · 연결 노드 ${node.neighbors.length}개`
      : `${node.type.replaceAll('_', ' ').toUpperCase()} · 직접 연결 ${node.neighbors.length}개`;
    const articleLinks = (node.articles || []).map((article) =>
      `<a href="${article.url}">${article.title} →</a>`
    );
    links.innerHTML = articleLinks.length
      ? articleLinks.join('')
      : '<span>직접 연결된 발행 리서치는 다음 확장 대상입니다.</span>';
  }

  buttons.forEach((button) => button.addEventListener('click', () => selectNode(button.dataset.nodeId)));
  const first = buttons[0];
  if (first) selectNode(first.dataset.nodeId);
})();
</script>
