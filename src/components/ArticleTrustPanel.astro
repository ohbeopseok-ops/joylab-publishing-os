---
const { article } = Astro.props;
const data = article.data;
const sources = data.sourceList ?? [];
const risks = data.riskFactors ?? [];
const counters = data.counterScenarios ?? [];
---

{(data.authorBio || data.researchMethod || sources.length || risks.length || counters.length) && (
  <section class="article-trust-panel" aria-labelledby="article-trust-title">
    <div class="article-trust-panel__eyebrow">TRUST &amp; METHODOLOGY</div>
    <h2 id="article-trust-title">작성 기준과 확인 자료</h2>
    <div class="article-trust-panel__grid">
      {data.authorBio && <div><h3>작성자</h3><p>{data.author} · {data.authorBio}</p></div>}
      {data.researchMethod && <div><h3>조사 방법</h3><p>{data.researchMethod}</p></div>}
      {data.updatedAt && <div><h3>업데이트</h3><p>{data.updatedAt.toLocaleDateString('ko-KR')} · 내용과 출처를 재확인했습니다.</p></div>}
      {risks.length > 0 && <div><h3>주의할 위험 요인</h3><ul>{risks.map((item) => <li>{item}</li>)}</ul></div>}
      {counters.length > 0 && <div><h3>반대 시나리오</h3><ul>{counters.map((item) => <li>{item}</li>)}</ul></div>}
      {sources.length > 0 && <div><h3>원문 출처</h3><ul>{sources.map((source) => <li><a href={source.url} rel="nofollow noopener" target="_blank">{source.label}</a></li>)}</ul></div>}
    </div>
  </section>
)}

<style>
  .article-trust-panel{margin:28px 0;padding:22px;border:1px solid #dfe7f0;background:#f8fafc}
  .article-trust-panel__eyebrow{font-size:.72rem;letter-spacing:.12em;color:#58708c;font-weight:700}
  .article-trust-panel h2{margin:.35rem 0 1rem;font-size:1.15rem}
  .article-trust-panel__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
  .article-trust-panel h3{margin:0 0 .35rem;font-size:.88rem}
  .article-trust-panel p,.article-trust-panel li{font-size:.86rem;line-height:1.65;color:#41536a}
  .article-trust-panel ul{margin:.25rem 0 0;padding-left:1.1rem}
  .article-trust-panel a{color:#1f5f9f;text-decoration:underline}
  @media (max-width:700px){.article-trust-panel__grid{grid-template-columns:1fr}}
</style>
