---
import { AD_PLACEMENT } from '../config/adPlacement';

interface Props {
  placement: 'article-mid-30' | 'article-mid-65' | 'article-end' | 'guide-end' | 'book-end' | 'archive-in-feed';
  slotId?: string;
  label?: string;
  enabled?: boolean;
  class?: string;
}

const {
  placement,
  slotId,
  label = '광고',
  enabled = AD_PLACEMENT.enabled,
  class: className = ''
} = Astro.props;

const configuredSlot = {
  'article-mid-30': AD_PLACEMENT.slots.articleMid30.slotId,
  'article-mid-65': AD_PLACEMENT.slots.articleMid65.slotId,
  'article-end': AD_PLACEMENT.slots.articleEnd.slotId,
  'guide-end': AD_PLACEMENT.slots.guideEnd.slotId,
  'book-end': AD_PLACEMENT.slots.bookEnd.slotId,
  'archive-in-feed': AD_PLACEMENT.slots.archiveInFeed.slotId
}[placement];

const resolvedSlotId = slotId ?? configuredSlot ?? '';
const canRender = Boolean(enabled && resolvedSlotId);
---
{canRender && (
  <aside
    class:list={['joylab-ad-slot', `joylab-ad-slot--${placement}`, className]}
    data-ad-placement={placement}
    aria-label={label}
  >
    <span class="joylab-ad-slot__label">{label}</span>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={AD_PLACEMENT.publisherClientId}
      data-ad-slot={resolvedSlotId}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      try {
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      } catch {}
    </script>
  </aside>
)}

<style>
  .joylab-ad-slot{
    width:min(100%,970px);
    max-width:100%;
    margin:32px auto;
    padding:10px 0;
    border-top:1px solid #e7ebf0;
    border-bottom:1px solid #e7ebf0;
    overflow:hidden;
    box-sizing:border-box;
  }
  .joylab-ad-slot__label{
    display:block;
    margin-bottom:6px;
    color:#7b8794;
    font-size:.68rem;
    letter-spacing:.08em;
  }
  .joylab-ad-slot>.adsbygoogle{
    display:block;
    width:100%;
    max-width:100%;
    margin-inline:auto;
    overflow:hidden;
  }
  .joylab-ad-slot:has(>.adsbygoogle[data-ad-status="unfilled"]){
    display:none;
    width:0;
    height:0;
    min-height:0;
    margin:0;
    padding:0;
    border:0;
    overflow:hidden;
  }
  @media(max-width:640px){
    .joylab-ad-slot{
      width:100%;
      margin:24px auto;
      padding:8px 0;
    }
  }
</style>
