---
import graph from '../data/ai-standards-research-graph.json';
---

<section class="asmap" aria-labelledby="asmap-title">
  <div class="asmap__head">
    <div>
      <div class="sg-eyebrow">INTERACTIVE RESEARCH GRAPH</div>
      <h2 id="asmap-title">Language → Measurement → Standard → Governance → Discourse Power</h2>
      <p>단계를 선택하면 해당 층위가 무엇을 결정하고 어떤 JoyLab 리서치와 연결되는지 확인할 수 있습니다.</p>
    </div>
    <div class="asmap__stats" aria-label="리서치 그래프 구성">
      <span><strong>{graph.stages.length}</strong> Layers</span>
      <span><strong>{graph.research.length}</strong> Research Pieces</span>
    </div>
  </div>

  <div class="asmap__stage-strip" role="tablist" aria-label="AI 표준 연구 단계">
    {graph.stages.map((stage, index) => (
      <button
        type="button"
        role="tab"
        aria-selected={index === 0 ? 'true' : 'false'}
        class:list={['asmap__stage', { 'is-active': index === 0 }]}
        data-stage-id={stage.id}
      >
        <em>{String(stage.order).padStart(2, '0')}</em>
        <b>{stage.label}</b>
        <span>{stage.ko}</span>
      </button>
    ))}
  </div>

  <div class="asmap__detail" aria-live="polite">
    <div class="asmap__detail-copy">
      <small>SELECTED LAYER</small>
      <h3 data-asmap-title>{graph.stages[0]?.label}</h3>
      <p data-asmap-description>{graph.stages[0]?.description}</p>
    </div>
    <div class="asmap__research" data-asmap-research></div>
  </div>

  <div class="asmap__foot">
    <p><strong>읽는 법:</strong> 이 지도는 국가나 표준의 우열을 평가하는 점수표가 아니라, 기술이 ‘정의 → 계량 → 규칙 → 제도 → 영향력’으로 이동하는 경로를 추적하는 Research Navigation입니다.</p>
  </div>

  <script type="application/json" id="ai-standards-research-graph" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')}></script>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('.asmap');
    const dataNode = document.getElementById('ai-standards-research-graph');
    if (!root || !dataNode) return;

    const graph = JSON.parse(dataNode.textContent || '{}');
    const buttons = Array.from(root.querySelectorAll('[data-stage-id]'));
    const title = root.querySelector('[data-asmap-title]');
    const description = root.querySelector('[data-asmap-description]');
    const researchNode = root.querySelector('[data-asmap-research]');

    const escapeHtml = (value) => String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');

    const render = (stageId) => {
      const stage = graph.stages.find((item) => item.id === stageId);
      if (!stage) return;
      const pieces = graph.research.filter((item) => item.stageIds.includes(stageId));

      title.textContent = stage.label + ' · ' + stage.ko;
      description.textContent = stage.description;
      researchNode.innerHTML = pieces.map((item) => {
        const state = item.status === 'published' ? 'LIVE' : 'PLANNED';
        const heading = item.url
          ? '<a href="' + escapeHtml(item.url) + '">' + escapeHtml(item.title) + ' →</a>'
          : '<span>' + escapeHtml(item.title) + '</span>';
        return '<article class="asmap__piece ' + (item.status === 'published' ? 'is-live' : 'is-planned') + '">' +
          '<div><small>' + state + ' · ' + escapeHtml(item.type) + '</small>' +
          '<h4>' + heading + '</h4>' +
          '<p>' + escapeHtml(item.subtitle) + '</p></div></article>';
      }).join('');

      buttons.forEach((button) => {
        const active = button.dataset.stageId === stageId;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-selected', active ? 'true' : 'false');
      });
    };

    buttons.forEach((button) => button.addEventListener('click', () => render(button.dataset.stageId)));
    if (buttons[0]) render(buttons[0].dataset.stageId);
  })();
</script>

<style>
  .asmap{margin-top:30px;border:1px solid #dbe5f2;background:#fff;overflow:hidden}
  .asmap__head{display:flex;justify-content:space-between;gap:24px;padding:26px 28px;background:#f7f9fc;border-bottom:1px solid #dbe5f2}
  .asmap__head h2{margin:7px 0 8px;color:#0c2c57;font-size:clamp(1.45rem,2.8vw,2.15rem);letter-spacing:-.04em}
  .asmap__head p{max-width:720px;margin:0;color:#6d7c91;line-height:1.65}
  .asmap__stats{display:flex;gap:10px;align-items:flex-start}
  .asmap__stats span{min-width:92px;padding:12px;border:1px solid #dbe5f2;background:#fff;color:#728196;font-size:.7rem;text-align:center}
  .asmap__stats strong{display:block;color:#0d2c57;font-size:1.2rem}
  .asmap__stage-strip{display:grid;grid-template-columns:repeat(5,1fr);background:#071938}
  .asmap__stage{min-height:112px;padding:16px 14px;border:0;border-right:1px solid rgba(255,255,255,.11);background:transparent;color:#fff;text-align:left;cursor:pointer}
  .asmap__stage:last-child{border-right:0}
  .asmap__stage em{display:block;color:#6ea9ff;font-size:.65rem;font-style:normal;font-weight:900}
  .asmap__stage b{display:block;margin-top:8px;font-size:.92rem}
  .asmap__stage span{display:block;margin-top:4px;color:#9fb4d0;font-size:.7rem}
  .asmap__stage.is-active{box-shadow:inset 0 4px 0 #ffd83d;background:#0b285b}
  .asmap__stage.is-active em{color:#ffd83d}
  .asmap__detail{display:grid;grid-template-columns:minmax(260px,.72fr) 1.28fr;gap:0;min-height:250px}
  .asmap__detail-copy{padding:28px;border-right:1px solid #dbe5f2}
  .asmap__detail-copy small{color:#1677ff;font-size:.68rem;font-weight:900;letter-spacing:.1em}
  .asmap__detail-copy h3{margin:9px 0;color:#0c2c57;font-size:1.35rem}
  .asmap__detail-copy p{margin:0;color:#6d7c91;line-height:1.7}
  .asmap__research{display:grid;align-content:start;gap:10px;padding:22px}
  .asmap__piece{padding:15px 16px;border:1px solid #e0e8f2;background:#fff}
  .asmap__piece.is-live{border-left:4px solid #1677ff}
  .asmap__piece.is-planned{border-left:4px solid #c6d0dd;background:#fafbfc}
  .asmap__piece small{color:#7a899d;font-size:.62rem;font-weight:900;letter-spacing:.08em}
  .asmap__piece h4{margin:5px 0 4px;font-size:.95rem;line-height:1.4}
  .asmap__piece h4 a{color:#12315a;text-decoration:none}
  .asmap__piece h4 a:hover{color:#1677ff}
  .asmap__piece h4 span{color:#43566f}
  .asmap__piece p{margin:0;color:#758398;font-size:.76rem;line-height:1.5}
  .asmap__foot{padding:16px 28px;border-top:1px solid #dbe5f2;background:#fffdf3}
  .asmap__foot p{margin:0;color:#68778a;font-size:.78rem;line-height:1.6}
  @media(max-width:800px){
    .asmap__head{display:block;padding:22px}
    .asmap__stats{margin-top:16px}
    .asmap__stage-strip{display:flex;overflow-x:auto;overscroll-behavior-inline:contain}
    .asmap__stage{min-width:150px;min-height:96px}
    .asmap__detail{grid-template-columns:1fr}
    .asmap__detail-copy{border-right:0;border-bottom:1px solid #dbe5f2}
  }
  @media(max-width:640px){
    .asmap{margin-inline:0}
    .asmap__head{padding:18px}
    .asmap__head h2{font-size:1.3rem}
    .asmap__stats span{min-width:82px;padding:10px}
    .asmap__stage{min-width:132px;padding:13px 12px}
    .asmap__detail-copy,.asmap__research{padding:18px}
    .asmap__foot{padding:14px 18px}
  }
</style>
