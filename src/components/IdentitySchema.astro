---
import { SITE_IDENTITY } from '../config/siteIdentity';

const identityGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_IDENTITY.domain}/#website`,
      name: SITE_IDENTITY.brand,
      alternateName: 'AIJoyLab',
      url: `${SITE_IDENTITY.domain}/`,
      inLanguage: 'ko-KR',
      publisher: { '@id': `${SITE_IDENTITY.domain}/#organization` }
    },
    {
      '@type': 'Organization',
      '@id': `${SITE_IDENTITY.domain}/#organization`,
      name: SITE_IDENTITY.brand,
      alternateName: 'AIJoyLab',
      url: `${SITE_IDENTITY.domain}/`,
      email: SITE_IDENTITY.publicEmail,
      sameAs: [
        SITE_IDENTITY.channels.youtube,
        SITE_IDENTITY.channels.naver,
        SITE_IDENTITY.channels.instagram,
        SITE_IDENTITY.channels.x
      ],
      founder: {
        '@id': `${SITE_IDENTITY.domain}/#founder`
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'business inquiries',
        email: SITE_IDENTITY.publicEmail,
        url: `${SITE_IDENTITY.domain}/contact`
      }
    },
    {
      '@type': 'Person',
      '@id': `${SITE_IDENTITY.domain}/#founder`,
      name: '오법석',
      sameAs: [
        SITE_IDENTITY.channels.threads,
        SITE_IDENTITY.channels.linkedin
      ],
      worksFor: {
        '@id': `${SITE_IDENTITY.domain}/#organization`
      }
    }
  ]
};
---
<script id="joylab-identity-schema" type="application/ld+json" set:html={JSON.stringify(identityGraph)}></script>
