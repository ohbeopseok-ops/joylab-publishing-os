---
import graph from '../../config/research-graph-ai-power-v1.json';

interface Props {
  articleId: string;
}

const { articleId } = Astro.props;
const articleUrl = `/articles/${articleId}`;
const published = graph.articles.filter((article) => article.status === 'published');
const current = published.find((article) => article.url === articleUrl) ?? null;
const byGraphId = new Map(published.map((article) => [article.id, article]));
const previous = current?.previous ? byGraphId.get(current.previous) ?? null : null;
const next = current?.next ? byGraphId.get(current.next) ?? null : null;

const related = current
  ? published
      .filter((article) => article.id !== current.id)
      .map((article) => ({
        article,
        score: article.topics.filter((topic) => current.topics.includes(topic)).length
      }))
      .filter(({ score }) => score > 0)
      .sort((a, b) => b.score - a.score || (a.article.order ?? 999) - (b.article.order ?? 999))
      .slice(0, 3)
      .map(({ article }) => article)
  : [];
---

{current && (
  <nav class="ai-power-nav" aria-label="AI Power Infrastructure 리서치 이동">
    <div class="ai-power-nav__head">
      <div>
        <small>JOYLAB · AI POWER INFRASTRUCTURE</small>
        <strong>{String(current.order ?? 0).padStart(2, '0')} · {current.stage.toUpperCase()}</strong>
      </div>
      <a href={graph.pillar.url}>전체 투자 지도 →</a>
    </div>

    <div class="ai-power-nav__sequence">
      {previous ? (
        <a href={previous.url} class="ai-power-nav__card">
          <span>← 이전 리서치</span>
          <b>{previous.title}</b>
        </a>
      ) : (
        <span class="ai-power-nav__card is-disabled">
          <span>← 이전 리서치</span>
          <b>시리즈의 첫 글입니다</b>
        </span>
      )}

      {next ? (
        <a href={next.url} class="ai-power-nav__card">
          <span>다음 리서치 →</span>
          <b>{next.title}</b>
        </a>
      ) : (
        <a href={graph.pillar.url} class="ai-power-nav__card">
          <span>완주 →</span>
          <b>AI Power Infrastructure 전체 지도</b>
        </a>
      )}
    </div>

    {related.length > 0 && (
      <div class="ai-power-nav__related">
        <span>Graph Related Research</span>
        <div>
          {related.map((article) => (
            <a href={article.url}>{article.title}</a>
          ))}
        </div>
      </div>
    )}
  </nav>
)}

<style>
  .ai-power-nav{margin:28px 0 8px;padding:20px;border:1px solid #dbe4ee;border-radius:18px;background:#f8fafc}
  .ai-power-nav__head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:14px}
  .ai-power-nav__head small{display:block;color:#2563eb;font-size:.72rem;font-weight:800;letter-spacing:.06em}
  .ai-power-nav__head strong{display:block;margin-top:4px;color:#111827}
  .ai-power-nav__head>a{color:#2563eb;font-weight:800;text-decoration:none}
  .ai-power-nav__sequence{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .ai-power-nav__card{display:block;padding:14px 15px;border:1px solid #e5e7eb;border-radius:12px;background:#fff;color:#111827;text-decoration:none}
  .ai-power-nav__card span{display:block;margin-bottom:5px;color:#6b7280;font-size:.75rem;font-weight:700}
  .ai-power-nav__card b{display:block;line-height:1.45}
  .ai-power-nav__card.is-disabled{opacity:.6}
  .ai-power-nav__related{margin-top:14px;padding-top:14px;border-top:1px solid #e5e7eb}
  .ai-power-nav__related>span{display:block;margin-bottom:8px;color:#6b7280;font-size:.72rem;font-weight:800;text-transform:uppercase}
  .ai-power-nav__related>div{display:grid;gap:7px}
  .ai-power-nav__related a{color:#1f2937;text-decoration:none;font-weight:700;line-height:1.45}
  .ai-power-nav__related a:hover,.ai-power-nav__head>a:hover,.ai-power-nav__card:hover{text-decoration:underline}
  @media (max-width:700px){
    .ai-power-nav__head{display:block}
    .ai-power-nav__head>a{display:inline-block;margin-top:10px}
    .ai-power-nav__sequence{grid-template-columns:1fr}
  }
</style>
