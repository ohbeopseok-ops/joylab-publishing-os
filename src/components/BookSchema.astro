---
const {
  book,
  canonical
} = Astro.props;

const pageUrl = canonical;
const bookId = `${pageUrl}#book`;
const pageId = `${pageUrl}#webpage`;
const personId = book.data.author === '오법석'
  ? 'https://aijoylab.kr/#founder'
  : `${pageUrl}#author`;
const booksUrl = new URL('/books', Astro.site ?? Astro.url.origin).toString();
const homeUrl = new URL('/', Astro.site ?? Astro.url.origin).toString();
const aboutUrl = new URL('/about', Astro.site ?? Astro.url.origin).toString();

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: book.data.author,
      ...(book.data.author === '오법석' ? { url: aboutUrl } : {})
    },
    {
      '@type': 'Book',
      '@id': bookId,
      name: book.data.title,
      ...(book.data.subtitle ? { alternateName: book.data.subtitle } : {}),
      description: book.data.description,
      url: pageUrl,
      inLanguage: 'ko-KR',
      datePublished: book.data.publishedAt.toISOString(),
      ...(book.data.updatedAt ? { dateModified: book.data.updatedAt.toISOString() } : {}),
      author: { '@id': personId },
      ...(book.data.coverImage ? { image: new URL(book.data.coverImage, Astro.site ?? Astro.url.origin).toString() } : {}),
      ...(book.data.isbn ? { isbn: book.data.isbn } : {}),
      ...(book.data.publisher ? {
        publisher: {
          '@type': 'Organization',
          name: book.data.publisher
        }
      } : {})
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'JoyLab', item: homeUrl },
        { '@type': 'ListItem', position: 2, name: 'Books', item: booksUrl },
        { '@type': 'ListItem', position: 3, name: book.data.title, item: pageUrl }
      ]
    },
    {
      '@type': 'WebPage',
      '@id': pageId,
      url: pageUrl,
      name: `${book.data.title} | JoyLab Books`,
      description: book.data.description,
      inLanguage: 'ko-KR',
      mainEntity: { '@id': bookId },
      about: { '@id': bookId },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
      isPartOf: {
        '@type': 'WebSite',
        '@id': 'https://aijoylab.kr/#website',
        name: 'JoyLab',
        url: 'https://aijoylab.kr/'
      }
    }
  ]
};
---
<script id="joylab-book-schema" type="application/ld+json" set:html={JSON.stringify(graph)}></script>
